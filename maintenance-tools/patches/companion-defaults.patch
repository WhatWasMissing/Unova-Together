 // Read-only companion scenes. These never award friendship or write save data.
 namespace FollowerInteraction {
+inline bool enabledByEnvironment() {
+    // A saved launcher choice wins; the old variable supports released launchers.
+    return qEnvironmentVariable("UNOVA_COMPANION_INTERACTIONS",
+        qEnvironmentVariable("UNOVA_EXPERIMENTAL_COMPANION","1"))=="1";
+}
+
 inline bool available(const QVariantMap& mon) {
     return mon.value("ok").toBool() && !mon.value("egg").toBool() &&
         mon.value("species").toUInt()>0 && mon.value("species").toUInt()<=649;
