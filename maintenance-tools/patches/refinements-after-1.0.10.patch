+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+#include "Savestate.h"
+#include <QByteArray>
+#include <array>
+
+// Reuse capture allocations without changing capture cadence or recovery data.
+// QByteArray copy-on-write keeps any retained recovery checkpoint immutable.
+class CheckpointStorage {
+    std::array<QByteArray,2> buffers;
+    unsigned next=0;
+public:
+    template<class Writer> QByteArray capture(Writer writer) {
+        auto& buffer=buffers[next];
+        buffer.resizeForOverwrite(melonDS::Savestate::DEFAULT_SIZE);
+        melonDS::Savestate state(buffer.data(),buffer.size(),true);
+        if(!writer(state) || state.Error) return {};
+        state.Finish();if(state.Error) return {};
+        buffer.resize(state.Length());next^=1;
+        return buffer;
+    }
+};
