+void MultiplayerPanel::beginSoaring(int slot)
+{
+    if(!soaringEnabled || slot<0 || slot>=statsParty.size()) return;
+    const auto mon=statsParty[slot].toMap();bool capable=mon.value("type1").toInt()==2 || mon.value("type2").toInt()==2;
+    for(const auto& move:mon.value("moves").toList()) capable=capable || move.toUInt()==19;
+    const QDir directory(qEnvironmentVariable("UNOVA_SOARING_CACHE"));
+    if(!capable || !mon.value("hp").toUInt() || mon.value("egg").toBool() || !currentSample.value("fieldPositionOwned").toBool() || currentSample.value("moving").toBool() || currentSample.value("inBattle").toBool() || currentSample.value("nativeCoopCanCancel").toBool() || qEnvironmentVariable("UNOVA_SOARING_CACHE").isEmpty() || !directory.exists()) {
+        soaringStatus="Stand idle outdoors with a flying partner. Enable Soaring in launcher settings.";drawGameMenu();return;
+    }
+    soaring.reset();soaring.phase=SoaringScene::Preparing;soaring.anchor=currentSample;soaring.map=currentSample.value("map").toInt();
+    soaring.species=mon.value("species").toUInt();soaring.form=mon.value("form").toUInt();soaring.gender=mon.value("gender",2).toUInt();soaring.shiny=mon.value("shiny").toBool();
+    soaringStarted=soaringLastTick=clock.elapsed();soaringStreamRetry=0;soaringStatus.clear();soaringLandingTarget.clear();
+    soaringRequest=directory.filePath(QString("request-%1-%2.json").arg(QCoreApplication::applicationPid()).arg(soaringStarted));
+    QSaveFile request(soaringRequest);
+    const QJsonObject data{{"zone",soaring.map},{"worldX",currentSample.value("worldX").toDouble()},{"worldZ",currentSample.value("worldZ").toDouble()},{"worldY",currentSample.value("worldY").toDouble()}};
+    const auto bytes=QJsonDocument(data).toJson(QJsonDocument::Compact);
+    if(!request.open(QIODevice::WriteOnly) || request.write(bytes)!=bytes.size() || !request.commit()) {soaring.reset();soaringStatus="Could not prepare flight scenery.";drawGameMenu();return;}
+    menuMode="soaring";menuFocus=0;instance->setGameMenuOpen(true);renderPeers();drawGameMenu();
+}
+void MultiplayerPanel::pollSoaring(unsigned buttons,unsigned pressed)
+{
+    if(!soaring.active()) return;
+    if((pressed&(1<<1)) || currentSample.value("map").toInt()!=soaring.map || currentSample.value("inBattle").toBool() || currentSample.value("nativeCoopCanCancel").toBool() || !currentSample.value("fieldPositionOwned").toBool()) {closeGameMenus();renderPeers();return;}
+    const auto now=clock.elapsed();const double dt=(now-soaringLastTick)/1000.;soaringLastTick=now;
+    if(soaring.phase==SoaringScene::Preparing) {
+        const auto requestInfo=QFileInfo(soaringRequest);
+        QFile ready(requestInfo.dir().filePath(requestInfo.fileName().replace("request-","ready-")));
+        if(ready.open(QIODevice::ReadOnly) && ready.size()<=4096) {
+            const auto data=QJsonDocument::fromJson(ready.readAll()).object();
+            const auto relative=data.value("scene").toString();
+            const auto path=requestInfo.dir().filePath(relative);
+            const bool local=QFileInfo(path).canonicalFilePath().startsWith(requestInfo.dir().canonicalPath()+"/");
+            if(!data.value("error").toString().isEmpty() || !local || !soaring.load(path)) {
+                soaringStatus=data.value("error").toString(soaring.error.isEmpty()?"This map is not supported for flight.":soaring.error);
+                soaring.reset();menuMode="soar-party";instance->presenceSurface.publish({});drawGameMenu();return;
