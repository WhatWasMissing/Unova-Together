+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+#include <QVariantMap>
+#include <QString>
+
+inline QString PresenceVisibilityReason(const QVariantMap& local,const QVariantMap& partner,qint64 age,
+                                        const QString& localVersion,const QString& localRom)
+{
+    if(age>=2000) return "Waiting for a fresh partner update.";
+    if(local.value("inBattle").toBool() || partner.value("inBattle").toBool()) return "Overworld sprites are hidden during battles.";
+    if(partner.value("inMenu").toBool()) return "Partner is in a game menu.";
+    if(!partner.value("active").toBool()) return "Partner has not reached the overworld.";
+    if(!local.value("fieldPositionOwned").toBool()) return "Your field position is unavailable; return to the overworld.";
+    if(local.value("map").toInt()!=partner.value("map").toInt()) return "Different maps: use Join map to meet up.";
+    const auto version=partner.value("modVersion").toString();
+    if(!version.isEmpty() && version!="1.0.7-dev" && version!=localVersion) return "Different releases: update both players to the same version.";
+    const auto rom=partner.value("romFingerprint").toString();
+    if(!localRom.isEmpty() && !rom.isEmpty() && rom!=localRom) return "Different ROM builds: battles require matching games.";
+    if(!local.value("cameraValid").toBool()) return "The game camera is unavailable in this area.";
+    if(localRom.isEmpty() || rom.isEmpty()) return "Same map; waiting for ROM compatibility information.";
+    if(version.isEmpty() || version=="1.0.7-dev") return "Same map and matching ROM; partner version is not reported reliably.";
+    return "Same map and matching ROM; partner should be visible.";
+}
