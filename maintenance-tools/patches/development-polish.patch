+
+// Original, small DS-native crystal icons. Each icon is encoded as tiled 4bpp
+// pixels plus a 16-colour BGR555 palette when inserted into the game's item
+// graphics NARC.
+namespace Gen5MegaItemIcons {
+struct RGB { uint8_t r, g, b; };
+struct Theme { RGB shade, base, light, accent, accentLight; };
+struct Art {
+    std::array<uint8_t, 32 * 32> pixels{};
+    std::array<uint16_t, 16> palette{};
+};
+
+inline constexpr std::array<Theme, 19> Themes{{
+    {{7,54,45},{22,151,113},{107,226,175},{224,151,56},{255,226,129}}, // Serperiorite
+    {{19,38,78},{42,105,175},{135,200,246},{219,111,36},{255,203,115}}, // Arcaninite
+    {{44,50,61},{117,129,146},{207,216,224},{48,54,67},{137,149,162}}, // Aggronite
+    {{30,79,133},{75,160,216},{183,232,250},{219,143,190},{255,219,239}}, // Altarianite
+    {{72,35,89},{135,69,155},{207,138,211},{225,77,115},{255,163,181}}, // Banettite
+    {{46,101,92},{87,179,158},{177,232,209},{203,74,106},{255,163,177}}, // Galladite
+    {{25,75,115},{45,144,194},{133,209,231},{224,183,82},{255,232,143}}, // Heracronite
+    {{57,41,97},{133,101,192},{209,188,245},{76,151,208},{169,225,255}}, // Latiosite
+    {{85,72,26},{202,177,47},{255,228,99},{51,149,177},{143,225,238}}, // Manectite
+    {{58,38,90},{134,83,176},{210,164,237},{221,81,133},{255,174,198}}, // Sablenite
+    {{39,58,122},{76,125,210},{161,202,250},{206,74,78},{255,155,144}}, // Salamencite
+    {{86,35,44},{190,48,60},{255,129,111},{152,163,177},{227,234,241}}, // Scizorite
+    {{105,72,29},{221,177,63},{255,232,121},{70,157,175},{157,229,235}}, // Ampharosite
+    {{95,43,25},{216,96,31},{255,188,78},{49,117,173},{160,218,250}}, // Charizardite Y
+    {{66,42,74},{180,52,95},{248,142,169},{50,126,160},{134,217,230}}, // Garchompite
+    {{52,83,37},{117,170,64},{194,225,131},{220,89,112},{255,166,174}}, // Venusaurite
+    {{50,41,87},{118,74,171},{196,151,228},{58,190,218},{156,232,245}}, // Gengarite
+    {{76,66,116},{146,132,194},{220,211,250},{105,199,217},{195,246,250}}, // Alakazite
+    {{72,41,74},{168,70,121},{236,153,196},{227,190,71},{255,238,143}}, // Mawilite
+}};
+
+inline uint16_t bgr555(RGB color)
+{
+    return uint16_t((color.r >> 3) | ((color.g >> 3) << 5) | ((color.b >> 3) << 10));
+}
+
+inline void set(Art& art, int x, int y, uint8_t color)
+{
+    if (x >= 0 && x < 32 && y >= 0 && y < 32)
+        art.pixels[std::size_t(y) * 32 + unsigned(x)] = color;
+}
+
+inline RGB mix(RGB a, RGB b, unsigned weightB)
+{
+    const auto channel = [weightB](unsigned x, unsigned y) {
+        return uint8_t((x * (255 - weightB) + y * weightB + 127) / 255);
+    };
+    return {channel(a.r, b.r), channel(a.g, b.g), channel(a.b, b.b)};
+}
+
+inline Art draw(const Theme& theme, std::size_t kind)
+{
+    Art art;
+    // Each Mega gets its own mineral color and contrasting marble veins. These
+    // sixteen BGR555 colors are the DS's native 4bpp item-icon palette.
+    const auto mid = mix(theme.base, theme.light, 120);
+    art.palette = {0, bgr555(theme.shade), bgr555(mix(theme.shade, theme.base, 90)),
+                   bgr555(mix(theme.shade, theme.base, 175)), bgr555(theme.base),
+                   bgr555(mid), bgr555(theme.light), bgr555(theme.accent),
+                   bgr555(theme.accentLight), bgr555({255,255,255}),
+                   bgr555(mix(theme.base, theme.accent, 110)),
+                   bgr555(mix(theme.accent, theme.accentLight, 140)),
+                   bgr555(mix(theme.light, {255,255,255}, 150)),
+                   bgr555(mix(theme.base, theme.accentLight, 130)),
+                   bgr555(mix(theme.shade, theme.light, 120)),
+                   bgr555({18,20,31})};
+
+    constexpr float center = 15.5f;
+    constexpr float radius = 13.5f;
+    const float radiusSquared = radius * radius;
+    const float phase = float(kind) * 0.73f + 0.35f;
+    for (int y = 0; y < 32; ++y)
+        for (int x = 0; x < 32; ++x)
+        {
+            const float dx = float(x) - center, dy = float(y) - center;
+            const float distanceSquared = dx * dx + dy * dy;
+            if (distanceSquared > radiusSquared) continue;
+
+            const float radial = std::sqrt(distanceSquared) / radius;
+            const float nx = dx / radius, ny = dy / radius;
+            const float nz = std::sqrt(std::max(0.0f, 1.0f - radial * radial));
+            const float diffuse = std::clamp(0.62f - 0.28f * nx - 0.40f * ny + 0.12f * nz,
+                                             0.10f, 0.96f);
+            uint8_t color;
+            if (distanceSquared >= 12.5f * 12.5f) color = 15; // dark, crisp round outline
+            else if (distanceSquared >= 11.7f * 11.7f) color = 1; // colored inner rim
+            else if (diffuse > 0.77f) color = 6;
+            else if (diffuse > 0.62f) color = 5;
+            else if (diffuse > 0.43f) color = 4;
+            else if (diffuse > 0.25f) color = 3;
+            else color = 2;
+
+            // Slow, curving bands give each sphere a marbled glass pattern.
+            // The phase changes per Mega so no two marbles share the same swirl.
+            const float angle = std::atan2(ny, nx);
+            const float flow = std::sin(angle * 1.12f + radial * 4.9f + phase +
+                                        0.54f * std::sin(angle * 1.9f - phase));
+            const float vein = std::abs(flow);
+            const float cloud = std::sin(angle * 1.8f - radial * 4.1f + phase * 1.7f +
+                                         0.42f * std::cos(angle * 2.6f + phase));
+            if (distanceSquared < 11.7f * 11.7f && flow < -0.3f) color = 10;
+            if (distanceSquared < 11.7f * 11.7f && vein < 0.13f) color = 8;
+            else if (distanceSquared < 11.7f * 11.7f && vein < 0.27f) color = 7;
+            else if (distanceSquared < 10.8f * 10.8f && cloud > 0.72f) color = 13;
+
+            // A compact upper-left reflection sells the polished marble finish.
+            const float glossX = (nx + 0.43f) / 0.25f;
+            const float glossY = (ny + 0.48f) / 0.18f;
+            if (glossX * glossX + glossY * glossY < 1.0f && distanceSquared < 11.7f * 11.7f)
+                color = (glossX * glossX + glossY * glossY < 0.35f) ? 9 : 12;
+
+            set(art, x, y, color);
+        }
+    return art;
+}
