+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+
+#include <cstdint>
+
+namespace melonDS
+{
+
+// Presence sprites are composited at the same effective depth as ordinary
+// field actors (OBJ priority 2). A visible background pixel with a smaller
+// priority is in front of that actor and must hide the frontend sprite too.
+constexpr bool IsPresenceOccludedByBackground(std::uint8_t compositorFlags,
+                                               unsigned backgroundPriority,
+                                               unsigned actorPriority = 2) noexcept
+{
+    constexpr std::uint8_t BackgroundLayers = 0x0F;
+    constexpr std::uint8_t ObjectOr3DLayer = 0xC0;
+    return !(compositorFlags & ObjectOr3DLayer) &&
+        (compositorFlags & BackgroundLayers) && backgroundPriority < actorPriority;
+}
+
+// The scene depth and projected companion depth both use normalized [0, 1]
+// device coordinates, where smaller values are closer to the camera.
+constexpr bool IsPresenceOccludedByDepth(float sceneDepth, float actorDepth,
+                                         float tolerance = 0.0015f) noexcept
+{
+    return sceneDepth + tolerance < actorDepth;
+}
+
+}
