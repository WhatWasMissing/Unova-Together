+    const auto valid = [](u32 address, u32 length) {
+        return address >= 0x02000000 && address <= 0x02400000 - length;
+    };
+    const auto byte = [&](u32 address) { return nds.MainRAM[address - 0x02000000]; };
+    const auto half = [&](u32 address) { return u16(byte(address) | (u16(byte(address + 1)) << 8)); };
