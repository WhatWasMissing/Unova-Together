+void NativeMegaRuntime::ObserveFrame()
+{
+    if (!impl->fixtureDriving || !impl->core || !impl->module || impl->actionTimeline.size() >= 128) return;
+    const auto* data = impl->core->MainRAM;
+    const auto size = impl->core->MainRAMMask + 1;
+    const auto module = Gen5MegaBattle::findModule(data, size);
+    if (!module || *module != impl->module) return;
+    const auto selected = Gen5MegaBattle::activeSelection(data, size, *module);
+    if (!selected) return;
+    const Gen5MegaBattle::RAM ram(data, size);
+    const auto actionCount = ram.byte(selected->flow + Gen5MegaBattle::ActionCountOffset);
+    const auto viewFunction = ram.word(selected->view + 0x14);
+    const auto viewSequence = ram.word(selected->view + 0x18);
+    if (selected->action == impl->lastAction && selected->selectFunction == impl->lastSelectFunction &&
+        selected->selectSequence == impl->lastSelectSequence && viewFunction == impl->lastViewFunction &&
+        viewSequence == impl->lastViewSequence && actionCount == impl->lastActionCount) return;
+    impl->lastAction = selected->action; impl->lastSelectFunction = selected->selectFunction;
+    impl->lastSelectSequence = selected->selectSequence;
+    impl->lastViewFunction = viewFunction; impl->lastViewSequence = viewSequence;
+    impl->lastActionCount = actionCount;
+    uint32_t order = 0, type = 0, priority = 0;
+    if (actionCount && actionCount <= 6 && ram.object(selected->flow,
+        Gen5MegaBattle::ActionOrderOffset + 6 * Gen5MegaBattle::ActionOrderSize)) {
+        for (unsigned i = 0; i < actionCount; ++i) {
+            const auto work = selected->flow + Gen5MegaBattle::ActionOrderOffset + i * Gen5MegaBattle::ActionOrderSize;
+            if (ram.word(work) == selected->serverMon) {
+                order = i + 1; type = ram.word(work + 4) & 15; priority = ram.byte(work + 13);
+                break;
+            }
+        }
+    }
+    impl->actionTimeline.append(QVariantMap{{"frame", impl->inputFrames}, {"action", selected->action},
+        {"selectFunction", selected->selectFunction}, {"selectSequence", selected->selectSequence},
+        {"viewFunction", viewFunction}, {"viewSequence", viewSequence}, {"actionCount", actionCount},
+        {"serverOrder", order}, {"serverActionType", type}, {"serverPriority", priority},
+        {"form", selected->form}, {"hp", selected->currentHP}});
+}
+unsigned NativeMegaRuntime::FixtureInputMask()
+{
+    impl->fixtureTouching = false;
+    if (qEnvironmentVariable("POKEPLAY_MEGA_EVOLUTION_CHECK") != "1" || !impl->fixtureDriving)
+        return 0xFFF;
+    const auto frame = ++impl->inputFrames;
+    // Replays use disposable ROM/save copies. Tap A only when the native
+    // command state confirms the move list is open; fixed frame intervals can
+    // miss a prompt or press through a battle animation on slower machines.
+    if (frame < 10 || !impl->core || !impl->module ||
+        impl->call.GetState() == Gen5MegaBattle::FormCall::State::Idle)
+        return 0xFFF;
+    const auto module = Gen5MegaBattle::findModule(
+        impl->core->MainRAM, impl->core->MainRAMMask + 1);
+    if (!module || *module != impl->module)
+    {
+        impl->fixtureMovePromptValid = false;
+        impl->fixtureTapFramesLeft = 0;
+        return 0xFFF;
+    }
+    const auto selected = Gen5MegaBattle::activeSelection(
+        impl->core->MainRAM, impl->core->MainRAMMask + 1, *module);
+    if (!selected || selected->selectFunction != Gen5MegaBattle::FightSelect ||
+        selected->selectSequence != 3 ||
+        !Gen5MegaBattle::RAM(impl->core->MainRAM, impl->core->MainRAMMask + 1).object(
+            selected->view, 0xC4))
+    {
+        impl->fixtureMovePromptValid = false;
+        impl->fixtureTapFramesLeft = 0;
+        // A real battle cycles back through the Fight command and result
+        // messages between move selections. The old replay only tapped moves,
+        // leaving the player at that command screen until its timeout.
+        if (qEnvironmentVariable("POKEPLAY_MEGA_VERIFY_RESTORE") == "1" &&
+            frame % 30 == 0)
+        {
+            impl->fixtureInputAPressed = true;
+            return 0xFFE;
+        }
+        return 0xFFF;
+    }
+    const Gen5MegaBattle::RAM ram(impl->core->MainRAM, impl->core->MainRAMMask + 1);
+    const auto viewFunction = ram.word(selected->view + 0x14);
+    const auto viewSequence = ram.word(selected->view + 0x18);
+    if (viewFunction != Gen5MegaBattle::MoveInput || viewSequence != 0)
+    {
+        impl->fixtureMovePromptValid = false;
+        impl->fixtureTapFramesLeft = 0;
+        if (qEnvironmentVariable("POKEPLAY_MEGA_VERIFY_RESTORE") == "1" &&
+            frame % 30 == 0)
+        {
+            impl->fixtureInputAPressed = true;
+            return 0xFFE;
+        }
+        return 0xFFF;
+    }
+    const bool newPrompt = !impl->fixtureMovePromptValid ||
+        selected->action != impl->fixturePromptAction ||
+        selected->selectFunction != impl->fixturePromptSelectFunction ||
+        selected->selectSequence != impl->fixturePromptSelectSequence ||
+        viewFunction != impl->fixturePromptViewFunction ||
+        viewSequence != impl->fixturePromptViewSequence;
+    if (newPrompt)
+    {
+        impl->fixtureMovePromptValid = true;
+        impl->fixturePromptAction = selected->action;
+        impl->fixturePromptSelectFunction = selected->selectFunction;
+        impl->fixturePromptSelectSequence = selected->selectSequence;
+        impl->fixturePromptViewFunction = viewFunction;
+        impl->fixturePromptViewSequence = viewSequence;
+        impl->fixtureTapFramesLeft = 2;
+    }
+    if (impl->fixtureTapFramesLeft)
+    {
+        --impl->fixtureTapFramesLeft;
+        impl->fixtureInputAPressed = true;
+        impl->fixtureTouching = true;
+        return 0xFFE;
+    }
+    return 0xFFF;
+}
+bool NativeMegaRuntime::FixtureMoveSelectionReady(melonDS::NDS& core) const
+{
+    const auto module = Gen5MegaBattle::findModule(core.MainRAM, core.MainRAMMask + 1);
+    const auto selection = module ? Gen5MegaBattle::activeSelection(
+        core.MainRAM, core.MainRAMMask + 1, *module) : std::nullopt;
+    return selection && selection->eligible();
+}
+QVariantMap NativeMegaRuntime::FixtureDiagnostics(melonDS::NDS& core) const
+{
+    const auto module = Gen5MegaBattle::findModule(core.MainRAM, core.MainRAMMask + 1);
+    const auto selection = module ? Gen5MegaBattle::activeSelection(
+        core.MainRAM, core.MainRAMMask + 1, *module) : std::nullopt;
+    const auto signatureMask = module ? Gen5MegaBattle::reviewedEntryPointMask(
+        core.MainRAM, core.MainRAMMask + 1) : 0u;
+    const bool cartridge = verifiedCartridge(core);
+    const bool entryPoints = signatureMask == 0x1F &&
+        Gen5MegaBattle::reviewedEntryPoints(core.MainRAM, core.MainRAMMask + 1);
+    QVariantMap result{{"cartridgeVerified", cartridge}, {"moduleFound", bool(module)},
+        {"entryPointMask", signatureMask}, {"entryPointsVerified", entryPoints},
+        {"assetReadBytes", qint64(melonDS::ROMAssetOverlay::ConsumedBytes())},
+        {"selectionFound", bool(selection)}, {"moveSelectionEligible", selection && selection->eligible()}};
+    if (selection) {
+        result["species"] = selection->species;
+        result["stone"] = selection->stone;
+        result["selectSequence"] = selection->selectSequence;
+        result["atMoveSelection"] = selection->atMoveSelection;
+    }
+    return result;
+}
+bool NativeMegaRuntime::FixtureTouching() const { return impl->fixtureTouching; }
+void NativeMegaRuntime::RecordFixtureInput(unsigned mask, unsigned keyInput)
+{
+    if (impl->fixtureDriving)
+    {
+        impl->fixtureLastMask = mask;
+        impl->fixtureLastKeyInput = keyInput;
+        impl->fixtureAppliedA = impl->fixtureAppliedA ||
+            (!(mask & 1u) && !(keyInput & 1u));
+    }
+}
+void NativeMegaRuntime::ResetAfterCoreStopped()
+{
+    impl->detach();
+    impl = std::make_unique<Impl>();
+}
