+void GLRenderer::CapturePresenceDepth()
+{
+    // Resolve completed transfers without waiting for the GPU. A slightly old
+    // depth frame is preferable to stalling emulation while it is copied.
+    for (size_t slot = 0; slot < PresenceDepthPBO.size(); ++slot)
+    {
+        if (!PresenceDepthPending[slot] || !PresenceDepthFence[slot])
+            continue;
+        const GLenum status = glClientWaitSync(PresenceDepthFence[slot], GL_SYNC_FLUSH_COMMANDS_BIT, 0);
+        if (status != GL_ALREADY_SIGNALED && status != GL_CONDITION_SATISFIED)
+            continue;
+
+        glDeleteSync(PresenceDepthFence[slot]);
+        PresenceDepthFence[slot] = nullptr;
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, PresenceDepthPBO[slot]);
+        const auto* source = static_cast<const float*>(glMapBuffer(GL_PIXEL_PACK_BUFFER, GL_READ_ONLY));
+        const int sourceWidth = PresenceDepthWidth[slot];
+        const int sourceHeight = PresenceDepthHeight[slot];
+        if (source && sourceWidth > 0 && sourceHeight > 0)
+        {
+            for (int y = 0; y < 192; ++y)
+            {
+                const int sampleY = std::min(sourceHeight - 1, ((2 * y + 1) * sourceHeight) / 384);
+                const float* sourceLine = source + (sourceHeight - 1 - sampleY) * sourceWidth;
+                float* targetLine = &PresenceDepthBuffer[y * 256];
+                for (int x = 0; x < 256; ++x)
+                {
+                    const int sampleX = std::min(sourceWidth - 1, ((2 * x + 1) * sourceWidth) / 512);
+                    targetLine[x] = sourceLine[sampleX];
+                }
+            }
+            glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+            HasPresenceDepth = true;
+        }
+        PresenceDepthPending[slot] = false;
+    }
+
+    int slot = -1;
+    for (size_t offset = 0; offset < PresenceDepthPBO.size(); ++offset)
+    {
+        const int candidate = (PresenceDepthWriteSlot + static_cast<int>(offset)) %
+            static_cast<int>(PresenceDepthPBO.size());
+        if (!PresenceDepthPending[candidate])
+        {
+            slot = candidate;
+            break;
+        }
+    }
+    if (slot < 0 || ScreenW <= 0 || ScreenH <= 0)
+        return;
+
+    GLint previousReadFramebuffer = 0;
+    GLint previousDrawFramebuffer = 0;
+    GLint previousReadBuffer = GL_BACK;
+    GLint previousPixelPackBuffer = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previousReadFramebuffer);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &previousDrawFramebuffer);
+    glGetIntegerv(GL_READ_BUFFER, &previousReadBuffer);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &previousPixelPackBuffer);
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, MainFramebuffer);
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, PresenceDepthPBO[slot]);
+    glBufferData(GL_PIXEL_PACK_BUFFER, static_cast<GLsizeiptr>(ScreenW) * ScreenH * sizeof(float), nullptr, GL_STREAM_READ);
+    glReadPixels(0, 0, ScreenW, ScreenH, GL_DEPTH_COMPONENT, GL_FLOAT, nullptr);
+    PresenceDepthFence[slot] = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    PresenceDepthPending[slot] = PresenceDepthFence[slot] != nullptr;
+    PresenceDepthWidth[slot] = ScreenW;
+    PresenceDepthHeight[slot] = ScreenH;
+    PresenceDepthWriteSlot = (slot + 1) % static_cast<int>(PresenceDepthPBO.size());
+
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, static_cast<GLuint>(previousPixelPackBuffer));
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(previousReadFramebuffer));
+    glReadBuffer(static_cast<GLenum>(previousReadBuffer));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(previousDrawFramebuffer));
+}
