+// Read and repair only the encrypted Gen V party record fields involved in a
+// Mega form change. Party HP, experience, EVs, PP, held item, and other progress
+// remain byte-for-byte intact.
+namespace Gen5MegaPartyData {
+inline constexpr std::size_t PartyRecordSize = 220;
+inline constexpr std::size_t HeaderSize = 8;
+inline constexpr std::size_t BoxDataSize = 128;
+inline constexpr std::size_t AbilityOffsetInBlockA = 13;
+inline constexpr std::size_t FormOffsetInBlockB = 24;
+inline constexpr std::size_t HiddenAbilityOffsetInBlockB = 26;
+inline constexpr std::size_t OriginGameOffsetInBlockC = 23;
+inline constexpr uint8_t BoxDecryptedFlag = 1u << 1;
+inline constexpr uint8_t BadEggFlag = 1u << 2;
+inline constexpr uint8_t FirstGen5OriginVersion = 20; // VERSION_WHITE, per BW2 decomp.
+
+struct Identity {
+    uint32_t personality = 0;
+    uint16_t species = 0;
+    uint16_t heldItem = 0;
+    uint8_t form = 0;
+    uint8_t ability = 0;
+    uint8_t baseAbility = 0;
+    uint8_t originGame = 0;
+    uint8_t abilitySlot = 0;
+    bool hiddenAbility = false;
+    bool encrypted = false;
+};
+
+namespace detail {
+inline uint16_t read16(const uint8_t* p)
+{
+    return uint16_t(p[0] | (uint16_t(p[1]) << 8));
+}
+
+inline void write16(uint8_t* p, uint16_t value)
+{
+    p[0] = uint8_t(value);
+    p[1] = uint8_t(value >> 8);
+}
+
+inline uint32_t read32(const uint8_t* p)
+{
+    return uint32_t(p[0]) | (uint32_t(p[1]) << 8) |
+           (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+
+inline uint16_t checksum(const std::array<uint8_t, BoxDataSize>& data)
+{
+    uint32_t sum = 0;
+    for (std::size_t i = 0; i < data.size(); i += 2) sum += read16(data.data() + i);
+    return uint16_t(sum);
+}
+
+inline std::array<unsigned, 4> blockOrder(uint32_t pid)
+{
+    std::array<unsigned, 4> order{0, 1, 2, 3};
+    const auto permutation = ((pid >> 13) & 31u) % 24u;
+    for (unsigned i = 0; i < permutation; ++i)
+        std::next_permutation(order.begin(), order.end());
+    return order;
+}
+
+inline void crypt(std::array<uint8_t, BoxDataSize>& data, uint16_t seed)
+{
+    uint32_t state = seed;
+    for (std::size_t i = 0; i < data.size(); i += 2) {
+        state = state * 0x41C64E6DU + 0x6073U;
+        write16(data.data() + i, uint16_t(read16(data.data() + i) ^ (state >> 16)));
+    }
+}
+
+struct Decoded {
+    std::array<uint8_t, PartyRecordSize> record{};
+    std::array<uint8_t, BoxDataSize> blocks{};
+    uint32_t pid = 0;
+    uint16_t species = 0;
+    uint16_t heldItem = 0;
+    uint16_t checksum = 0;
+    bool encrypted = false;
+};
+
+inline std::optional<Decoded> decode(const uint8_t* record, std::size_t size)
+{
+    if (!record || size != PartyRecordSize) return std::nullopt;
+    Decoded out;
+    std::copy_n(record, size, out.record.begin());
+    const uint8_t flags = out.record[4];
+    if (flags & BadEggFlag) return std::nullopt;
+
+    out.pid = read32(out.record.data());
+    out.checksum = read16(out.record.data() + 6);
+    out.encrypted = !(flags & BoxDecryptedFlag);
+    std::array<uint8_t, BoxDataSize> shuffled{};
+    std::copy_n(out.record.data() + HeaderSize, BoxDataSize, shuffled.data());
+    if (out.encrypted) crypt(shuffled, out.checksum);
+
+    const auto order = blockOrder(out.pid);
+    for (unsigned i = 0; i < order.size(); ++i)
+        std::copy_n(shuffled.data() + i * 32, 32, out.blocks.data() + order[i] * 32);
+
+    if (out.encrypted && checksum(out.blocks) != out.checksum) return std::nullopt;
+    out.species = read16(out.blocks.data());
+    out.heldItem = read16(out.blocks.data() + 2);
+    if (!out.species || out.species > 649) return std::nullopt;
+    return out;
+}
+
+inline uint8_t inferBaseAbility(const Decoded& decoded,
+                                const Gen5MegaEvolution::MegaProfile& profile,
+                                uint8_t& abilitySlot, bool& hidden)
+{
+    const bool hiddenBit = (read16(decoded.blocks.data() + 32 + HiddenAbilityOffsetInBlockB) & 1u) != 0;
+    const uint8_t origin = decoded.blocks[64 + OriginGameOffsetInBlockC];
+    hidden = hiddenBit;
+    if (hiddenBit && profile.baseAbilityH) {
+        abilitySlot = 2;
+        return profile.baseAbilityH;
+    }
+    const bool oldOrigin = origin < FirstGen5OriginVersion;
+    const bool secondSlot = profile.baseAbility2 &&
+        (oldOrigin ? (decoded.pid & 1u) != 0 : (decoded.pid & 0x10000u) != 0);
+    abilitySlot = secondSlot ? 1 : 0;
+    return secondSlot ? profile.baseAbility2 : profile.baseAbility1;
+}
+
+inline bool allowedBaseAbility(const Gen5MegaEvolution::MegaProfile& profile, uint8_t ability)
+{
+    return ability && (ability == profile.baseAbility1 || ability == profile.baseAbility2 ||
+                       ability == profile.baseAbilityH);
+}
+} // namespace detail
+
+inline std::optional<Identity> inspect(const uint8_t* record, std::size_t size)
+{
+    const auto decoded = detail::decode(record, size);
+    if (!decoded) return std::nullopt;
+    Identity result;
+    result.personality = decoded->pid;
+    result.species = decoded->species;
+    result.heldItem = decoded->heldItem;
+    result.form = uint8_t(decoded->blocks[32 + FormOffsetInBlockB] >> 3);
+    result.ability = decoded->blocks[AbilityOffsetInBlockA];
+    result.originGame = decoded->blocks[64 + OriginGameOffsetInBlockC];
+    result.encrypted = decoded->encrypted;
+    result.baseAbility = result.ability;
+    if (const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(result.species, result.heldItem))
+        result.baseAbility = detail::inferBaseAbility(*decoded, *profile,
+            result.abilitySlot, result.hiddenAbility);
+    else
+        result.hiddenAbility = (detail::read16(decoded->blocks.data() + 32 +
+            HiddenAbilityOffsetInBlockB) & 1u) != 0;
+    return result;
+}
+
+inline bool isProfileMegaAbility(const Gen5MegaEvolution::MegaProfile& profile,
+                                 uint8_t ability)
+{
+    return ability && (ability == profile.ability1 || ability == profile.ability2 ||
+                       ability == profile.abilityH);
+}
+
+inline bool isMatchingProfileStone(const Gen5MegaEvolution::MegaProfile& profile,
+                                   uint16_t itemId)
+{
+    const auto* matched = Gen5MegaEvolution::profileForSpeciesAndStone(profile.species, itemId);
+    return matched && matched->stone == profile.stone && matched->megaForm == profile.megaForm;
+}
+
+// Validate the active battler against independently held party-record copies.
+// The record's ability slot, PID/origin version, and hidden-ability flag are
+// authoritative when a stale battle cache contains a Mega-only ability.
+template <std::size_t Count>
+inline std::optional<uint8_t> verifiedBaseAbilityFromCopies(
+    const Gen5MegaEvolution::MegaProfile& profile,
+    const std::array<Identity, Count>& copies)
+{
+    if constexpr (Count == 0) return std::nullopt;
+    const auto& first = copies.front();
+    if (first.species != profile.species || !isMatchingProfileStone(profile, first.heldItem) ||
+        first.form != profile.baseForm ||
+        !detail::allowedBaseAbility(profile, first.baseAbility) ||
+        (!detail::allowedBaseAbility(profile, first.ability) &&
+         !isProfileMegaAbility(profile, first.ability)))
+        return std::nullopt;
+
+    for (const auto& copy : copies)
+    {
+        if (copy.personality != first.personality || copy.species != first.species ||
+            copy.heldItem != first.heldItem || !isMatchingProfileStone(profile, copy.heldItem) ||
+            copy.form != first.form ||
+            !detail::allowedBaseAbility(profile, copy.baseAbility) ||
+            copy.baseAbility != first.baseAbility ||
+            (!detail::allowedBaseAbility(profile, copy.ability) &&
+             !isProfileMegaAbility(profile, copy.ability)))
+            return std::nullopt;
+    }
+    return first.baseAbility;
+}
+
+// Restore the base-form ability after native form-change logic has written the
+// Mega ability into PartyPkm. The optional preferred value is accepted only if
+// it is a real base ability for this profile; otherwise PID/origin/hidden bits
+// select the proper slot just as BW2's setAbilityForForm does.
+inline std::optional<uint16_t> restoreBaseAbility(
+    uint8_t* record, std::size_t size,
+    const Gen5MegaEvolution::MegaProfile& profile,
+    uint16_t preferredBaseAbility = 0, bool allowBaseForm = false)
+{
+    auto decoded = detail::decode(record, size);
+    if (!decoded || decoded->species != profile.species) return std::nullopt;
+    const uint8_t form = uint8_t(decoded->blocks[32 + FormOffsetInBlockB] >> 3);
+    if (form != profile.megaForm && !(allowBaseForm && form == profile.baseForm))
+        return std::nullopt;
+
+    const auto abilityOffset = std::size_t(AbilityOffsetInBlockA);
+    const uint8_t live = decoded->blocks[abilityOffset];
+    if (form == profile.megaForm && live != profile.ability1 && live != profile.ability2 &&
+        live != profile.abilityH)
+        return std::nullopt;
+
+    uint8_t slot = 0;
+    bool hidden = false;
+    uint8_t inferred = detail::inferBaseAbility(*decoded, profile, slot, hidden);
+    const uint8_t target = preferredBaseAbility &&
+        preferredBaseAbility <= 0xFF &&
+        detail::allowedBaseAbility(profile, uint8_t(preferredBaseAbility))
+            ? uint8_t(preferredBaseAbility) : inferred;
+    if (!detail::allowedBaseAbility(profile, target)) return std::nullopt;
+    if (live == target) return target;
+    if (form == profile.baseForm && live != profile.ability1 && live != profile.ability2 &&
+        live != profile.abilityH)
+        return std::nullopt;
+
+    decoded->blocks[abilityOffset] = target;
+    const uint16_t newChecksum = detail::checksum(decoded->blocks);
+    const auto order = detail::blockOrder(decoded->pid);
+    std::array<uint8_t, BoxDataSize> shuffled{};
+    for (unsigned i = 0; i < order.size(); ++i)
+        std::copy_n(decoded->blocks.data() + order[i] * 32, 32, shuffled.data() + i * 32);
+    if (decoded->encrypted) detail::crypt(shuffled, newChecksum);
+
+    detail::write16(decoded->record.data() + 6, newChecksum);
+    std::copy(shuffled.begin(), shuffled.end(), decoded->record.begin() + HeaderSize);
+    std::copy(decoded->record.begin(), decoded->record.end(), record);
+    return target;
+}
+} // namespace Gen5MegaPartyData
