+uint16_t megaFixtureRead16(const uint8_t* data)
+{
+    return uint16_t(data[0] | (uint16_t(data[1]) << 8));
+}
+
+void megaFixtureWrite16(uint8_t* data, uint16_t value)
+{
+    data[0] = uint8_t(value);
+    data[1] = uint8_t(value >> 8);
+}
+
+bool rewriteMegaFixturePartyRecord(
+    std::array<uint8_t, PokemonTrading::RecordSize>& record,
+    const Gen5MegaEvolution::MegaProfile& profile)
+{
+    if (record[4] || record[5]) return false;
+    const uint32_t personality = uint32_t(record[0]) | (uint32_t(record[1]) << 8) |
+        (uint32_t(record[2]) << 16) | (uint32_t(record[3]) << 24);
+    const uint16_t oldChecksum = megaFixtureRead16(record.data() + 6);
+    std::array<uint8_t, 128> shuffled{};
+    std::array<uint8_t, 128> blocks{};
+    std::copy_n(record.data() + 8, shuffled.size(), shuffled.data());
+    uint32_t seed = oldChecksum;
+    for (std::size_t offset = 0; offset < shuffled.size(); offset += 2)
+    {
+        seed = seed * 0x41C64E6DU + 0x6073U;
+        megaFixtureWrite16(shuffled.data() + offset,
+            uint16_t(megaFixtureRead16(shuffled.data() + offset) ^ (seed >> 16)));
+    }
+    std::array<unsigned, 4> order{0, 1, 2, 3};
+    const auto permutation = ((personality >> 13) & 31) % 24;
+    for (unsigned index = 0; index < permutation; ++index)
+        std::next_permutation(order.begin(), order.end());
+    for (unsigned index = 0; index < order.size(); ++index)
+        std::copy_n(shuffled.data() + index * 32, 32, blocks.data() + order[index] * 32);
+
+    megaFixtureWrite16(blocks.data(), profile.species);
+    megaFixtureWrite16(blocks.data() + 2, profile.stone);
+    blocks[13] = profile.baseAbility1;
+    uint32_t sum = 0;
+    for (std::size_t offset = 0; offset < blocks.size(); offset += 2)
+        sum += megaFixtureRead16(blocks.data() + offset);
+    const uint16_t checksum = uint16_t(sum);
+
+    for (unsigned index = 0; index < order.size(); ++index)
+        std::copy_n(blocks.data() + order[index] * 32, 32, shuffled.data() + index * 32);
+    seed = checksum;
+    for (std::size_t offset = 0; offset < shuffled.size(); offset += 2)
+    {
+        seed = seed * 0x41C64E6DU + 0x6073U;
+        megaFixtureWrite16(shuffled.data() + offset,
+            uint16_t(megaFixtureRead16(shuffled.data() + offset) ^ (seed >> 16)));
+    }
+    megaFixtureWrite16(record.data() + 6, checksum);
+    std::copy(shuffled.begin(), shuffled.end(), record.begin() + 8);
+    return true;
+}
