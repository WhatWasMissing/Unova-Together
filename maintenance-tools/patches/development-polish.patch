+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <numeric>
+#include <stdexcept>
+#include <algorithm>
+
+namespace PokemonRecordEdit {
+inline constexpr unsigned RecordSize = 0xdc;
+using Record = std::array<std::uint8_t, RecordSize>;
+using BlockData = std::array<std::uint8_t, 128>;
+
+inline std::uint16_t read16(const std::uint8_t* data)
+{
+    return std::uint16_t(data[0]) | (std::uint16_t(data[1]) << 8);
+}
+
+inline std::uint32_t read32(const std::uint8_t* data)
+{
+    return read16(data) | (std::uint32_t(read16(data + 2)) << 16);
+}
+
+inline void write16(std::uint8_t* data, std::uint16_t value)
+{
+    data[0] = std::uint8_t(value);
+    data[1] = std::uint8_t(value >> 8);
+}
+
+inline void crypt(BlockData& data, std::uint32_t seed)
+{
+    for (unsigned offset = 0; offset < data.size(); offset += 2) {
+        seed = seed * 0x41c64e6dU + 0x6073U;
+        write16(data.data() + offset,
+                read16(data.data() + offset) ^ std::uint16_t(seed >> 16));
+    }
+}
+
+inline std::array<unsigned, 4> blockOrder(std::uint32_t personality)
+{
+    std::array<unsigned, 4> order{0, 1, 2, 3};
+    for (unsigned i = 0; i < ((personality >> 13) & 31) % 24; ++i)
+        std::next_permutation(order.begin(), order.end());
+    return order;
+}
+
+// Return the same encrypted party record with its six EV bytes cleared. All
+// other Pokémon fields and the extension block remain unchanged. The caller
+// validates the complete game-specific record before committing it.
+inline Record resetEVs(const Record& source)
+{
+    if (read16(source.data() + 4) != 0)
+        throw std::runtime_error("Pokemon data is busy or invalid");
+
+    const auto personality = read32(source.data());
+    const auto oldChecksum = read16(source.data() + 6);
+    BlockData shuffled{};
+    std::copy_n(source.data() + 8, shuffled.size(), shuffled.data());
+    crypt(shuffled, oldChecksum);
+
+    unsigned checksum = 0;
+    for (unsigned offset = 0; offset < shuffled.size(); offset += 2)
+        checksum += read16(shuffled.data() + offset);
+    if ((checksum & 0xffff) != oldChecksum)
