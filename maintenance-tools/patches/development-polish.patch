+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+// Native Mega battle integration maintained with OpenAI Codex.
+#pragma once
+#include "../../Gen5MegaEvolution.h"
+
+namespace Gen5MegaBattle {
+inline constexpr uint32_t FightSelect = 0x021B3C01;
+inline constexpr uint32_t MoveInput = 0x021CF111;
+inline constexpr uint32_t ChangeFormHandler = 0x021AE261;
+inline constexpr uint32_t ClientChangeForm = 0x021B89CD;
+// BattleMonCore keeps the original ability at 0x16 for switch/teardown
+// restoration. The active ability used by battle effects is a separate field.
+inline constexpr uint32_t BaseAbilityOffset = 0x16;
+inline constexpr uint32_t CurrentAbilityOffset = 0x13C;
+// Redux's Gen V party-icon archive/palette table has no custom Mega entries.
+// Use each Mega's base-form icon while keeping the battler's Mega form intact.
+inline uint8_t partyIconLookupForm(uint16_t species, uint8_t form)
+{
+    const auto* profile = Gen5MegaEvolution::profileForSpeciesForm(species, form);
+    return profile && form == profile->megaForm ? profile->baseForm : form;
+}
+
+inline constexpr uint32_t ChangeFormCommand = 79;
+inline constexpr uint16_t MegaActivationChord = (1u << 8) | (1u << 9); // R + L
+inline constexpr bool megaActivationPressed(uint16_t buttons, uint16_t previousButtons, bool inputBlocked)
+{
+    return !inputBlocked && (buttons & MegaActivationChord) == MegaActivationChord &&
+           (previousButtons & MegaActivationChord) != MegaActivationChord;
+}
+
+// Native IDs group six party members per client, with allies interleaved:
+// client 0 -> 0..5, client 2 -> 6..11, client 1 -> 12..17, client 3 -> 18..23.
+inline constexpr unsigned firstBattleSlot(unsigned clientId)
+{
+    return (clientId & 1u) * 12u + (clientId >> 1u) * 6u;
+}
+
+struct Selection
+{
+    uint32_t module = 0, server = 0, flow = 0, client = 0, view = 0;
+    uint32_t clientMon = 0, serverMon = 0;
+    uint32_t clientSource = 0, serverSource = 0;
+    uint32_t action = 0, selectFunction = 0, selectSequence = 0;
+    uint16_t species = 0, stone = 0, currentHP = 0, maxHP = 0;
+    uint8_t clientId = 0, battleSlot = 0, partySlot = 0, form = 0, flags = 0;
+    bool atMoveSelection = false;
+
+    bool eligible() const
+    {
+        const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(species, stone);
+        return atMoveSelection && currentHP && !(flags & 0x60) && profile &&
+               form == profile->baseForm;
+    }
+};
+
+struct BattleStats
+{
+    uint16_t species = 0, ability = 0, currentHP = 0, maxHP = 0;
+    uint8_t form = 0;
+    std::array<uint16_t, 5> stats{}; // Attack, Defense, Sp. Atk, Sp. Def, Speed
+};
+
+inline bool megaBattleDataApplied(const BattleStats& beforeClient,
+                                 const BattleStats& beforeServer,
+                                 const BattleStats& afterClient,
+                                 const BattleStats& afterServer,
+                                 const Gen5MegaEvolution::MegaProfile& profile)
+{
+    const auto validBefore = [&](const BattleStats& value) {
+        return value.species == profile.species && value.form == profile.baseForm &&
+               value.currentHP && value.currentHP <= value.maxHP;
+    };
+    const auto validAfter = [&](const BattleStats& value, const BattleStats& before) {
+        if (value.species != profile.species || value.form != profile.megaForm ||
+            (value.ability != profile.ability1 && value.ability != profile.ability2 &&
+             value.ability != profile.abilityH) || value.currentHP > before.currentHP ||
+            value.maxHP != before.maxHP) return false;
+        constexpr std::array<unsigned, 5> profileStatIndex{1, 2, 4, 5, 3};
+        for (std::size_t i = 0; i < value.stats.size(); ++i)
+        {
+            const auto stat = profileStatIndex[i];
+            const int delta = int(profile.stats[stat]) - int(profile.baseStats[stat]);
+            if ((delta > 0 && value.stats[i] <= before.stats[i]) ||
+                (delta < 0 && value.stats[i] >= before.stats[i]) ||
+                (delta == 0 && value.stats[i] != before.stats[i])) return false;
+        }
+        return true;
+    };
+    // The client and server battle copies can be on adjacent action-animation
+    // boundaries when the native form-change handler runs. Damage may already
+    // be present in one copy only; neither copy may gain HP or change max HP.
+    return validBefore(beforeClient) && validBefore(beforeServer) &&
+           beforeClient.stats == beforeServer.stats &&
+           validAfter(afterClient, beforeClient) && validAfter(afterServer, beforeServer) &&
+           afterClient.stats == afterServer.stats && afterClient.ability == afterServer.ability;
+}
+
+// The local roster fixture substitutes a species into a running Serperior
+// battle, so its pre-Mega live stats cannot be compared against that species'
+// base-stat deltas. Keep this weaker validator fixture-only: the exact profile
+// values are checked by the cartridge regression, while this confirms the
+// native handler applied one consistent form/ability/stat result to both sides.
+inline bool megaFixtureProfileDataApplied(
+    const BattleStats& beforeClient, const BattleStats& beforeServer,
+    const BattleStats& afterClient, const BattleStats& afterServer,
+    const Gen5MegaEvolution::MegaProfile& profile)
+{
+    const auto validBefore = [&](const BattleStats& value) {
+        return value.species == profile.species && value.form == profile.baseForm &&
+               value.currentHP && value.currentHP <= value.maxHP;
+    };
+    const auto validAfter = [&](const BattleStats& value, const BattleStats& before) {
+        return value.species == profile.species && value.form == profile.megaForm &&
+               (value.ability == profile.ability1 || value.ability == profile.ability2 ||
+                value.ability == profile.abilityH) && value.currentHP <= before.currentHP &&
+               value.maxHP == before.maxHP && value.stats != before.stats;
+    };
+    return validBefore(beforeClient) && validBefore(beforeServer) &&
+           beforeClient.stats == beforeServer.stats &&
+           validAfter(afterClient, beforeClient) && validAfter(afterServer, beforeServer) &&
+           afterClient.stats == afterServer.stats && afterClient.ability == afterServer.ability;
+}
+
+// Gen V's native ChangeForm command recalculates stats but leaves the active
+// battler's ability ID unchanged. Map the current ability slot to its Mega form
+// ability before the native handler refreshes ability effects.
+inline std::optional<uint16_t> megaAbilityForBaseAbility(
+    const Gen5MegaEvolution::MegaProfile& profile, uint16_t currentAbility)
+{
+    if (currentAbility == profile.baseAbility1) return profile.ability1;
+    if (currentAbility == profile.baseAbility2) return profile.ability2;
+    if (currentAbility == profile.baseAbilityH) return profile.abilityH;
+    return std::nullopt;
+}
+
+struct MegaAteEffect
+{
+    uint8_t convertedType = 0xFF;
+    uint16_t powerRatio = 0x1000;
+};
+
+inline std::optional<MegaAteEffect> megaAteEffectForAbility(
+    const Gen5MegaEvolution::MegaProfile& profile, uint8_t form,
+    uint16_t currentAbility)
+{
+    if (form != profile.megaForm || profile.normalMoveConversionType == 0xFF ||
+        profile.normalMovePowerRatio <= 0x1000 ||
+        (currentAbility != profile.ability1 && currentAbility != profile.ability2 &&
+         currentAbility != profile.abilityH))
+        return std::nullopt;
+    return MegaAteEffect{profile.normalMoveConversionType, profile.normalMovePowerRatio};
+}
+
+inline std::optional<MegaAteEffect> megaAteEffectForMove(
+    const Gen5MegaEvolution::MegaProfile& profile, uint8_t form,
+    uint16_t currentAbility, uint8_t moveType, uint8_t moveCategory)
+{
+    if (moveType != 0 || moveCategory == 0)
+        return std::nullopt;
+    return megaAteEffectForAbility(profile, form, currentAbility);
+}
+
+inline uint16_t applyMegaAtePowerRatio(uint16_t power, uint16_t ratio)
+{
+    const uint32_t scaled = uint32_t(power) * ratio;
+    uint32_t result = scaled >> 12;
+    if ((scaled & 0xFFF) > 0x800) ++result;
+    return uint16_t(std::min<uint32_t>(result, 0xFFFF));
+}
+
+// Preserve the battle data from the instant the native form change completes.
+// Later turns can alter stat stages and must not overwrite the Mega snapshot.
+struct MegaBattleDataSnapshot
+{
+    BattleStats client{}, server{};
+    bool captured = false;
+    bool verified = false;
+
+    bool captureOnce(const BattleStats& beforeClient, const BattleStats& beforeServer,
+                     const BattleStats& afterClient, const BattleStats& afterServer,
+                     const Gen5MegaEvolution::MegaProfile& profile)
+    {
+        if (captured) return false;
+        client = afterClient;
+        server = afterServer;
+        verified = megaBattleDataApplied(beforeClient, beforeServer,
+                                         client, server, profile);
+        captured = true;
+        return true;
+    }
+
+    bool captureFixtureProfile(const BattleStats& beforeClient,
+                               const BattleStats& beforeServer,
+                               const BattleStats& afterClient,
+                               const BattleStats& afterServer,
+                               const Gen5MegaEvolution::MegaProfile& profile)
+    {
+        if (captured) return false;
+        client = afterClient;
+        server = afterServer;
+        verified = megaFixtureProfileDataApplied(beforeClient, beforeServer,
+                                                client, server, profile);
+        captured = true;
+        return true;
+    }
+};
+
+class RAM
+{
+public:
+    RAM(const uint8_t* data, std::size_t size) : data(data), size(size) {}
+    bool valid(uint32_t address, std::size_t count) const
+    {
+        return data && size == 0x400000 && address >= 0x02000000 &&
+               count <= size && std::size_t(address - 0x02000000) <= size - count;
+    }
+    uint8_t byte(uint32_t address) const { return data[address - 0x02000000]; }
+    uint16_t half(uint32_t address) const
+    {
+        return uint16_t(byte(address) | (uint16_t(byte(address + 1)) << 8));
+    }
+    uint32_t word(uint32_t address) const
+    {
+        return uint32_t(half(address)) | (uint32_t(half(address + 2)) << 16);
+    }
+    bool object(uint32_t address, std::size_t count) const
+    {
+        return !(address & 3) && valid(address, count);
+    }
+private:
+    const uint8_t* data;
+    std::size_t size;
+};
+
+inline std::optional<BattleStats> readBattleStats(const RAM& ram, uint32_t mon)
+{
+    if (!ram.object(mon, 0x142)) return std::nullopt;
+    BattleStats value;
+    value.species = ram.half(mon + 0x0C);
+    value.ability = ram.half(mon + CurrentAbilityOffset);
+    value.currentHP = ram.half(mon + 0x10);
+    value.maxHP = ram.half(mon + 0x0E);
+    value.form = ram.byte(mon + 0x141);
+    value.stats = {ram.half(mon + 0xEE), ram.half(mon + 0xF0),
+        ram.half(mon + 0xF2), ram.half(mon + 0xF4), ram.half(mon + 0xF6)};
+    return value;
+}
+
+// Read Mega forms from the native client/server battler tables. The game's
+// ChangeForm command is its authoritative peer synchronization path; accept
+// an observation only after both copies agree on the owner, species, stone,
+// slot, and form. This lets each emulator reserve that trainer's one Mega use
+// after receiving the ordinary battle command, without adding a second wire
+// protocol beside the game's own link traffic.
+inline std::vector<Gen5MegaEvolution::Event> observedMegaForms(
+    const uint8_t* data, std::size_t size, uint32_t module, uint32_t battleId)
+{
+    const RAM ram(data, size);
+    std::vector<Gen5MegaEvolution::Event> events;
+    if (!battleId || !ram.object(module, 0x480)) return events;
+    const auto server = ram.word(module + 8);
+    const auto clientOwner = module + 0xC8;
+    const auto serverOwner = module + 0x1B0;
+    if (!ram.object(server, 0x48) || ram.word(server + 0xC) != module ||
+        ram.word(server + 0x10) != serverOwner || !ram.object(clientOwner, 0xE8) ||
+        !ram.object(serverOwner, 0xE8) || ram.word(clientOwner) != module ||
+        ram.word(serverOwner) != module)
+        return events;
+
+    for (unsigned battleSlot = 0; battleSlot < 24; ++battleSlot)
+    {
+        const auto clientMon = ram.word(clientOwner + 0x84 + battleSlot * 4);
+        const auto serverMon = ram.word(serverOwner + 0x84 + battleSlot * 4);
+        if (!clientMon || !serverMon || clientMon == serverMon ||
+            !ram.object(clientMon, 0x142) || !ram.object(serverMon, 0x142))
+            continue;
+
+        const auto species = ram.half(clientMon + 0x0C);
+        const auto stone = ram.half(clientMon + 0x12);
+        const auto form = ram.byte(clientMon + 0x141);
+        if (!species || ram.half(serverMon + 0x0C) != species ||
+            ram.half(serverMon + 0x12) != stone || ram.byte(clientMon + 0x19) != battleSlot ||
+            ram.byte(serverMon + 0x19) != battleSlot || ram.byte(serverMon + 0x141) != form)
+            continue; // A native form command may have updated only one copy so far.
+
+        const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(species, stone);
+        if (!profile || form != profile->megaForm) continue;
+        for (unsigned trainer = 0; trainer < 4; ++trainer)
+        {
+            const auto first = firstBattleSlot(trainer);
+            if (battleSlot >= first && battleSlot < first + 6)
+            {
+                events.push_back({battleId, 1, uint8_t(trainer), uint8_t(battleSlot - first),
+                                  species, stone, profile->baseForm, profile->megaForm});
+                break;
+            }
+        }
+    }
+    return events;
+}
+
+inline std::optional<uint32_t> findModule(const uint8_t* data, std::size_t size)
+{
+    const RAM ram(data, size);
+    if (!ram.valid(0x02141858, 4)) return std::nullopt;
+    const auto manager = ram.word(0x02141858);
+    if (!ram.object(manager, 32)) return std::nullopt;
+    auto process = ram.word(manager + 8);
+    std::array<uint32_t, 8> seen{};
+    for (unsigned depth = 0; process && depth < seen.size(); ++depth)
+    {
+        if (!ram.object(process, 32) ||
+            std::find(seen.begin(), seen.end(), process) != seen.end()) return std::nullopt;
+        seen[depth] = process;
+        if (ram.word(process) == 0x02090010 && ram.word(process + 4) == 0xFFFFFFFF)
+        {
+            const auto system = ram.word(process + 20);
+            if (!ram.object(system, 56)) return std::nullopt;
+            const auto nested = ram.word(system + 8);
+            if (!ram.object(nested, 32)) return std::nullopt;
+            auto active = ram.word(nested + 8);
+            std::array<uint32_t, 8> nestedSeen{};
+            std::optional<uint32_t> result;
+            for (unsigned i = 0; active && i < nestedSeen.size(); ++i)
+            {
+                if (!ram.object(active, 32) ||
+                    std::find(nestedSeen.begin(), nestedSeen.end(), active) != nestedSeen.end())
+                    return std::nullopt;
+                nestedSeen[i] = active;
+                if (ram.word(active + 4) == 167)
+                {
+                    const auto module = ram.word(active + 20);
+                    if (result || !ram.object(module, 0x480)) return std::nullopt;
+                    result = module;
+                }
+                active = ram.word(active + 24);
+            }
+            return active ? std::nullopt : result;
+        }
+        process = ram.word(process + 24);
+    }
+    return std::nullopt;
+}
+
+// Read-only. Offsets and callback entries were checked against both supplied
+// Redux command captures and the exact overlay-167 disassembly. A native call
+// still needs a hash-verified overlay and instruction-time revalidation.
