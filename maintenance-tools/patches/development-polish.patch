+class FrameDeadline
+{
+public:
+    void Start(uint32_t maximumFrames)
+    {
+        limit = maximumFrames;
+        elapsed = 0;
+    }
+    void Reset() { limit = elapsed = 0; }
+    bool Active() const { return limit != 0; }
+    uint32_t Elapsed() const { return elapsed; }
+    bool Advance()
+    {
+        if (!limit) return false;
+        if (++elapsed < limit) return false;
+        Reset();
+        return true;
+    }
+
+private:
+    uint32_t limit = 0;
+    uint32_t elapsed = 0;
+};
+
+class RecoveryAttemptLatch
+{
+public:
+    bool TryBegin()
+    {
+        if (attempted) return false;
+        attempted = true;
+        return true;
+    }
+    void SetRecovered(bool value) { recovered = value; }
+    void Reset() { attempted = false; recovered = false; }
+    bool Attempted() const { return attempted; }
+    bool Recovered() const { return recovered; }
+
+private:
+    bool attempted = false;
+    bool recovered = false;
+};
