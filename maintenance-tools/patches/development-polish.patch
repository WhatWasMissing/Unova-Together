+void NativeMegaRuntime::BeginFixtureDrive()
+{
+    if (qEnvironmentVariable("POKEPLAY_MEGA_EVOLUTION_CHECK") != "1") return;
+    impl->fixtureOverrideSpecies = 0;
+    impl->fixtureOverrideStone = 0;
+    impl->inputFrames = 0;
+    impl->fixtureInputAPressed = false;
+    impl->fixtureMovePromptValid = false;
+    impl->fixtureTouching = false;
+    impl->fixtureTapFramesLeft = 0;
+    impl->fixtureDriving = true;
+}
+
+QVariantMap NativeMegaRuntime::PrepareFixtureProfileOverride(melonDS::NDS& core,
+                                                              unsigned species)
+{
+    if (qEnvironmentVariable("POKEPLAY_MEGA_EVOLUTION_CHECK") != "1" ||
+        qEnvironmentVariable("POKEPLAY_MEGA_FIXTURE_PROFILE") != "1" ||
+        !impl->fixtureDriving)
+        return {{"ok", false}, {"reason", "Profile overrides are restricted to the Mega fixture"}};
+    if (species > 0xFFFF)
+        return {{"ok", false}, {"reason", "Requested species is outside the local Mega profile range"}};
+    const auto* profile = Gen5MegaEvolution::profileForSpecies(uint16_t(species));
+    if (!profile)
+        return {{"ok", false}, {"reason", "Requested species is not enabled in this local build"}};
+    if (impl->fixtureOverrideSpecies)
+        return {{"ok", false}, {"reason", "A fixture profile override is already applied"}};
+    const auto module = Gen5MegaBattle::findModule(core.MainRAM, core.MainRAMMask + 1);
+    const auto current = module ? Gen5MegaBattle::activeSelection(
+        core.MainRAM, core.MainRAMMask + 1, *module) : std::nullopt;
+    if (!current || !current->eligible() || !current->atMoveSelection ||
+        current->species != Gen5MegaEvolution::MegaSerperior.species ||
+        current->stone != Gen5MegaEvolution::MegaSerperior.stone ||
+        current->form != Gen5MegaEvolution::MegaSerperior.baseForm)
+        return {{"ok", false}, {"reason", "Fixture must start from an eligible Serperior move screen"}};
+
+    const Gen5MegaBattle::RAM ram(core.MainRAM, core.MainRAMMask + 1);
+    if (!ram.object(current->clientMon, 0x142) || !ram.object(current->serverMon, 0x142))
+        return {{"ok", false}, {"reason", "Fixture battle copies are not writable"}};
+    const auto writeHalf = [&](uint32_t address, uint16_t value) {
+        auto* out = core.MainRAM + address - 0x02000000;
+        megaFixtureWrite16(out, value);
+    };
+    std::array<uint8_t, PokemonTrading::RecordSize> originalClientSource{};
+    std::array<uint8_t, PokemonTrading::RecordSize> originalServerSource{};
+    std::array<uint8_t, PokemonTrading::RecordSize> patchedClientSource{};
+    std::array<uint8_t, PokemonTrading::RecordSize> patchedServerSource{};
+    std::memcpy(originalClientSource.data(), core.MainRAM + current->clientSource - 0x02000000,
+                originalClientSource.size());
+    std::memcpy(originalServerSource.data(), core.MainRAM + current->serverSource - 0x02000000,
+                originalServerSource.size());
+    patchedClientSource = originalClientSource;
+    patchedServerSource = originalServerSource;
+    if (!rewriteMegaFixturePartyRecord(patchedClientSource, *profile) ||
+        !rewriteMegaFixturePartyRecord(patchedServerSource, *profile))
+        return {{"ok", false}, {"reason", "Backing battle party records are not valid fixture Pokémon"}};
+    try
+    {
+        const QByteArray liveRAM = QByteArray::fromRawData(
+            reinterpret_cast<const char*>(core.MainRAM), int(core.MainRAMMask + 1));
+        const auto partyBase = PokemonTrading::FindParty(liveRAM, false);
+        const auto realPartyBegin = partyBase + 8;
+        const auto realPartyEnd = realPartyBegin + 6 * PokemonTrading::RecordSize;
+        const auto aliasesSavedParty = [&](uint32_t source) {
+            return source >= realPartyBegin && source < realPartyEnd;
+        };
+        if (aliasesSavedParty(current->clientSource) || aliasesSavedParty(current->serverSource))
+            return {{"ok", false}, {"reason", "Refusing to modify the real saved party"}};
+    }
+    catch (...)
+    {
+        return {{"ok", false}, {"reason", "Could not verify the real party before fixture setup"}};
+    }
+
+    std::memcpy(core.MainRAM + current->clientSource - 0x02000000,
+                patchedClientSource.data(), patchedClientSource.size());
+    std::memcpy(core.MainRAM + current->serverSource - 0x02000000,
+                patchedServerSource.data(), patchedServerSource.size());
+    writeHalf(current->clientMon + 0x0C, uint16_t(species));
+    writeHalf(current->serverMon + 0x0C, uint16_t(species));
+    writeHalf(current->clientMon + 0x12, profile->stone);
+    writeHalf(current->serverMon + 0x12, profile->stone);
+    writeHalf(current->clientMon + Gen5MegaBattle::BaseAbilityOffset, profile->baseAbility1);
+    writeHalf(current->serverMon + Gen5MegaBattle::BaseAbilityOffset, profile->baseAbility1);
+    writeHalf(current->clientMon + Gen5MegaBattle::CurrentAbilityOffset, profile->baseAbility1);
+    writeHalf(current->serverMon + Gen5MegaBattle::CurrentAbilityOffset, profile->baseAbility1);
+
+    const auto patched = Gen5MegaBattle::activeSelection(
+        core.MainRAM, core.MainRAMMask + 1, *module);
+    if (!patched || !patched->eligible() || patched->species != species ||
+        patched->stone != profile->stone || patched->form != profile->baseForm)
+    {
+        writeHalf(current->clientMon + 0x0C, current->species);
+        writeHalf(current->serverMon + 0x0C, current->species);
+        writeHalf(current->clientMon + 0x12, current->stone);
+        writeHalf(current->serverMon + 0x12, current->stone);
+        writeHalf(current->clientMon + Gen5MegaBattle::BaseAbilityOffset, uint16_t(Gen5MegaEvolution::MegaSerperior.baseAbility1));
+        writeHalf(current->serverMon + Gen5MegaBattle::BaseAbilityOffset, uint16_t(Gen5MegaEvolution::MegaSerperior.baseAbility1));
+        writeHalf(current->clientMon + Gen5MegaBattle::CurrentAbilityOffset, uint16_t(Gen5MegaEvolution::MegaSerperior.baseAbility1));
+        writeHalf(current->serverMon + Gen5MegaBattle::CurrentAbilityOffset, uint16_t(Gen5MegaEvolution::MegaSerperior.baseAbility1));
+        std::memcpy(core.MainRAM + current->clientSource - 0x02000000,
+                    originalClientSource.data(), originalClientSource.size());
+        std::memcpy(core.MainRAM + current->serverSource - 0x02000000,
+                    originalServerSource.data(), originalServerSource.size());
+        return {{"ok", false}, {"reason", "The paired fixture copies rejected the requested profile"}};
+    }
+    impl->fixtureOverrideSpecies = uint16_t(species);
+    impl->fixtureOverrideStone = profile->stone;
+    return {{"ok", true}, {"species", int(species)}, {"stone", int(profile->stone)},
+            {"battleCopiesAgreed", true}, {"savedPartyChanged", false}};
+}
+
+QVariantMap NativeMegaRuntime::QueueMegaEvolution(melonDS::NDS& core)
+{
+    const bool ownsBoundary = core.ARM9.BeforeBlockOrInstruction == &Impl::Boundary &&
+                              core.ARM9.BoundaryHookData == impl.get();
+    if (core.ARM9.BeforeInstruction ||
+        (core.ARM9.BeforeBlockOrInstruction && !ownsBoundary))
+        return {{"ok", false}, {"reason", "Another native task owns this core"}};
+    if (!verifiedCartridge(core))
+        return {{"ok", false}, {"reason", "The loaded cartridge does not match the reviewed Redux overlay"}};
+    if (!Gen5MegaBattle::reviewedEntryPoints(core.MainRAM, core.MainRAMMask + 1))
+        return {{"ok", false}, {"reason", "Reviewed Mega battle entry points are missing from live RAM"}};
+    const auto module = Gen5MegaBattle::findModule(core.MainRAM, core.MainRAMMask + 1);
+    if (!module) return {{"ok", false}, {"reason", "No owned native battle"}};
+    const auto remoteState = impl->remoteCall.GetState();
+    if (remoteState == Gen5MegaBattle::FormCall::State::Armed ||
+        remoteState == Gen5MegaBattle::FormCall::State::Running ||
+        (remoteState == Gen5MegaBattle::FormCall::State::NativeAccepted &&
+         !impl->remoteCheckpoint.isEmpty()))
+        return {{"ok", false}, {"reason", "The partner's Mega action is being applied"}};
+    if(melonDS::MPInterface::GetType()==melonDS::MPInterface_LAN) {
+        auto& lan=static_cast<melonDS::LAN&>(melonDS::MPInterface::Get());
+        if(lan.CoopChallengeStatus()==1 &&
+           (!impl->coopSyncExpected || impl->serial!=lan.CoopChallengeToken() ||
+            !lan.CoopMegaSyncReady()))
+            return {{"ok",false},{"reason","Waiting for the paired emulator to confirm its Mega battle seat"}};
+    }
+    const auto selection = Gen5MegaBattle::activeSelection(core.MainRAM, core.MainRAMMask + 1, *module);
+    const auto* profile = selection ? Gen5MegaEvolution::profileForSpeciesAndStone(selection->species, selection->stone) : nullptr;
+    if (impl->module && impl->module != *module)
+        return {{"ok", false}, {"reason", "Previous Mega session has not ended"}};
+    if (!impl->module) impl->clearBattleTransactions(false);
+    if (!selection)
+        return {{"ok", false}, {"reason", "Could not read the active Pokémon from both battle copies after switching"}};
+    if (!selection->eligible())
+        return {{"ok", false}, {"reason", "The active Pokémon must be healthy, hold its matching Mega Stone, and be at move selection"}};
+    if (!impl->repairLegacyBaseAbility(core, *selection))
+        return {{"ok", false}, {"reason", "The active Pokémon's base ability could not be reconciled with its party records"}};
+    melonDS::Savestate checkpoint;
+    if (!core.DoSavestate(&checkpoint) || checkpoint.Error)
+        return {{"ok", false}, {"reason", "Could not capture complete battle recovery state"}};
+    checkpoint.Finish();
+    if (checkpoint.Error) return {{"ok", false}, {"reason", "Could not finish recovery state"}};
+    auto serial = impl->module ? impl->serial : impl->serial + 1;
+    if (!serial) serial = 1;
+    const auto previousBattle = impl->battle;
+    const auto previousModule = impl->module;
+    if (!profile || !impl->call.Arm(core.MainRAM, core.MainRAMMask + 1, serial, impl->battle))
+        return {{"ok", false}, {"reason", "Select a healthy Pokémon holding its Mega Stone at move selection"}};
+    impl->localRecoveryAttempt.Reset();
+    impl->checkpoint = QByteArray(static_cast<const char*>(checkpoint.Buffer()), int(checkpoint.Length()));
+    impl->checkpointBattle = previousBattle; impl->checkpointModule = previousModule;
+    impl->core = &core; impl->cartridge = core.NDSCartSlot.GetCart();
+    impl->module = *module; impl->serial = serial; impl->frames = 0;
+    impl->boundaryVisits = impl->lastBoundaryPC = 0;
+    impl->changeFormDispatchVisits = impl->changeFormCommandHandlerVisits = 0;
+    impl->changeFormFunctionVisits = 0;
+    impl->fightSelectVisits = impl->moveInputVisits = 0;
+    impl->actionEntryVisits = impl->matchingActionEntryVisits = 0;
+    impl->actionEntryR0 = impl->actionEntryR1 = impl->actionEntryCpsr = 0;
+    impl->actionEntryIrq = impl->actionEntryCount = impl->actionEntryFirstType = 0;
+    impl->actionEntryFightCommitted = false;
+    impl->clientSourceFirstDiff = impl->serverSourceFirstDiff = -1;
+    impl->clientSourceBeforeDiff = impl->clientSourceAfterDiff = 0;
+    impl->serverSourceBeforeDiff = impl->serverSourceAfterDiff = 0;
+    impl->clientSourceDiffs.clear(); impl->serverSourceDiffs.clear();
+    impl->nativeHandlerCompleted = false; impl->nativeHandlerResult = 0;
+    impl->partyBase = impl->savedPartyRecord = 0;
+    impl->clientSourceIsSavedParty = impl->serverSourceIsSavedParty = false;
+    impl->savedPartyUnchanged = true;
+    impl->savedPartySnapshotValid = false;
+    impl->battleEnded = false;
+    impl->battleData = {};
+    impl->beforeClientBattle = {}; impl->beforeServerBattle = {};
+    impl->savedPartyBefore.fill(0);
+    try {
+        const QByteArray liveRAM = QByteArray::fromRawData(reinterpret_cast<const char*>(core.MainRAM), core.MainRAMMask + 1);
+        impl->partyBase = PokemonTrading::FindParty(liveRAM, false);
+        impl->savedPartyRecord = impl->partyBase + 8 + impl->call.Target().partySlot * PokemonTrading::RecordSize;
+        impl->clientSourceIsSavedParty = impl->call.Target().clientSource == impl->savedPartyRecord;
+        impl->serverSourceIsSavedParty = impl->call.Target().serverSource == impl->savedPartyRecord;
+        if (impl->savedPartyRecord >= 0x02000000 && impl->savedPartyRecord - 0x02000000 + PokemonTrading::RecordSize <= core.MainRAMMask + 1) {
+            std::memcpy(impl->savedPartyBefore.data(), core.MainRAM + impl->savedPartyRecord - 0x02000000, PokemonTrading::RecordSize);
+            impl->savedPartySnapshotValid = true;
+        }
+    } catch (...) {}
+    if (!impl->savedPartySnapshotValid) {
+        impl->call.Cancel(); impl->battle.end(); impl->checkpoint.clear(); impl->module = 0;
+        return {{"ok", false}, {"reason", "Could not verify the saved-party record for battle-only restoration"}};
+    }
+    impl->actionTimeline.clear();
+    impl->lastAction = impl->lastSelectFunction = impl->lastSelectSequence = 0;
+    impl->lastViewFunction = impl->lastViewSequence = impl->lastActionCount = 0;
+    impl->formsAgreed = false; impl->sourcesUnchanged = true;
+    impl->coopLocalEventSent = false;
+    impl->status = "Mega armed; waiting for a committed Fight action";
+    core.ARM9.BeforeBlockOrInstruction = &Impl::Boundary;
+    core.ARM9.BoundaryHookData = impl.get();
+    return {{"ok", true}, {"message", impl->status}};
+}
+
+void NativeMegaRuntime::Tick(melonDS::NDS& core)
+{
+    const auto module = Gen5MegaBattle::findModule(core.MainRAM, core.MainRAMMask + 1);
+    const auto* cartridge = core.NDSCartSlot.GetCart();
+    if (!impl->cartridgeChecked || impl->checkedCartridge != cartridge)
+    {
+        impl->checkedCartridge = cartridge;
+        impl->cartridgeChecked = true;
+        impl->cartridgeSupported = cartridge && verifiedCartridge(core);
+    }
+    // Redux replaces every original Mail ID with a Mega Stone. The game has
+    // both a pocket table and a separate Mail-ID table, so repair them after
+    // boot/reset and before item or party menus can consult them.
+    if (impl->cartridgeSupported)
+        Gen5MegaItemCompatibility::apply(core.MainRAM, std::size_t(core.MainRAMMask) + 1);
+    if (!module || !impl->cartridgeSupported)
+        impl->resetSpritePlayback(true);
+    if (!impl->module)
+    {
+        // Start observing verified native battles before the local player
+        // presses L+R. Otherwise a Mega command received from a linked peer
+        // would not consume this emulator's per-trainer use flag.
+        if (!module || !impl->cartridgeSupported ||
+            !Gen5MegaBattle::reviewedEntryPoints(core.MainRAM, core.MainRAMMask + 1)) return;
+        impl->clearBattleTransactions(false);
+        uint32_t battleId=impl->serial+1;
+        if(!battleId) battleId=1;
+        impl->coopSyncExpected=false;
+        if(melonDS::MPInterface::GetType()==melonDS::MPInterface_LAN) {
+            auto& lan=static_cast<melonDS::LAN&>(melonDS::MPInterface::Get());
+            if(lan.CoopChallengeStatus()==1) {
+                battleId=lan.CoopChallengeToken();
+                if(!battleId) return;
+                impl->coopSyncExpected=true;
+            }
+        }
+        impl->serial=battleId;
+        if (!impl->battle.begin(impl->serial)) return;
+        impl->core = &core;
+        impl->cartridge = cartridge;
+        impl->module = *module;
+        impl->localRecoveryAttempt.Reset();
+        impl->remoteRecoveryAttempt.Reset();
+        const auto clientId=Gen5MegaBattle::RAM(core.MainRAM,core.MainRAMMask+1).byte(*module+0x46C);
+        if(impl->coopSyncExpected && melonDS::MPInterface::GetType()==melonDS::MPInterface_LAN)
+            static_cast<melonDS::LAN&>(melonDS::MPInterface::Get()).BeginCoopMegaSync(impl->serial,clientId);
+        impl->status = "Tracking native Mega commands for this battle";
+    }
+    if (module && impl->module == *module && impl->core == &core && impl->cartridgeSupported)
+        impl->tickMegaSpriteFrames(core);
+    if (!impl->module || impl->core != &core) return;
+    const auto remoteStateBeforeTick = impl->remoteCall.GetState();
+    if ((remoteStateBeforeTick == Gen5MegaBattle::FormCall::State::Armed ||
+         remoteStateBeforeTick == Gen5MegaBattle::FormCall::State::Running ||
+         remoteStateBeforeTick == Gen5MegaBattle::FormCall::State::NativeAccepted) &&
+        impl->remoteArmedDeadline.Advance())
+    {
+        if (remoteStateBeforeTick == Gen5MegaBattle::FormCall::State::Armed)
+        {
+            // The native call has not entered the game yet, so canceling here
+            // is safe and releases the global ARM9 boundary hook.
+            impl->remoteCall.Cancel();
+            impl->pendingRemoteEvent.reset();
+            impl->remoteCheckpoint.clear();
+            impl->remoteBeforeCaptured=false;
+            impl->remoteEventAborted = true;
+            impl->status = "Partner Mega event timed out before a safe battle boundary";
+        }
+        else
+        {
+            impl->restoreRemote("Partner Mega native call did not complete safely");
+            return;
+        }
+    }
+    if(impl->coopSyncExpected && melonDS::MPInterface::GetType()==melonDS::MPInterface_LAN) {
+        const auto clientId=Gen5MegaBattle::RAM(core.MainRAM,core.MainRAMMask+1).byte(impl->module+0x46C);
+        static_cast<melonDS::LAN&>(melonDS::MPInterface::Get()).BeginCoopMegaSync(impl->serial,clientId);
+    }
+    using State = Gen5MegaBattle::FormCall::State;
+    const auto state = impl->call.GetState();
+    if (!module || *module != impl->module)
+    {
+        const auto remoteState = impl->remoteCall.GetState();
+        if (remoteState == State::Armed)
+        {
+            impl->remoteCall.Cancel();
+            impl->remoteArmedDeadline.Reset();
+            impl->pendingRemoteEvent.reset();
+            impl->remoteCheckpoint.clear();
+        }
+        else if (remoteState == State::Running || remoteState == State::RecoveryRequired ||
+                 (remoteState == State::NativeAccepted && !impl->remoteCheckpoint.isEmpty()))
+        {
+            impl->restoreRemote("Battle ownership changed during partner Mega call");
+            return;
+        }
+        if (state == State::Running || state == State::RecoveryRequired)
+            impl->restore("Native battle ownership changed during Mega call");
+        else impl->finishBattle();
+        return;
+    }
+    for (const auto& event : Gen5MegaBattle::observedMegaForms(
+             core.MainRAM, core.MainRAMMask + 1, impl->module, impl->serial))
+    {
+        const auto observed = impl->battle.receive(event);
+        if (observed != Gen5MegaEvolution::Result::Rejected)
+        {
+            impl->formsAgreed = true;
+            if (state != State::Running && state != State::NativeAccepted)
+                impl->status = "Native Mega command received; trainer use synchronized";
+        }
+    }
+    if(impl->coopSyncExpected && melonDS::MPInterface::GetType()==melonDS::MPInterface_LAN) {
+        auto& lan=static_cast<melonDS::LAN&>(melonDS::MPInterface::Get());
+        std::array<unsigned char,24> wire{};
+        while(lan.PopCoopMegaEvent(wire)) {
+            const auto event=Gen5MegaEvolution::decodeEvent(wire.data(),wire.size());
+            if(event && !impl->remoteEventAborted && event->battleId==impl->serial &&
+               event->trainer==lan.CoopMegaPartnerClientId() &&
+               !impl->battle.usedMega(Gen5MegaEvolution::Trainer(event->trainer)))
+                impl->pendingRemoteEvent=*event;
+        }
+    }
+    if (!impl->pendingRemoteEvent && !impl->remoteEventAborted) {
+        impl->pendingRemoteEvent = Gen5MegaBattle::heldStoneOpponentEvent(
+            core.MainRAM, core.MainRAMMask + 1, impl->module, impl->serial);
+    }
+    bool opponentMegaPrecedesLocalMega = false;
+    if (impl->pendingRemoteEvent && impl->call.GetState() == State::Armed)
+    {
+        const auto entry = Gen5MegaBattle::activeSelection(
+            core.MainRAM, core.MainRAMMask + 1, impl->module, true);
+        if (entry)
+        {
+            const Gen5MegaBattle::RAM ram(core.MainRAM, core.MainRAMMask + 1);
+            const auto localActionIndex = Gen5MegaBattle::committedFightIndex(ram, *entry);
+            const auto opponent = Gen5MegaBattle::targetForEvent(
+                core.MainRAM, core.MainRAMMask + 1, *entry, *impl->pendingRemoteEvent);
+            const auto opponentActionIndex = opponent
+                ? Gen5MegaBattle::committedFightIndex(ram, *opponent) : std::nullopt;
+            opponentMegaPrecedesLocalMega =
+                Gen5MegaBattle::opponentMegaPrecedesLocalMega(
+                    localActionIndex, opponentActionIndex);
+        }
+    }
+    const bool localMegaTransactionBlocksOpponent =
+        state == State::Running || state == State::RecoveryRequired ||
+        (state == State::Armed && !opponentMegaPrecedesLocalMega) ||
+        (state == State::NativeAccepted && !impl->checkpoint.isEmpty());
+    if(impl->pendingRemoteEvent && impl->remoteCall.GetState()!=State::Armed &&
+       impl->remoteCall.GetState()!=State::Running &&
+       !localMegaTransactionBlocksOpponent &&
+       (impl->checkpoint.isEmpty() || opponentMegaPrecedesLocalMega) &&
+       !impl->battle.usedMega(Gen5MegaEvolution::Trainer(impl->pendingRemoteEvent->trainer))) {
+        const bool hookAvailable=!core.ARM9.BeforeInstruction &&
+            (!core.ARM9.BeforeBlockOrInstruction ||
+             (core.ARM9.BeforeBlockOrInstruction==&Impl::Boundary &&
+              core.ARM9.BoundaryHookData==impl.get()));
+        if(hookAvailable && impl->remoteCall.ArmRemote(core.MainRAM,
+            core.MainRAMMask+1,impl->battle,*impl->pendingRemoteEvent)) {
+            const auto& target=impl->remoteCall.Target();
+            const Gen5MegaBattle::RAM ram(core.MainRAM,core.MainRAMMask+1);
+            if(!ram.object(target.clientMon,0x142) || !ram.object(target.serverMon,0x142)) {
+                impl->remoteCall.Cancel();
+                impl->pendingRemoteEvent.reset();
+                impl->remoteEventAborted=true;
+                impl->status="Mega event canceled because its native battle copies are invalid";
+                return;
+            }
+            impl->remoteBeforeClient=readMegaBattleStats(ram,target.clientMon);
+            impl->remoteBeforeServer=readMegaBattleStats(ram,target.serverMon);
+            impl->remoteBeforeCaptured=true;
+            impl->remoteFormConfirmed=false;
+            melonDS::Savestate recovery;
+            if(core.DoSavestate(&recovery) && !recovery.Error) {
+                recovery.Finish();
+                if(!recovery.Error) {
+                    impl->remoteCheckpoint=QByteArray(static_cast<const char*>(recovery.Buffer()),
+                        int(recovery.Length()));
+                    impl->remoteCheckpointBattle=impl->battle;
+                    impl->remoteCheckpointModule=impl->module;
+                    impl->remoteCheckpointFormsAgreed=impl->formsAgreed;
+                    core.ARM9.BeforeBlockOrInstruction=&Impl::Boundary;
+                    core.ARM9.BoundaryHookData=impl.get();
+                    impl->remoteArmedDeadline.Start(600);
+                    impl->remoteEventAborted=false;
+                    impl->remoteRecoveryAttempt.Reset();
+                    impl->status=impl->coopSyncExpected
+                        ? "Paired Mega event received; applying the partner form locally"
+                        : "Opponent Mega Stone activated; applying its form through the native battle handler";
+                }
+            }
+            if (impl->remoteCheckpoint.isEmpty()) {
+                impl->remoteCall.Cancel();
+                impl->pendingRemoteEvent.reset();
+                impl->remoteEventAborted=true;
+                impl->status="Mega event canceled because no recovery snapshot could be captured";
+            }
+        }
+    }
+    if (state == State::Canceled || state == State::Rejected)
+    {
+        if(impl->remoteCall.GetState()!=State::Armed && impl->remoteCall.GetState()!=State::Running)
+            impl->detach();
+        impl->checkpoint.clear();
+        impl->status = state == State::Canceled ? "Mega canceled; no use consumed" : "Mega rejected; no use consumed";
+    }
+    else if (state == State::RecoveryRequired ||
+             (!impl->sourcesUnchanged && (!impl->savedPartySnapshotValid || !impl->savedPartyUnchanged)) ||
+             (state == State::Running && ++impl->frames > 600))
+    {
+        impl->restore("Native Mega transaction did not finish safely");
+        return;
+    }
+    else if (state == State::NativeAccepted)
+    {
+        if(!impl->fixtureDriving && impl->remoteCall.GetState()!=State::Armed && impl->remoteCall.GetState()!=State::Running)
+            impl->detach();
+        if (!impl->captureBattleData() && ++impl->frames > 600)
+        {
+            impl->restore("Client form-change command did not complete");
+            return;
+        }
+        if (impl->battleData.captured && !impl->battleData.verified)
+        {
+            impl->restore("Native Mega form failed profile stat, ability, or HP verification");
+            return;
+        }
+    }
+
+    const auto remoteState=impl->remoteCall.GetState();
+    if(remoteState==State::NativeAccepted && !impl->remoteFormConfirmed) {
+        const auto& target=impl->remoteCall.Target();
+        const auto* profile=Gen5MegaEvolution::profileForSpeciesAndStone(target.species, target.stone);
+        const Gen5MegaBattle::RAM ram(core.MainRAM,core.MainRAMMask+1);
+        if(profile && ram.object(target.clientMon,0x142) && ram.object(target.serverMon,0x142) &&
+           ram.byte(target.clientMon+0x141)==profile->megaForm &&
+           ram.byte(target.serverMon+0x141)==profile->megaForm) {
+            const auto client=readMegaBattleStats(ram,target.clientMon);
+            const auto server=readMegaBattleStats(ram,target.serverMon);
+            if(!impl->remoteBeforeCaptured || !Gen5MegaBattle::megaBattleDataApplied(
+                   impl->remoteBeforeClient,impl->remoteBeforeServer,client,server,*profile)) {
+                impl->restoreRemote("Partner Mega form failed profile stat, ability, or HP verification");
+                return;
+            }
+            impl->pendingRemoteEvent.reset();
+            impl->formsAgreed=true;
+            impl->remoteFormConfirmed=true;
+            ++impl->pendingMegaEvolutionCues;
+            impl->status="Partner Mega form applied and confirmed in both local battle copies";
+            impl->remoteCheckpoint.clear();
+            impl->remoteArmedDeadline.Reset();
+            impl->remoteBeforeCaptured=false;
+            if(impl->call.GetState()!=State::Armed && impl->call.GetState()!=State::Running)
+                impl->detach();
+        }
+    } else if(remoteState==State::Rejected || remoteState==State::Canceled) {
+        impl->remoteArmedDeadline.Reset();
+        if (!impl->remoteEventAborted)
+            impl->status="Partner Mega event could not be safely applied on this emulator";
+        impl->pendingRemoteEvent.reset();
+        impl->remoteCheckpoint.clear();
+        impl->remoteBeforeCaptured=false;
+        if(impl->call.GetState()!=State::Armed && impl->call.GetState()!=State::Running)
+            impl->detach();
+    } else if(remoteState==State::RecoveryRequired) {
+        impl->restoreRemote("Partner Mega form failed native verification");
+    }
+}
