+// Rebuilds the image-bearing members of a Black 2 Pokegra block. Battle MCSS
+// draws BIN quads from a linear 4bpp texture; its NCER cells only supply the
+// animation indices. Single-cell menu images instead use four tiled OBJs.
+namespace Gen5MegaSprite {
+inline constexpr unsigned CanvasWidth = 96;
+inline constexpr unsigned CanvasHeight = 96;
+inline constexpr unsigned PixelCount = CanvasWidth * CanvasHeight;
+inline constexpr unsigned ColorsPerPalette = 16;
+inline constexpr unsigned OamsPerCell = 9;
+inline constexpr unsigned PartObjectPixels = 32;
+inline constexpr unsigned PartObjectTileCount = 16;
+// Ancillary NCER cells retain 64-byte OBJ mapping. MCSS itself draws the BIN
+// textured quads and does not use these OAM tile addresses to sample images.
+inline constexpr unsigned PartOamTileStride = PartObjectTileCount / 2;
+
+struct Art
+{
+    uint16_t species = 0;
+    std::array<uint8_t, PixelCount> front{};
+    std::array<uint8_t, PixelCount> back{};
+    std::array<uint16_t, ColorsPerPalette> normalPalette{};
+    std::array<uint16_t, ColorsPerPalette> shinyPalette{};
+};
+
+// Two packed 4bpp poses per side, sampled from a source GIF. The unanimated
+// OBJ/menu resources continue to use Art's stable representative pose.
+struct Animation
+{
+    uint16_t species = 0;
+    const uint8_t* frontPackedFrames = nullptr; // 2 * (96 * 96 / 2) bytes
+    const uint8_t* backPackedFrames = nullptr;
+    std::array<uint16_t, 2> frontDurations{1, 1};
+    std::array<uint16_t, 2> backDurations{1, 1};
+};
+
+inline uint16_t half(const std::vector<uint8_t>& data, std::size_t at)
+{
+    if (at > data.size() || data.size() - at < 2)
+        throw std::runtime_error("Mega sprite resource is truncated");
+    return uint16_t(data[at] | (uint16_t(data[at + 1]) << 8));
+}
+
+inline uint32_t word(const std::vector<uint8_t>& data, std::size_t at)
+{
+    return uint32_t(half(data, at)) | (uint32_t(half(data, at + 2)) << 16);
+}
+
+inline void putHalf(std::vector<uint8_t>& data, std::size_t at, uint16_t value)
+{
+    if (at > data.size() || data.size() - at < 2)
+        throw std::runtime_error("Mega sprite resource is truncated");
+    data[at] = uint8_t(value);
+    data[at + 1] = uint8_t(value >> 8);
+}
+
+inline void putWord(std::vector<uint8_t>& data, std::size_t at, uint32_t value)
+{
+    putHalf(data, at, uint16_t(value));
+    putHalf(data, at + 2, uint16_t(value >> 16));
+}
+
+inline bool magic(const std::vector<uint8_t>& data, std::size_t at, const char* text)
+{
+    return at <= data.size() && data.size() - at >= 4 &&
+           std::memcmp(data.data() + at, text, 4) == 0;
+}
+
+inline std::vector<uint8_t> unpackLz(const std::vector<uint8_t>& source)
+{
+    if (source.empty() || (source[0] != 0x10 && source[0] != 0x11))
+        return source;
+    const uint8_t kind = source[0];
+    if (source.size() < 4) throw std::runtime_error("Truncated Mega sprite LZ header");
+    std::size_t cursor = 4;
+    std::size_t outputSize = std::size_t(source[1]) | (std::size_t(source[2]) << 8) |
+                             (std::size_t(source[3]) << 16);
+    if (!outputSize)
+    {
+        if (source.size() < 8) throw std::runtime_error("Truncated extended Mega sprite LZ header");
+        outputSize = word(source, 4);
+        cursor = 8;
+    }
+    if (!outputSize || outputSize > 64 * 1024 * 1024)
+        throw std::runtime_error("Mega sprite LZ output exceeds its safety limit");
+
+    std::vector<uint8_t> output;
+    output.reserve(outputSize);
+    while (output.size() < outputSize)
+    {
+        if (cursor >= source.size()) throw std::runtime_error("Truncated Mega sprite LZ flags");
+        const uint8_t flags = source[cursor++];
+        for (int bit = 7; bit >= 0 && output.size() < outputSize; --bit)
+        {
+            if (!(flags & (1u << bit)))
+            {
+                if (cursor >= source.size()) throw std::runtime_error("Truncated Mega sprite LZ literal");
+                output.push_back(source[cursor++]);
+                continue;
+            }
+
+            if (cursor + 2 > source.size()) throw std::runtime_error("Truncated Mega sprite LZ token");
+            const uint8_t a = source[cursor++];
+            const uint8_t b = source[cursor++];
+            std::size_t count = 0, distance = 0;
+            if (kind == 0x10)
+            {
+                count = (a >> 4) + 3;
+                distance = ((std::size_t(a & 0x0F) << 8) | b) + 1;
+            }
+            else
+            {
+                const unsigned mode = a >> 4;
+                if (mode == 0)
+                {
+                    if (cursor >= source.size()) throw std::runtime_error("Truncated long Mega sprite LZ token");
+                    const uint8_t c = source[cursor++];
+                    count = ((std::size_t(a & 0x0F) << 4) | (b >> 4)) + 0x11;
+                    distance = ((std::size_t(b & 0x0F) << 8) | c) + 1;
+                }
+                else if (mode == 1)
+                {
+                    if (cursor + 2 > source.size()) throw std::runtime_error("Truncated long Mega sprite LZ token");
+                    const uint8_t c = source[cursor++];
+                    const uint8_t d = source[cursor++];
+                    count = ((std::size_t(a & 0x0F) << 12) | (std::size_t(b) << 4) |
+                             (c >> 4)) + 0x111;
+                    distance = ((std::size_t(c & 0x0F) << 8) | d) + 1;
+                }
+                else
+                {
+                    count = mode + 1;
+                    distance = ((std::size_t(a & 0x0F) << 8) | b) + 1;
+                }
+            }
+            if (!distance || distance > output.size() || count > outputSize - output.size())
+                throw std::runtime_error("Invalid Mega sprite LZ back-reference");
+            for (std::size_t i = 0; i < count; ++i)
+                output.push_back(output[output.size() - distance]);
+        }
+    }
+    return output;
+}
+
+inline std::vector<uint8_t> packLzLiterals(const std::vector<uint8_t>& source, uint8_t kind)
+{
+    if ((kind != 0x10 && kind != 0x11) || source.empty())
+        throw std::runtime_error("Invalid Mega sprite LZ source");
+    std::vector<uint8_t> output{kind};
+    if (source.size() <= 0xFFFFFF)
+    {
+        output.push_back(uint8_t(source.size()));
+        output.push_back(uint8_t(source.size() >> 8));
+        output.push_back(uint8_t(source.size() >> 16));
+    }
+    else
+    {
+        output.insert(output.end(), {0, 0, 0});
+        const auto oldSize = output.size();
+        output.resize(oldSize + 4);
+        putWord(output, oldSize, uint32_t(source.size()));
+    }
+    for (std::size_t offset = 0; offset < source.size(); offset += 8)
+    {
+        output.push_back(0); // Eight literal bytes.
+        const auto count = std::min<std::size_t>(8, source.size() - offset);
+        output.insert(output.end(), source.begin() + offset, source.begin() + offset + count);
+    }
+    return output;
+}
+
+inline std::vector<uint8_t> restoreCompression(const std::vector<uint8_t>& original,
+                                               std::vector<uint8_t> replacement)
+{
+    return !original.empty() && (original[0] == 0x10 || original[0] == 0x11)
+        ? packLzLiterals(replacement, original[0]) : std::move(replacement);
+}
+
+inline std::size_t section(const std::vector<uint8_t>& data, const char* name,
+                           bool allowShortStoredPayload = false)
+{
+    if (data.size() < 16) throw std::runtime_error("Invalid Mega sprite Nitro header");
+    const auto count = half(data, 14);
+    std::size_t cursor = half(data, 12);
+    for (unsigned i = 0; i < count; ++i)
+    {
+        if (cursor > data.size() || data.size() - cursor < 8)
+            throw std::runtime_error("Invalid Mega sprite Nitro section");
+        const auto size = word(data, cursor + 4);
+        if (size < 8 || (size > data.size() - cursor &&
+                         !(allowShortStoredPayload && magic(data, cursor, name))))
+            throw std::runtime_error("Invalid Mega sprite Nitro section size");
+        if (magic(data, cursor, name)) return cursor;
+        cursor += size;
+    }
+    throw std::runtime_error("Mega sprite Nitro section is missing");
+}
+
+inline void setNCGR(std::vector<uint8_t>& member,
+                    const std::array<uint8_t, PixelCount>& pixels,
+                    unsigned tileStride,
+                    bool battleTexture = false)
+{
+    auto raw = unpackLz(member);
+    if (!magic(raw, 0, "RGCN")) throw std::runtime_error("Mega sprite is not an NCGR");
+    // Gen V stores some NCGRs with a logical 0x2020-byte section but only the
+    // non-empty 0x1230-byte prefix compressed. The declared tile-data extent is
+    // still present and is the part the battle renderer reads.
+    const auto at = section(raw, "RAHC", true);
+    const auto sectionSize = word(raw, at + 4);
+    if (sectionSize < 8 || half(raw, at + 12) != 3)
+        throw std::runtime_error("Mega sprite NCGR is not 4bpp");
+    const auto dataSize = word(raw, at + 24);
+    const auto dataOffset = word(raw, at + 28);
+    const auto dataAt = at + 8 + dataOffset;
+    const unsigned textureWidth = half(raw, at + 10) * 8;
+    const unsigned textureHeight = half(raw, at + 8) * 8;
+    if (dataOffset > sectionSize - 8 || dataSize > sectionSize - 8 - dataOffset ||
+        dataAt > raw.size() || dataSize > raw.size() - dataAt ||
+        (!battleTexture && (tileStride != 12 || dataSize < PixelCount / 2)) ||
+        (battleTexture && (textureWidth < CanvasWidth || textureHeight < CanvasHeight ||
+                           std::size_t(textureWidth) * textureHeight / 2 > dataSize)))
+        throw std::runtime_error("Mega sprite NCGR cannot hold a 96x96 image");
+
+    std::fill(raw.begin() + dataAt, raw.begin() + dataAt + dataSize, 0);
+    for (unsigned y = 0; y < CanvasHeight; ++y)
+        for (unsigned x = 0; x < CanvasWidth; ++x)
+        {
+            const auto value = pixels[y * CanvasWidth + x];
+            if (value > 15) throw std::runtime_error("Mega sprite pixel exceeds 4bpp");
+            // PokeGra_ImageToCellChars (BW2 system/pokegra.c): 64x64,
+            // 32x64, 64x32, 32x32 objects, each internally tiled. MCSS instead
+            // uploads its data verbatim through NNS_G2dLoadImage2DMapping.
+            const unsigned tile = y < 64
+                ? (x < 64 ? (y / 8) * 8 + x / 8
+                          : 64 + (y / 8) * 4 + (x - 64) / 8)
+                : (x < 64 ? 96 + ((y - 64) / 8) * 8 + x / 8
+                          : 128 + ((y - 64) / 8) * 4 + (x - 64) / 8);
+            const auto pixel = battleTexture ? y * textureWidth + x
+                                             : tile * 64 + (y % 8) * 8 + x % 8;
+            const auto offset = dataAt + pixel / 2;
+            if ((pixel & 1) == 0) raw[offset] = uint8_t((raw[offset] & 0xF0) | value);
+            else raw[offset] = uint8_t((raw[offset] & 0x0F) | (value << 4));
+        }
+    member = restoreCompression(member, std::move(raw));
+}
+
+inline void setAnimatedBattleNCGR(std::vector<uint8_t>& member, const uint8_t* frames)
+{
+    if (!frames) throw std::runtime_error("Animated Mega sprite has no frame data");
+    auto raw = unpackLz(member);
+    if (!magic(raw, 0, "RGCN")) throw std::runtime_error("Mega sprite is not an NCGR");
+    const auto at = section(raw, "RAHC", true);
+    const auto sectionSize = word(raw, at + 4);
+    if (sectionSize < 8 || half(raw, at + 12) != 3)
+        throw std::runtime_error("Animated Mega sprite NCGR is not 4bpp");
+    const auto dataSize = word(raw, at + 24);
+    const auto dataOffset = word(raw, at + 28);
+    const auto dataAt = at + 8 + dataOffset;
+    const unsigned textureWidth = half(raw, at + 10) * 8;
+    const unsigned textureHeight = half(raw, at + 8) * 8;
+    if (dataOffset > sectionSize - 8 || dataSize > sectionSize - 8 - dataOffset ||
+        dataAt > raw.size() || dataSize > raw.size() - dataAt ||
+        textureWidth < 128 + CanvasWidth || textureHeight < CanvasHeight ||
+        std::size_t(textureWidth) * textureHeight / 2 > dataSize)
+        throw std::runtime_error("Mega sprite NCGR cannot hold two 96x96 animation frames");
+
+    std::fill(raw.begin() + dataAt, raw.begin() + dataAt + dataSize, 0);
+    for (unsigned frame = 0; frame < 2; ++frame)
+        for (unsigned y = 0; y < CanvasHeight; ++y)
+            for (unsigned x = 0; x < CanvasWidth; ++x)
+            {
+                const unsigned pixel = frame * PixelCount + y * CanvasWidth + x;
+                const uint8_t packed = frames[pixel / 2];
+                const uint8_t value = uint8_t((packed >> ((pixel & 1) * 4)) & 15);
+                const unsigned atlasPixel = y * textureWidth + frame * 128 + x;
+                const auto offset = dataAt + atlasPixel / 2;
+                if ((atlasPixel & 1) == 0) raw[offset] = uint8_t((raw[offset] & 0xF0) | value);
+                else raw[offset] = uint8_t((raw[offset] & 0x0F) | (value << 4));
+            }
+    member = restoreCompression(member, std::move(raw));
+}
+
+inline std::vector<uint8_t> fullCanvasMcssBin(const std::vector<uint8_t>& member,
+                                              bool animated = false)
+{
+    // MCSSBin = count,u16 width,height,s16 offsets, then count pairs of
+    // six-fx32 quads. Preserve its trailing battle metadata and table size.
+    // MCSS_DrawQuad uses x/y in 1/16-pixel world units (<<8), while its
+    // texture dimensions and coordinates are ordinary fx32 pixels (<<12).
+    auto raw = member;
+    if (raw.size() < 12) throw std::runtime_error("Truncated Mega sprite MCSS BIN header");
+    const auto count = word(raw, 0);
+    if (!count || count > 1024 || (animated && count < 2) ||
+        std::size_t(count) * 48 > raw.size() - 12 ||
+        raw.size() - 12 - std::size_t(count) * 48 < 2)
+        throw std::runtime_error("Invalid Mega sprite MCSS BIN quad table");
+    putHalf(raw, 4, CanvasWidth);
+    putHalf(raw, 6, CanvasHeight);
+    putHalf(raw, 8, 0);
+    putHalf(raw, 10, 0);
+    for (unsigned cell = 0; cell < count; ++cell)
+    {
+        const auto at = 12 + std::size_t(cell) * 48;
+        std::fill(raw.begin() + at, raw.begin() + at + 48, 0);
+        putWord(raw, at, uint32_t(int32_t(-int(CanvasWidth / 2) * 256)));
+        putWord(raw, at + 4, CanvasHeight * 256); // Top, with the feet at y=0.
+        putWord(raw, at + 8, CanvasWidth * 4096);
+        putWord(raw, at + 12, CanvasHeight * 4096);
+        if (animated)
+            putWord(raw, at + 16, (cell == 1 ? 128u : 0u) * 4096);
+    }
+    return raw;
+}
+
+inline void setNCLR(std::vector<uint8_t>& member,
+                    const std::array<uint16_t, ColorsPerPalette>& colors)
+{
+    auto raw = unpackLz(member);
+    if (!magic(raw, 0, "RLCN")) throw std::runtime_error("Mega sprite is not an NCLR");
+    const auto at = section(raw, "TTLP");
+    const auto size = word(raw, at + 4);
+    const auto paletteSize = word(raw, at + 16);
+    const auto paletteOffset = word(raw, at + 20);
+    const auto paletteAt = at + 8 + paletteOffset;
+    if (size > raw.size() - at || paletteSize < ColorsPerPalette * 2 ||
+        paletteAt > raw.size() || paletteSize > raw.size() - paletteAt)
+        throw std::runtime_error("Mega sprite NCLR has no 16-color palette");
+    for (unsigned i = 0; i < ColorsPerPalette; ++i)
+        putHalf(raw, paletteAt + i * 2, colors[i] & 0x7FFF);
+    member = restoreCompression(member, std::move(raw));
+}
+
+inline std::vector<uint8_t> fullCanvasNcer(const std::vector<uint8_t>& member)
+{
+    const auto raw = unpackLz(member);
+    if (!magic(raw, 0, "RECN")) throw std::runtime_error("Mega sprite is not an NCER");
+    const auto at = section(raw, "KBEC");
+    const auto oldSize = word(raw, at + 4);
+    if (oldSize > raw.size() - at || oldSize < 0x20)
+        throw std::runtime_error("Invalid Mega sprite NCER cell block");
+    const auto cellCount = half(raw, at + 8);
+    const auto tableOffset = word(raw, at + 12);
+    const auto tableAt = at + 8 + tableOffset;
+    const auto tableSize = std::size_t(cellCount) * 8;
+    if (!cellCount || cellCount > 1024 || tableOffset < 0x18 ||
+        tableAt > at + oldSize || tableSize > at + oldSize - tableAt)
+        throw std::runtime_error("Invalid Mega sprite NCER cell table");
+    const auto oamAt = tableAt + tableSize;
+    const auto firstOamOffset = word(raw, tableAt + 4);
+    if (firstOamOffset > at + oldSize - oamAt)
+        throw std::runtime_error("Invalid Mega sprite NCER OAM table");
+
+    std::vector<uint8_t> cells(raw.begin() + at, raw.begin() + tableAt + tableSize);
+    const auto newOamOffset = std::size_t(firstOamOffset);
+    const auto newOamBytes = std::size_t(cellCount) * OamsPerCell * 6;
+    cells.resize(cells.size() + newOamOffset + newOamBytes, 0);
+    putWord(cells, 4, uint32_t(cells.size()));
+    const auto newTableAt = 8 + tableOffset;
+    for (unsigned cell = 0; cell < cellCount; ++cell)
+    {
+        const auto row = newTableAt + cell * 8;
+        putHalf(cells, row, OamsPerCell);
+        putWord(cells, row + 4, uint32_t(firstOamOffset + cell * OamsPerCell * 6));
+    }
+
+    const auto objectBase = newTableAt + tableSize + newOamOffset;
+    unsigned object = 0;
+    for (unsigned row = 0; row < 3; ++row)
+        for (unsigned column = 0; column < 3; ++column, ++object)
+        {
+            const int x = -48 + int(column * 32);
+            const int y = -48 + int(row * 32);
+            const uint16_t attr0 = uint16_t(uint8_t(y)); // square, regular, 4bpp
+            const uint16_t attr1 = uint16_t((x & 0x1FF) | (2u << 14)); // 32x32
+            const uint16_t tile = uint16_t((row * 3 + column) * PartOamTileStride);
+            for (unsigned cell = 0; cell < cellCount; ++cell)
+            {
+                const auto entry = objectBase + (cell * OamsPerCell + object) * 6;
+                putHalf(cells, entry, attr0);
+                putHalf(cells, entry + 2, attr1);
+                putHalf(cells, entry + 4, tile);
+            }
+        }
+
+    std::vector<uint8_t> result;
+    result.reserve(raw.size() - oldSize + cells.size());
+    result.insert(result.end(), raw.begin(), raw.begin() + at);
+    result.insert(result.end(), cells.begin(), cells.end());
+    result.insert(result.end(), raw.begin() + at + oldSize, raw.end());
+    putWord(result, 8, uint32_t(result.size()));
+    return restoreCompression(member, std::move(result));
+}
+
+inline std::vector<uint8_t> singleSpriteNmcr(const std::vector<uint8_t>& member,
+                                             int x, int y)
+{
+    auto raw = unpackLz(member);
+    if (!magic(raw, 0, "RCMN")) throw std::runtime_error("Mega sprite is not an NMCR");
+    const auto at = section(raw, "KBCM");
+    const auto oldSize = word(raw, at + 4);
+    if (oldSize > raw.size() - at || oldSize < 0x18)
+        throw std::runtime_error("Invalid Mega sprite NMCR mapping block");
+    const auto mapCount = half(raw, at + 8);
+    const auto tableOffset = word(raw, at + 12);
+    const auto tableAt = at + 8 + tableOffset;
+    const auto tableSize = std::size_t(mapCount) * 8;
+    if (!mapCount || mapCount > 2048 || tableOffset < 0x10 ||
+        tableAt > at + oldSize || tableSize > at + oldSize - tableAt)
+        throw std::runtime_error("Invalid Mega sprite NMCR map table");
+    const auto recordBase = at + 8 + word(raw, at + 16);
+    if (recordBase < tableAt + tableSize || recordBase > at + oldSize ||
+        std::size_t(mapCount) * 8 > at + oldSize - recordBase)
+        throw std::runtime_error("Mega sprite NMCR has no room for its static map records");
+
+    // Keep the original section size and following offsets. Some game builds
+    // load Pokegra animation banks into fixed-size work buffers.
+    for (unsigned map = 0; map < mapCount; ++map)
+    {
+        const auto row = tableAt + std::size_t(map) * 8;
+        putHalf(raw, row, 1);
+        putHalf(raw, row + 2, 1); // One cell animation, as well as one node.
+        putWord(raw, row + 4, map * 8);
+
+        // NMCR records point to NANR sub-animations. Animation 0 already
+        // selects NCER cell 0, so all layouts can share the same static Mega.
+        const auto record = recordBase + std::size_t(map) * 8;
+        putHalf(raw, record, 0);
+        putHalf(raw, record + 2, uint16_t(int16_t(x)));
+        putHalf(raw, record + 4, uint16_t(int16_t(y)));
+        putHalf(raw, record + 6, 0);
+    }
+    return restoreCompression(member, std::move(raw));
+}
+
+inline std::vector<uint8_t> staticFirstNanrAnimation(const std::vector<uint8_t>& member)
+{
+    auto raw = unpackLz(member);
+    if (!magic(raw, 0, "RNAN")) throw std::runtime_error("Mega sprite is not a NANR");
+    const auto at = section(raw, "KNBA");
+    const auto oldSize = word(raw, at + 4);
+    if (oldSize > raw.size() - at || oldSize < 0x18)
+        throw std::runtime_error("Invalid Mega sprite NANR animation block");
+    const auto animationCount = half(raw, at + 8);
+    const auto animationTableOffset = word(raw, at + 12);
+    const auto frameDataOffset = word(raw, at + 16);
+    const auto frameElementOffset = word(raw, at + 20);
+    const auto animationAt = at + 8 + animationTableOffset;
+    if (!animationCount || animationTableOffset < 0x18 ||
+        animationAt > at + oldSize ||
+        std::size_t(animationCount) * 16 > at + oldSize - animationAt)
+        throw std::runtime_error("Invalid Mega sprite NANR animation table");
+
+    const auto entry = animationAt; // A single static cell uses sub-animation 0.
+    const auto frameCount = half(raw, entry);
+    const auto frameFormat = half(raw, entry + 4);
+    const auto frameDataAt = at + 8 + frameDataOffset + word(raw, entry + 12);
+    const auto frameElementAt = at + 8 + frameElementOffset;
+    const unsigned frameElementSize = frameFormat == 0 ? 2 : frameFormat == 1 ? 16 :
+                                      frameFormat == 2 ? 8 : frameFormat == 3 ? 4 : 0;
+    if (!frameCount || frameCount > 4096 || !frameElementSize ||
+        frameDataOffset > oldSize || frameElementOffset > oldSize ||
+        frameDataAt > at + oldSize || std::size_t(frameCount) * 8 > at + oldSize - frameDataAt)
+        throw std::runtime_error("Mega sprite NANR sub-animation has an unsupported format");
+
+    for (unsigned frame = 0; frame < frameCount; ++frame)
+    {
+        const auto frameAt = frameDataAt + std::size_t(frame) * 8;
+        const auto elementOffset = word(raw, frameAt);
+        if (elementOffset > oldSize || frameElementAt > at + oldSize ||
+            elementOffset > at + oldSize - frameElementAt ||
+            at + oldSize - (frameElementAt + elementOffset) < frameElementSize)
+            throw std::runtime_error("Invalid Mega sprite NANR frame element");
+        const auto element = frameElementAt + elementOffset;
+        putHalf(raw, element, 0); // NCER cell 0: one complete sprite canvas.
+        if (frameFormat == 1)
+        {
+            putHalf(raw, element + 2, 0); // rotation
+            putWord(raw, element + 4, 0x1000); // fx32 (20.12) identity scale
+            putWord(raw, element + 8, 0x1000);
+            putHalf(raw, element + 12, 0); // translation x
+            putHalf(raw, element + 14, 0); // translation y
+        }
+        else if (frameFormat == 2)
+        {
+            putHalf(raw, element + 4, 0); // translation x
+            putHalf(raw, element + 6, 0); // translation y
+        }
+    }
+    return restoreCompression(member, std::move(raw));
+}
+
+inline std::vector<uint8_t> animatedFirstNanrAnimation(
+    const std::vector<uint8_t>& member, const std::array<uint16_t, 2>& durations)
+{
+    auto raw = unpackLz(member);
+    if (!magic(raw, 0, "RNAN")) throw std::runtime_error("Mega sprite is not a NANR");
+    const auto at = section(raw, "KNBA");
+    const auto oldSize = word(raw, at + 4);
+    if (oldSize > raw.size() - at || oldSize < 0x18)
+        throw std::runtime_error("Invalid Mega sprite NANR animation block");
+    const auto animationCount = half(raw, at + 8);
+    const auto animationTableOffset = word(raw, at + 12);
+    const auto frameDataOffset = word(raw, at + 16);
+    const auto frameElementOffset = word(raw, at + 20);
+    const auto animationAt = at + 8 + animationTableOffset;
+    if (!animationCount || animationTableOffset < 0x18 || animationAt > at + oldSize ||
+        std::size_t(animationCount) * 16 > at + oldSize - animationAt)
+        throw std::runtime_error("Invalid Mega sprite NANR animation table");
+
+    const auto entry = animationAt;
+    const auto sourceFrameCount = half(raw, entry);
+    const auto frameFormat = half(raw, entry + 4);
+    const auto frameDataAt = at + 8 + frameDataOffset + word(raw, entry + 12);
+    const auto frameElementAt = at + 8 + frameElementOffset;
+    const unsigned frameElementSize = frameFormat == 0 ? 2 : frameFormat == 1 ? 16 :
