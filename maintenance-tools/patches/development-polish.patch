+    void tickMegaSpriteFrames(melonDS::NDS& liveCore)
+    {
+        using namespace Gen5MegaSpriteStream;
+        if (!spriteAnimationLoadAttempted)
+        {
+            spriteAnimationLoadAttempted = true;
+            QFile resource(":/gen5mega/animations.bin");
+            if (resource.open(QIODevice::ReadOnly))
+            {
+                spriteAnimationPack = resource.readAll();
+                if (!parsePack(reinterpret_cast<const uint8_t*>(spriteAnimationPack.constData()),
+                               std::size_t(spriteAnimationPack.size()), spriteAnimationClips))
+                {
+                    spriteAnimationPack.clear();
+                    spriteAnimationClips.clear();
+                }
+            }
+        }
+        if (spriteAnimationClips.empty() || !liveCore.MainRAM ||
+            std::size_t(liveCore.MainRAMMask) + 1 != MainRamSize)
+        {
+            resetSpritePlayback(true);
+            return;
+        }
+
+        const auto* ram = liveCore.MainRAM;
+        const auto size = std::size_t(liveCore.MainRAMMask) + 1;
+        BattleSpriteSystem battleSprites;
+        if (spriteMcssSystem && spriteMcssWork)
+        {
+            if (!decodeBattleSpriteSystem(ram, size, spriteMcssSystem,
+                                          spriteMcssWork, battleSprites))
+            {
+                resetSpritePlayback(true);
+                spriteScanDelay = 30;
+                return;
+            }
+        }
+        else
+        {
+            if (spriteScanDelay)
+            {
+                --spriteScanDelay;
+                return;
+            }
+            if (!findBattleSpriteSystem(ram, size, 0, 0, battleSprites))
+            {
+                spriteScanDelay = 30;
+                return;
+            }
+            spriteMcssSystem = battleSprites.systemAddress;
+            spriteMcssWork = battleSprites.workAddress;
+        }
+
+        std::array<bool, BattleSpriteCount> seen{};
+        for (const auto& sprite : battleSprites.sprites)
+        {
+            const auto* profile = Gen5MegaEvolution::profileForSpeciesForm(
+                sprite.species, sprite.form);
+            const auto* clip = findClip(spriteAnimationClips, sprite.species, sprite.form);
+            if (!profile || profile->megaForm != sprite.form || !clip ||
+                sprite.textureIndex >= spritePlayback.size())
+                continue;
+            const bool front = (sprite.position & 1) != 0;
+            const auto& sequence = front ? clip->front : clip->back;
+            if (sequence.frames.empty()) continue;
+
+            auto& playback = spritePlayback[sprite.textureIndex];
+            const bool newClip = !playback.active || playback.species != sprite.species ||
+                                 playback.form != sprite.form || playback.front != front;
+            if (newClip)
+            {
+                playback = {sprite.species, sprite.form, front, true, {}};
+            }
+            const auto* frame = frameForTick(playback.cursor, sequence);
+
+            if (frame)
+            {
+                std::array<uint8_t, McssTextureSize> atlas{};
+                if (buildTextureAtlas(frame->pixels, PackedFrameBytes, atlas) &&
+                    !liveCore.GPU.WriteVRAMTexture(sprite.textureAddress, atlas.data(),
+                                                   uint32_t(atlas.size())))
+                    playback = {};
+            }
+            seen[sprite.textureIndex] = playback.active;
+        }
+        for (std::size_t index = 0; index < spritePlayback.size(); ++index)
+            if (!seen[index]) spritePlayback[index] = {};
+    }
