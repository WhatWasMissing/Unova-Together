+inline float EmulatorScaledVolume(int emulatorVolume) noexcept
+{
+    constexpr float MegaSoundGain = 0.12f;
+    const int scaled=std::clamp(emulatorVolume,0,256);
+    return MegaSoundGain*static_cast<float>(scaled)/256.0f;
+}
+
+class Player
+{
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+    QAudioOutput output;
+#endif
+    QMediaPlayer player;
+
+public:
+    Player()
+    {
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+        player.setAudioOutput(&output);
+        player.setSource(QUrl(QStringLiteral("qrc:/mega-sounds/mega-evolution.mp3")));
+#else
+        player.setMedia(QUrl(QStringLiteral("qrc:/mega-sounds/mega-evolution.mp3")));
+#endif
+    }
+
+    void play(int emulatorVolume)
+    {
+        const float volume=EmulatorScaledVolume(emulatorVolume);
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+        output.setVolume(volume);
+#else
+        player.setVolume(qRound(volume*100.0f));
+#endif
+        // Restart cleanly if two co-op partners Mega Evolve close together.
+        player.stop();
+        player.setPosition(0);
+        player.play();
+    }
+};
+
