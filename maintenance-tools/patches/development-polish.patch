+u32 LAN::CoopChallengeToken() const
+{
+    if(CoopChallengeStatus()!=1) return 0;
+    const u32 remoteNonce=coopWord(CoopRemote.data()+4);
+    const u32 firstNonce=std::min(CoopNonce,remoteNonce);
+    const u32 secondNonce=std::max(CoopNonce,remoteNonce);
+    u32 hash=2166136261u;
+    const auto add=[&](u8 value) {hash=(hash^value)*16777619u;};
+    for(unsigned shift=0;shift<32;shift+=8) add(u8(CoopLocal[0+(shift/8)]));
+    for(unsigned shift=0;shift<32;shift+=8) add(u8(firstNonce>>shift));
+    for(unsigned shift=0;shift<32;shift+=8) add(u8(secondNonce>>shift));
+    for(unsigned i=8;i<40;++i) add(CoopLocal[i]);
+    return hash ? hash : 1;
