+// The game's BtlClient::procMon is reassigned for each active battler while
+// action selection proceeds. Resolve an already-selected local Mega user from
+// its stable trainer/party slot instead of assuming procMon still points at it.
+inline std::optional<Selection> currentLocalTarget(
+    const uint8_t* data, std::size_t size, const Selection& controller,
+    const Selection& expected, bool allowMegaFormTransition = false)
+{
+    if (controller.clientId != expected.clientId) return std::nullopt;
+    const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(
+        expected.species, expected.stone);
+    if (!profile) return std::nullopt;
+    const Gen5MegaEvolution::Event event{1, 1, expected.clientId, expected.partySlot,
+        expected.species, expected.stone, profile->baseForm, profile->megaForm};
+    return targetForEvent(data, size, controller, event,
+                          allowMegaFormTransition, true);
+}
