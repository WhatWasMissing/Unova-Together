+QVariantMap NativeMegaRuntime::Impl::snapshot() const
+{
+    QVariantList postMegaTrace;
+    const auto traceStart = (postMegaTraceNext + this->postMegaTrace.size() -
+        postMegaTraceCount) % this->postMegaTrace.size();
+    postMegaTrace.reserve(int(postMegaTraceCount));
+    for (uint32_t index = 0; index < postMegaTraceCount; ++index)
+    {
+        const auto& entry = this->postMegaTrace[(traceStart + index) % this->postMegaTrace.size()];
+        postMegaTrace.append(QVariantMap{{"pc", entry.pc}, {"lr", entry.lr}, {"sp", entry.sp},
+            {"cpsr", entry.cpsr}, {"curInstr", entry.curInstr}, {"r0", entry.r0},
+            {"r1", entry.r1}, {"r2", entry.r2}, {"r3", entry.r3}});
+    }
+    QVariantList errorStack;
+    for (const auto value : fixtureErrorHandlerStack) errorStack.append(value);
+    QVariantList cpuStack;
+    if (core)
+        for (uint32_t index = 0; index < 32; ++index)
+        {
+            uint32_t value = 0;
+            core->ARM9.DataRead32(core->ARM9.R[13] + index * 4, &value);
+            cpuStack.append(value);
+        }
+    return {{"megaState", unsigned(call.GetState())},
+            {"megaBattleSerial", serial},
+            {"megaRemoteState", unsigned(remoteCall.GetState())}, {"megaStatus", status},
+            {"megaFormsAgreed", formsAgreed},
+            {"megaRecovered", localRecoveryAttempt.Recovered() || remoteRecoveryAttempt.Recovered()},
+            {"megaLocalRecoverySucceeded", localRecoveryAttempt.Recovered()},
+            {"megaPartnerRecoverySucceeded", remoteRecoveryAttempt.Recovered()},
+            {"megaBattleDataCaptured", battleData.captured},
+            {"megaBattleDataVerified", battleData.verified},
+            {"megaLegacyAbilityRepaired", legacyAbilityRepaired},
+            {"megaBeforeClientStats", QVariantList{beforeClientBattle.stats[0],
+                beforeClientBattle.stats[1], beforeClientBattle.stats[2],
+                beforeClientBattle.stats[3], beforeClientBattle.stats[4]}},
+            {"megaBeforeServerStats", QVariantList{beforeServerBattle.stats[0],
+                beforeServerBattle.stats[1], beforeServerBattle.stats[2],
+                beforeServerBattle.stats[3], beforeServerBattle.stats[4]}},
+            {"megaBeforeClientAbility", beforeClientBattle.ability},
+            {"megaBeforeServerAbility", beforeServerBattle.ability},
+            {"megaBeforeClientHP", beforeClientBattle.currentHP},
+            {"megaBeforeServerHP", beforeServerBattle.currentHP},
+            {"megaBeforeClientMaxHP", beforeClientBattle.maxHP},
+            {"megaBeforeServerMaxHP", beforeServerBattle.maxHP},
+            {"megaAfterClientStats", QVariantList{battleData.client.stats[0],
+                battleData.client.stats[1], battleData.client.stats[2],
+                battleData.client.stats[3], battleData.client.stats[4]}},
+            {"megaAfterServerStats", QVariantList{battleData.server.stats[0],
+                battleData.server.stats[1], battleData.server.stats[2],
+                battleData.server.stats[3], battleData.server.stats[4]}},
+            {"megaAfterAbility", battleData.client.ability},
+            {"megaAfterServerAbility", battleData.server.ability},
+            {"megaAfterClientHP", battleData.client.currentHP},
+            {"megaAfterServerHP", battleData.server.currentHP},
+            {"megaAfterClientMaxHP", battleData.client.maxHP},
+            {"megaAfterServerMaxHP", battleData.server.maxHP},
+            {"megaSourcesUnchanged", sourcesUnchanged},
+            {"megaFixtureDriving", fixtureDriving}, {"megaFixtureFrames", inputFrames},
+            {"megaFixtureInputAPressed", fixtureInputAPressed},
+            {"megaFixtureTouching", fixtureTouching},
+            {"megaFixtureAppliedA", fixtureAppliedA},
+            {"megaFixtureKeyInput", core ? core->KeyInput : 0xFFFFFFFFu},
+            {"megaGPUDisplayControl", core ? core->GPU.GPU2D_A.DispCnt : 0u},
+            {"megaGPUObj1DMapping", core &&
+                (core->GPU.GPU2D_A.DispCnt & 0x10) != 0},
+            {"megaFixtureLastMask", fixtureLastMask},
+            {"megaFixtureLastKeyInput", fixtureLastKeyInput},
+            {"megaActionEntryVisits", actionEntryVisits},
+            {"megaChangeFormDispatchVisits", changeFormDispatchVisits},
+            {"megaChangeFormCommandHandlerVisits", changeFormCommandHandlerVisits},
+            {"megaChangeFormFunctionVisits", changeFormFunctionVisits},
+            {"megaNativeRejectReason", call.LastRejectReason()},
+            {"megaVerifiedFormCopies", call.VerifiedFormCopies()},
+            {"megaBoundaryVisits", boundaryVisits}, {"megaLastBoundaryPC", lastBoundaryPC},
+            {"megaFirstLowPC", firstLowPC},
+            {"megaFirstLowPreviousPC", firstLowPreviousPC},
+            {"megaFirstLowRegisters", QVariantList{firstLowRegisters[0], firstLowRegisters[1],
+                firstLowRegisters[2], firstLowRegisters[3], firstLowRegisters[4],
+                firstLowRegisters[5], firstLowRegisters[6], firstLowRegisters[7],
+                firstLowRegisters[8], firstLowRegisters[9], firstLowRegisters[10],
+                firstLowRegisters[11], firstLowRegisters[12], firstLowRegisters[13],
+                firstLowRegisters[14], firstLowRegisters[15]}},
+            {"megaFirstLowCPSR", firstLowCPSR}, {"megaFirstLowCurInstr", firstLowCurInstr},
+            {"megaCPU_PC", core ? core->ARM9.R[15] : 0u},
+            {"megaCPU_LR", core ? core->ARM9.R[14] : 0u},
+            {"megaCPU_SP", core ? core->ARM9.R[13] : 0u},
+            {"megaCPU_CPSR", core ? core->ARM9.CPSR : 0u},
+            {"megaCPU_CurInstr", core ? core->ARM9.CurInstr : 0u},
+            {"megaCPU_Halted", core ? core->ARM9.Halted : 0u},
+            {"megaCPU_IRQ", core ? core->ARM9.IRQ : 0u},
+            {"megaCPU_ABT_LR", core ? core->ARM9.R_ABT[1] : 0u},
+            {"megaCPU_ABT_SPSR", core ? core->ARM9.R_ABT[2] : 0u},
+            {"megaCPU_UND_LR", core ? core->ARM9.R_UND[1] : 0u},
+            {"megaCPU_UND_SPSR", core ? core->ARM9.R_UND[2] : 0u},
+            {"megaCPU_IRQ_LR", core ? core->ARM9.R_IRQ[1] : 0u},
+            {"megaCPU_IRQ_SPSR", core ? core->ARM9.R_IRQ[2] : 0u},
+            {"megaCPU_BoundaryHookOwned", core &&
+                core->ARM9.BeforeBlockOrInstruction == &Impl::Boundary &&
+                core->ARM9.BoundaryHookData == this},
+            {"megaCPUStackWords", cpuStack},
+            {"megaARM7_PC", core ? core->ARM7.R[15] : 0u},
+            {"megaARM7_LR", core ? core->ARM7.R[14] : 0u},
+            {"megaARM7_SP", core ? core->ARM7.R[13] : 0u},
+            {"megaARM7_CPSR", core ? core->ARM7.CPSR : 0u},
+            {"megaARM7_CurInstr", core ? core->ARM7.CurInstr : 0u},
+            {"megaPostTransformTrace", postMegaTrace},
+            {"megaErrorHandlerEntered", fixtureErrorHandlerEntered},
+            {"megaErrorHandlerEntry", QVariantMap{{"pc", fixtureErrorHandlerEntry.pc},
+                {"lr", fixtureErrorHandlerEntry.lr}, {"sp", fixtureErrorHandlerEntry.sp},
+                {"cpsr", fixtureErrorHandlerEntry.cpsr},
+                {"curInstr", fixtureErrorHandlerEntry.curInstr},
+                {"r0", fixtureErrorHandlerEntry.r0}, {"r1", fixtureErrorHandlerEntry.r1},
+                {"r2", fixtureErrorHandlerEntry.r2}, {"r3", fixtureErrorHandlerEntry.r3}}},
+            {"megaErrorHandlerStack", errorStack},
+            {"megaFightSelectVisits", fightSelectVisits}, {"megaMoveInputVisits", moveInputVisits},
+            {"megaMatchingActionEntryVisits", matchingActionEntryVisits},
+            {"megaActionEntryR0", actionEntryR0}, {"megaActionEntryR1", actionEntryR1},
+            {"megaActionEntryCpsr", actionEntryCpsr}, {"megaActionEntryIrq", actionEntryIrq},
+            {"megaActionEntryCount", actionEntryCount},
+            {"megaActionEntryFirstType", actionEntryFirstType},
+            {"megaActionEntryFightCommitted", actionEntryFightCommitted},
+            {"megaClientSourceFirstDiff", clientSourceFirstDiff},
+            {"megaServerSourceFirstDiff", serverSourceFirstDiff},
+            {"megaClientSourceDiffBytes", QVariantList{clientSourceBeforeDiff, clientSourceAfterDiff}},
+            {"megaServerSourceDiffBytes", QVariantList{serverSourceBeforeDiff, serverSourceAfterDiff}},
+            {"megaClientSourceDiffs", clientSourceDiffs}, {"megaServerSourceDiffs", serverSourceDiffs},
+            {"megaNativeHandlerCompleted", nativeHandlerCompleted},
+            {"megaNativeHandlerResult", nativeHandlerResult},
+            {"megaPartyBase", partyBase}, {"megaSavedPartyRecord", savedPartyRecord},
+            {"megaClientSourceIsSavedParty", clientSourceIsSavedParty},
+            {"megaServerSourceIsSavedParty", serverSourceIsSavedParty},
+            {"megaSavedPartyUnchanged", savedPartyUnchanged},
+            {"megaBattleEnded", battleEnded},
+            {"megaActionTimeline", actionTimeline},
+            {"megaModule", module}, {"megaTrainer", call.Target().clientId},
+            {"megaPartySlot", call.Target().partySlot}};
+}
+QVariantMap NativeMegaRuntime::Snapshot() const
+{
+    return impl->endedDiagnostics.isEmpty() ? impl->snapshot() : impl->endedDiagnostics;
