+// Battle-only rules, independent of the ROM pointers used to reach the live
+// BattleMon. This model is deterministic and safe to serialize into a
+// cooperative battle event; it does not mutate a saved party record.
+class BattleSession
+{
+public:
+    bool begin(uint32_t battleId)
+    {
+        if (!battleId) return false;
+        // Re-observing an existing battle cannot reset its one-use flags, and
+        // replacing an active session must first restore/end the old battle.
+        if (active) return id == battleId;
+        id = battleId;
+        active = true;
+        used = {};
+        megaSlots = {};
+        return true;
+    }
+
+    Activation activate(Trainer trainer, uint8_t partySlot, uint16_t species,
+                        uint16_t heldItem, uint8_t currentForm, bool isActive)
+    {
+        Activation result;
+        const auto* profile = profileForSpeciesAndStone(species, heldItem);
+        if (!profile || !eligible(trainer, partySlot, species, heldItem, currentForm, isActive))
+            return result;
+        const auto trainerIndex = static_cast<unsigned>(trainer);
+        used[trainerIndex] = true;
+        megaSlots[trainerIndex][partySlot] = {species, currentForm, profile->megaForm, true};
+        result.result = Result::Accepted;
+        result.event = {id, 1, uint8_t(trainerIndex), partySlot, species,
+                        heldItem, currentForm, profile->megaForm};
+        return result;
+    }
+
+    Result receive(const Event& event)
+    {
+        const auto* profile = profileForSpeciesAndStone(event.species, event.stone);
+        if (!active || event.battleId != id || event.sequence != 1 ||
+            event.trainer > static_cast<uint8_t>(Trainer::OpponentPartner) ||
+            event.partySlot >= PartySlots || !profile ||
+            event.fromForm != profile->baseForm || event.toForm != profile->megaForm)
+            return Result::Rejected;
+
+        const auto trainerIndex = unsigned(event.trainer);
+        if (used[trainerIndex])
+        {
+            const auto& slot = megaSlots[trainerIndex][event.partySlot];
+            return slot.mega && slot.species == event.species &&
+                   slot.originalForm == event.fromForm && slot.currentForm == event.toForm
+                ? Result::Duplicate : Result::Rejected;
+        }
+
+        used[trainerIndex] = true;
+        megaSlots[trainerIndex][event.partySlot] =
+            {event.species, event.fromForm, event.toForm, true};
+        return Result::Accepted;
+    }
+
+    Result receive(const uint8_t* payload, std::size_t length)
+    {
+        const auto event = decodeEvent(payload, length);
+        return event ? receive(*event) : Result::Rejected;
+    }
+
+    uint8_t form(Trainer trainer, uint8_t partySlot, uint8_t baseForm = 0) const
+    {
+        const auto trainerIndex = static_cast<unsigned>(trainer);
+        if (!active || trainerIndex >= megaSlots.size() || partySlot >= PartySlots) return baseForm;
+        const auto& slot = megaSlots[trainerIndex][partySlot];
+        return slot.mega ? slot.currentForm : baseForm;
+    }
+
+    bool usedMega(Trainer trainer) const
+    {
+        const auto trainerIndex = static_cast<unsigned>(trainer);
+        return active && trainerIndex < used.size() && used[trainerIndex];
+    }
+
+    std::vector<Restoration> end()
+    {
+        std::vector<Restoration> restore;
+        if (active)
+            for (unsigned trainer = 0; trainer < megaSlots.size(); ++trainer)
+                for (unsigned slotIndex = 0; slotIndex < PartySlots; ++slotIndex)
+                {
+                    const auto& slot = megaSlots[trainer][slotIndex];
+                    if (slot.mega)
+                        restore.push_back({Trainer(trainer), uint8_t(slotIndex), slot.species,
+                                           slot.originalForm});
+                }
+        id = 0;
+        active = false;
+        used = {};
+        megaSlots = {};
+        return restore;
+    }
+
+private:
+    static constexpr unsigned PartySlots = 6;
+    struct Slot
+    {
+        uint16_t species = 0;
+        uint8_t originalForm = 0;
+        uint8_t currentForm = 0;
+        bool mega = false;
+    };
+
+    bool eligible(Trainer trainer, uint8_t partySlot, uint16_t species,
+                  uint16_t heldItem, uint8_t currentForm, bool isActive) const
+    {
+        const auto trainerIndex = static_cast<unsigned>(trainer);
+        const auto* profile = profileForSpeciesAndStone(species, heldItem);
+        return active && isActive && trainerIndex < used.size() && partySlot < PartySlots &&
+               !used[trainerIndex] && profile &&
+               currentForm == profile->baseForm;
+    }
+
+    uint32_t id = 0;
+    bool active = false;
+    std::array<bool, 4> used{};
+    std::array<std::array<Slot, PartySlots>, 4> megaSlots{};
+};
+
+inline std::vector<std::vector<uint16_t>> messageCodes(Gen5ShopPolicy::Bytes table)
+{
+    table.need(0, 16);
+    if (table.half(0) != 1) throw std::runtime_error("Unsupported Gen V message table");
+    const auto count = table.half(2);
+    const auto base = table.word(12);
+    if (!count || count > 8192 || base < 16 || base > table.length)
+        throw std::runtime_error("Invalid Gen V message table bounds");
+    const auto recordsEnd = std::size_t(base) + 4 + std::size_t(count) * 8;
+    table.need(base, 4 + std::size_t(count) * 8);
+
+    std::vector<std::vector<uint16_t>> messages;
+    messages.reserve(count);
+    for (unsigned id = 0; id < count; ++id)
+    {
+        const auto record = std::size_t(base) + 4 + id * 8;
+        const auto relative = table.word(record);
+        const auto words = table.half(record + 4);
+        const auto start = std::size_t(base) + relative;
+        if (!words || words > 4096 || start < recordsEnd ||
+            start > table.length || std::size_t(words) * 2 > table.length - start)
+            throw std::runtime_error("Invalid Gen V message entry");
+
+        auto key = (31881u + id * 0x2983u) & 0xFFFFu;
+        std::vector<uint16_t> decoded;
+        decoded.reserve(words);
+        bool terminated = false;
+        for (unsigned word = 0; word < words; ++word)
+        {
+            const auto value = uint16_t(table.half(start + word * 2) ^ key);
+            key = ((key << 3) | (key >> 13)) & 0xFFFFu;
+            decoded.push_back(value);
+            if (value == 0xFFFF) { terminated = true; break; }
+        }
+        if (!terminated) throw std::runtime_error("Unterminated Gen V message");
+        messages.push_back(std::move(decoded));
+    }
+    return messages;
+}
+
+inline std::vector<uint8_t> packMessages(Gen5ShopPolicy::Bytes original,
+                                         const std::vector<std::vector<uint16_t>>& messages)
+{
+    const auto base = original.word(12);
+    const auto expectedCount = original.half(2);
+    if (messages.size() != expectedCount) throw std::runtime_error("Gen V message count changed");
+    const auto recordsEnd = std::size_t(base) + 4 + messages.size() * 8;
+    original.need(0, recordsEnd);
+    std::vector<uint8_t> packed(original.data, original.data + recordsEnd);
+    while (packed.size() % 4) packed.push_back(0);
+
+    for (unsigned id = 0; id < messages.size(); ++id)
+    {
+        const auto& codes = messages[id];
+        if (codes.empty() || codes.size() > 4096 || codes.back() != 0xFFFF)
+            throw std::runtime_error("Invalid Gen V message replacement");
+        const auto record = std::size_t(base) + 4 + id * 8;
+        const auto relative = packed.size() - base;
+        if (relative > 0xFFFFFFFFu) throw std::runtime_error("Gen V message table too large");
+        Gen5ShopPolicy::word(packed, record, uint32_t(relative));
+        Gen5ShopPolicy::half(packed, record + 4, unsigned(codes.size()));
+
+        auto key = (31881u + id * 0x2983u) & 0xFFFFu;
+        for (const auto code : codes)
+        {
+            const auto encrypted = uint16_t(code ^ key);
+            const auto offset = packed.size();
+            packed.resize(offset + 2);
+            Gen5ShopPolicy::half(packed, offset, encrypted);
+            key = ((key << 3) | (key >> 13)) & 0xFFFFu;
+        }
+    }
+
+    if (packed.size() < 16 || packed.size() - 16 > 0xFFFFFFFFu)
+        throw std::runtime_error("Gen V message table is too large");
+    Gen5ShopPolicy::word(packed, 4, uint32_t(packed.size() - 16));
+    return packed;
+}
+
+inline void replaceAsciiMessage(std::vector<std::vector<uint16_t>>& messages,
+                                unsigned id, std::string_view firstLine,
+                                std::string_view secondLine = {})
+{
+    if (id >= messages.size()) throw std::runtime_error("Gen V message id is out of range");
+    std::vector<uint16_t> codes;
+    codes.reserve(firstLine.size() + secondLine.size() + 2);
+    for (const auto character : firstLine)
+    {
+        if (static_cast<unsigned char>(character) > 0x7F)
+            throw std::runtime_error("Mega item text must be ASCII");
+        codes.push_back(uint8_t(character));
+    }
+    if (!secondLine.empty())
+    {
+        codes.push_back(0xFFFE);
+        for (const auto character : secondLine)
+        {
+            if (static_cast<unsigned char>(character) > 0x7F)
+                throw std::runtime_error("Mega item text must be ASCII");
+            codes.push_back(uint8_t(character));
+        }
+    }
+    codes.push_back(0xFFFF);
+    messages[id] = std::move(codes);
+}
+
+inline void nameMegaStone(std::vector<std::vector<uint16_t>>& names,
+                          unsigned destinationId, unsigned templateId,
+                          std::string_view stoneName)
+{
+    if (destinationId >= names.size() || templateId >= names.size())
+        throw std::runtime_error("Mega stone name id is out of range");
+    if (names[destinationId] != std::vector<uint16_t>{'?', '?', '?', 0xFFFF})
+        throw std::runtime_error("Mega stone destination is not a reserved blank item name");
+    const std::u16string_view oldName = u"Griseous Orb";
+    std::vector<uint16_t> needle(oldName.begin(), oldName.end());
+    const auto& source = names[templateId];
+    if (source.size() <= needle.size() || source.back() != 0xFFFF)
+        throw std::runtime_error("Mega stone name template is malformed");
+    const auto found = std::search(source.begin(), source.end() - 1,
+                                   needle.begin(), needle.end());
+    if (found == source.end() - 1)
+        throw std::runtime_error("Mega stone name template does not match Redux text");
+
+    std::vector<uint16_t> replacement(source.begin(), found);
+    for (const auto character : stoneName)
+        replacement.push_back(uint8_t(character));
+    replacement.push_back(0xFFFF);
+    names[destinationId] = std::move(replacement);
+}
+
+inline void overwriteMegaStoneName(std::vector<std::vector<uint16_t>>& names,
+                                   unsigned destinationId, unsigned templateId,
+                                   std::string_view stoneName)
+{
+    if (destinationId >= names.size() || names[destinationId].empty() ||
+        names[destinationId].back() != 0xFFFF)
+        throw std::runtime_error("Mega stone item name record is malformed");
+    const std::u16string_view oldName = u"Griseous Orb";
+    const std::vector<uint16_t> needle(oldName.begin(), oldName.end());
+    const auto& source = names[templateId];
+    if (source.size() <= needle.size() || source.back() != 0xFFFF)
+        throw std::runtime_error("Mega stone name template is malformed");
+    const auto found = std::search(source.begin(), source.end() - 1,
+                                   needle.begin(), needle.end());
+    if (found == source.end() - 1)
+        throw std::runtime_error("Mega stone name template does not match Redux text");
+    std::vector<uint16_t> replacement(source.begin(), found);
+    for (const auto character : stoneName)
+    {
+        if (static_cast<unsigned char>(character) > 0x7F)
+            throw std::runtime_error("Mega stone names must be ASCII");
+        replacement.push_back(uint8_t(character));
+    }
+    replacement.push_back(0xFFFF);
+    names[destinationId] = std::move(replacement);
+}
+
+inline bool reservedMegaStoneRecord(const std::vector<uint8_t>& item)
+{
+    if (item.size() != 36) return false;
+    for (std::size_t i = 0; i < item.size(); ++i)
+        if (item[i] != 0 && !(i == 13 && item[i] == 2)) return false;
+    return true;
+}
