+inline bool appendMegaPersonalForms(Gen5ShopPolicy::Narc& personal)
+{
+    if (personal.files.size() != 710) return false;
+    for (const auto& profile : SupportedProfiles)
+    {
+        if (profile.species >= personal.files.size()) return false;
+        const auto& base = personal.files[profile.species];
+        const auto view = Gen5ShopPolicy::Bytes{base.data(), base.size()};
+        if (base.size() != PersonalRecordSize ||
+            !std::equal(profile.baseStats.begin(), profile.baseStats.end(), base.begin()) ||
+            base[6] != profile.baseType1 || base[7] != profile.baseType2 ||
+            base[PersonalAbility1Offset] != profile.baseAbility1 ||
+            base[PersonalAbility2Offset] != profile.baseAbility2 ||
+            base[PersonalAbilityHOffset] != profile.baseAbilityH ||
+            view.half(PersonalFormSpriteOffset) != 0 || base[PersonalFormCountOffset] != 1 ||
+            view.half(PersonalFormStartOffset) != 0)
+            return false;
+    }
+    if (personal.files.size() + SupportedProfiles.size() > 0xFFFF) return false;
+
+    for (const auto& profile : SupportedProfiles)
+    {
+        auto& base = personal.files[profile.species];
+        const auto formIndex = megaPersonalFormIndex(profile.species, profile.megaForm);
+        if (!formIndex || *formIndex != personal.files.size()) return false;
+        auto mega = base;
+        for (unsigned stat = 0; stat < profile.stats.size(); ++stat)
+            mega[stat] = profile.stats[stat];
+        mega[6] = profile.type1;
+        mega[7] = profile.type2;
+        mega[PersonalAbility1Offset] = profile.ability1;
+        mega[PersonalAbility2Offset] = profile.ability2;
+        mega[PersonalAbilityHOffset] = profile.abilityH;
+        const bool firstMegaFormForSpecies = profile.megaForm == 1;
+        if (firstMegaFormForSpecies)
+        {
+            Gen5ShopPolicy::half(base, PersonalFormStartOffset, *formIndex);
+            // FormSprite is a relative alternate-form sprite ID. The base
+            // record points at form 1; later forms use consecutive IDs.
+            Gen5ShopPolicy::half(base, PersonalFormSpriteOffset, profile.spriteId);
+        }
+        base[PersonalFormCountOffset] = std::max<uint8_t>(
+            base[PersonalFormCountOffset], uint8_t(profile.megaForm + 1));
+        personal.files.push_back(std::move(mega));
+    }
+    return true;
+}
+
+inline bool appendMegaLevelUpLearnsets(Gen5ShopPolicy::Narc& learnsets,
+                                       std::string* diagnostic = nullptr)
+{
+    if (diagnostic) diagnostic->clear();
+    const auto reject = [diagnostic](const char* reason) {
+        if (diagnostic) *diagnostic = reason;
+        return false;
+    };
+    if (learnsets.files.size() != LevelUpLearnsetArchiveOriginalMembers)
+        return reject("Unexpected level-up learnset archive member count");
+
+    std::vector<std::vector<uint8_t>> appended;
+    appended.reserve(SupportedProfiles.size());
+    for (std::size_t i = 0; i < SupportedProfiles.size(); ++i)
+    {
+        const auto& profile = SupportedProfiles[i];
+        const auto formIndex = megaPersonalFormIndex(profile.species, profile.megaForm);
+        if (!formIndex || *formIndex != learnsets.files.size() + i ||
+            profile.species >= LevelUpLearnsetArchiveOriginalMembers)
+            return reject("Mega personal and learnset form indices do not align");
+
+        const auto& baseLearnset = learnsets.files[profile.species];
+        // Learnset entries are four bytes and terminate with the native
+        // 0xFFFFFFFF marker. Copy the base species list to every Mega form;
+        // leveling must still offer the species' ordinary level-up moves.
+        if (baseLearnset.size() < 4 || baseLearnset.size() % 4 != 0 ||
+            !std::all_of(baseLearnset.end() - 4, baseLearnset.end(),
+                         [](uint8_t byte) { return byte == 0xFF; }))
+            return reject("Base species level-up learnset is malformed");
+        appended.push_back(baseLearnset);
+    }
+
+    learnsets.files.reserve(learnsets.files.size() + appended.size());
+    for (auto& entry : appended) learnsets.files.push_back(std::move(entry));
+    return true;
+}
+
+// The shipped Redux learnset NARC has a valid BTAF table whose final ranges
+// extend past the stale GMIF/overall-size fields. BW2's archive reader follows
+// those ranges through the full FAT file length. Read it the same way before
+// repacking it into a canonical NARC with the appended Mega form members.
+inline Gen5ShopPolicy::Narc parseMegaLevelUpLearnsetArchive(Gen5ShopPolicy::Bytes raw)
+{
+    using Gen5ShopPolicy::Bytes;
+    if (!raw.magic(0, "NARC") || raw.half(4) != 0xFFFE ||
+        raw.half(12) != 16 || raw.half(14) != 3)
+        throw std::runtime_error("Unsupported Mega level-up learnset archive header");
+
+    Gen5ShopPolicy::Narc result;
+    result.header = raw.slice(0, 16).copy();
+    Bytes allocations{nullptr, 0};
+    Bytes names{nullptr, 0};
+    std::size_t payloadOffset = 0;
+    std::size_t pos = 16;
+    for (unsigned section = 0; section < 3; ++section)
+    {
+        raw.need(pos, 8);
+        const auto size = raw.word(pos + 4);
+        if (size < 8) throw std::runtime_error("Invalid Mega learnset NARC section size");
+        const auto block = raw.slice(pos, size);
+        if (block.magic(0, "BTAF"))
+        {
+            if (allocations.data) throw std::runtime_error("Duplicate Mega learnset BTAF section");
+            allocations = block;
+        }
+        else if (block.magic(0, "BTNF"))
+        {
+            if (names.data) throw std::runtime_error("Duplicate Mega learnset BTNF section");
+            names = block;
+        }
+        else if (block.magic(0, "GMIF"))
+        {
+            if (payloadOffset) throw std::runtime_error("Duplicate Mega learnset GMIF section");
+            payloadOffset = pos + 8;
+        }
+        pos += size;
+    }
+    if (!allocations.data || !names.data || !payloadOffset ||
+        allocations.half(8) != LevelUpLearnsetArchiveOriginalMembers ||
+        12 + std::size_t(allocations.half(8)) * 8 > allocations.length)
+        throw std::runtime_error("Incomplete Mega level-up learnset archive");
+
+    result.names = names.copy();
+    result.files.reserve(allocations.half(8));
+    result.offsets.reserve(allocations.half(8));
+    for (unsigned member = 0; member < allocations.half(8); ++member)
+    {
+        const auto start = allocations.word(12 + member * 8);
+        const auto end = allocations.word(16 + member * 8);
+        if (end < start || end > raw.length - payloadOffset)
+            throw std::runtime_error("Mega learnset BTAF range is outside the cartridge file");
+        result.files.push_back(raw.slice(payloadOffset + start, end - start).copy());
+        result.offsets.push_back(uint32_t(payloadOffset + start));
+    }
+    return result;
+}
+
+// Add a 20-resource Pokegra block without shifting the ROM's five existing
+// trailing members. The extra 15 members complete the unused block 753.
+template<std::size_t ArtworkCount = DraftProfiles.size(),
+         std::size_t AnimationCount = ArtworkCount>
+inline bool appendMegaSpriteBlocks(
+    Gen5ShopPolicy::Narc& pokegra,
+    const std::array<Gen5MegaSprite::Art, ArtworkCount>* artwork = nullptr,
+    std::string* diagnostic = nullptr,
+    const std::array<const Gen5MegaSprite::Animation*, AnimationCount>* animations = nullptr)
+{
+    if (diagnostic) diagnostic->clear();
+    if (pokegra.files.size() != PokegraOriginalMemberCount ||
+        PokegraMegaPaddingCount != 15 || PokegraMegaBlockStart != 15080 ||
+        pokegra.files.size() < 710 * PokegraBlockMembers ||
+        (artwork && artwork->size() < SupportedProfiles.size()) ||
+        (animations && animations->size() < SupportedProfiles.size()))
+    {
+        if (diagnostic) *diagnostic = "Unexpected Pokegra NARC member count or Mega block boundary";
+        return false;
+    }
+    for (std::size_t index = 0; index < SupportedProfiles.size(); ++index)
+    {
+        const auto& profile = SupportedProfiles[index];
+        if (profile.spriteId != SerperiorMegaSpriteId + index) return false;
+        const auto source = std::size_t(profile.species) * PokegraBlockMembers;
+        for (unsigned member : {0u,2u,4u,5u,9u,11u,13u,14u,18u,19u})
+            if (pokegra.files[source + member].empty())
+            {
+                if (diagnostic) *diagnostic = "Base form is missing a required Pokegra resource";
+                return false;
+            }
+    }
+    pokegra.files.resize(PokegraMegaBlockStart);
+    for (std::size_t profileIndex = 0; profileIndex < SupportedProfiles.size(); ++profileIndex)
+    {
+        const auto& profile = SupportedProfiles[profileIndex];
+        const auto source = std::size_t(profile.species) * PokegraBlockMembers;
+        for (unsigned member = 0; member < PokegraBlockMembers; ++member)
+            pokegra.files.push_back(pokegra.files[source + member]);
+        if (artwork)
+        {
+            if ((*artwork)[profileIndex].species != profile.species)
+            {
+                if (diagnostic) *diagnostic = "Mega art species does not match its profile";
+                return false;
+            }
+            const auto destination = PokegraMegaBlockStart + profileIndex * PokegraBlockMembers;
+            std::vector<std::vector<uint8_t>> baseBlock(
+                pokegra.files.begin() + source, pokegra.files.begin() + source + PokegraBlockMembers);
+            if (!Gen5MegaSprite::install(baseBlock, pokegra.files, destination,
+                                         (*artwork)[profileIndex], diagnostic,
+                                         animations ? (*animations)[profileIndex] : nullptr))
+                return false;
+        }
+    }
+    const bool complete = pokegra.files.size() == PokegraMegaBlockStart +
+                                                    SupportedProfiles.size() * PokegraBlockMembers;
+    if (!complete && diagnostic) *diagnostic = "Mega Pokegra block has an unexpected final length";
+    return complete;
+}
+
+inline std::size_t highestAllocatedEnd(Gen5ShopPolicy::Bytes rom)
+{
+    rom.need(0x80, 4);
+    const auto fat = rom.slice(rom.word(0x48), rom.word(0x4C));
+    if (fat.length % 8) throw std::runtime_error("Invalid Mega Evolution FAT");
+    std::size_t end = rom.word(0x80);
+    end = std::max<std::size_t>(end, std::size_t(rom.word(0x20)) + rom.word(0x2C));
+    end = std::max<std::size_t>(end, std::size_t(rom.word(0x30)) + rom.word(0x3C));
+    for (std::size_t offset = 0; offset < fat.length; offset += 8)
+        end = std::max<std::size_t>(end, fat.word(offset + 4));
+    if (end > rom.length) throw std::runtime_error("ROM allocations exceed file length");
+    return end;
+}
+
+inline std::size_t findFreeRange(Gen5ShopPolicy::Bytes rom, std::size_t minimum,
+                                 std::size_t size,
+                                 const std::vector<melonDS::ROMAssetPatch>& reserved)
+{
+    if (!size || size > rom.length || rom.length < 512 || minimum > rom.length - 512)
+        throw std::runtime_error("No free ROM space for Mega Evolution data");
+    const auto limit = rom.length - 512;
+    const auto align = [](std::size_t value) {
+        if (value > std::numeric_limits<std::size_t>::max() - 3)
+            return std::numeric_limits<std::size_t>::max();
+        return (value + 3) & ~std::size_t(3);
+    };
+    auto candidate = align(minimum);
+    while (candidate <= limit && size <= limit - candidate)
+    {
+        bool reservedOverlap = false;
+        for (const auto& patch : reserved)
+        {
+            const uint64_t patchStart = patch.offset;
+            const uint64_t patchEnd = patchStart + patch.bytes.size();
+            if (patchStart < uint64_t(candidate) + size && patchEnd > candidate)
+            {
+                if (patchEnd > limit)
+                    throw std::runtime_error("Reserved ROM data exceeds free cartridge padding");
+                candidate = align(std::size_t(patchEnd));
+                reservedOverlap = true;
+                break;
+            }
+        }
+        if (reservedOverlap) continue;
+
+        std::size_t occupied = candidate + size;
+        for (std::size_t offset = candidate; offset < candidate + size; ++offset)
+            if (rom.byte(offset) != 0xFF) { occupied = offset; break; }
+        if (occupied == candidate + size) return candidate;
+        candidate = align(occupied + 1);
+    }
+    throw std::runtime_error("No verified unallocated ROM padding for Mega Evolution data");
+}
+
+inline void appendRelocatedFile(std::vector<melonDS::ROMAssetPatch>& patches,
+                                Gen5ShopPolicy::Bytes rom,
+                                const Gen5ShopPolicy::File& source,
+                                std::vector<uint8_t> replacement)
+{
+    const auto start = findFreeRange(rom, highestAllocatedEnd(rom), replacement.size(), patches);
+    if (start > 0xFFFFFFFFu || replacement.size() > 0xFFFFFFFFu - start)
+        throw std::runtime_error("Mega Evolution archive exceeds NDS address space");
+    std::vector<uint8_t> fatEntry(8);
+    Gen5ShopPolicy::word(fatEntry, 0, uint32_t(start));
+    Gen5ShopPolicy::word(fatEntry, 4, uint32_t(start + replacement.size()));
+    patches.push_back({source.fat, std::move(fatEntry)});
+    patches.push_back({uint32_t(start), std::move(replacement)});
+}
+
+inline uint32_t shopOverlayCrc32(const uint8_t* data, std::size_t length)
+{
+    uint32_t crc = 0xFFFFFFFF;
+    for (std::size_t i = 0; i < length; ++i)
+    {
+        crc ^= data[i];
+        for (unsigned bit = 0; bit < 8; ++bit)
+            crc = (crc >> 1) ^ ((crc & 1) ? 0xEDB88320u : 0u);
+    }
+    return ~crc;
+}
+
+inline bool decompressShopCodeOverlay(Gen5ShopPolicy::Bytes compressed,
+                                      std::vector<uint8_t>& output)
+{
+    // ARM9 overlays use Nitro's reverse code-compression format, whose footer
+    // gives the compressed stream length and the uncompressed tail size.
+    if (compressed.length < 8) return false;
+    std::size_t appended = 0;
+    unsigned headerLength = 0;
+    uint32_t compressedLength = 0;
+    uint32_t extraSize = 0;
+    bool foundHeader = false;
+    for (std::size_t tail = 0; tail < 0x20 && tail + 8 <= compressed.length; tail += 4)
+    {
+        const auto footer = compressed.length - tail - 8;
+        const auto packed = compressed.word(footer);
+        const auto candidateHeaderLength = packed >> 24;
+        const auto candidateCompressedLength = packed & 0x00FFFFFFu;
+        if (candidateHeaderLength < 8 || candidateCompressedLength > compressed.length - tail)
+            continue;
+        const auto candidateHeaderAt = compressed.length - tail - candidateHeaderLength;
+        bool validPadding = true;
+        for (std::size_t i = candidateHeaderAt; i < footer; ++i)
+            validPadding &= compressed.byte(i) == 0xFF;
+        if (!validPadding) continue;
+        appended = tail;
+        headerLength = candidateHeaderLength;
+        compressedLength = candidateCompressedLength;
+        extraSize = compressed.word(footer + 4);
+        foundHeader = true;
+        break;
+    }
+    if (!foundHeader) return false;
+
+    const auto dataLength = compressed.length - appended;
+    if (dataLength < compressedLength || compressedLength < headerLength) return false;
+    const auto passthroughLength = dataLength - compressedLength;
+    const auto compressedDataStart = passthroughLength;
+    const auto compressedDataLength = compressedLength - headerLength;
+    const auto decompLength = dataLength + extraSize - passthroughLength;
+    if (!decompLength || decompLength > Gen5ShopOverlayPatch::TargetOverlaySize ||
+        compressedDataStart + compressedDataLength > dataLength - headerLength)
+        return false;
+
+    const auto compressedData = compressed.slice(compressedDataStart, compressedDataLength);
+    output.assign(decompLength, 0);
+    std::size_t currentOutSize = 0;
+    std::size_t readBytes = 0;
+    unsigned flags = 0;
+    unsigned mask = 1;
+    while (currentOutSize < decompLength)
+    {
+        if (mask == 1)
+        {
+            if (readBytes >= compressedData.length) return false;
+            flags = compressedData.byte(compressedData.length - 1 - readBytes++);
+            mask = 0x80;
+        }
+        else
+            mask >>= 1;
+
+        if (flags & mask)
+        {
+            if (readBytes + 1 >= compressedData.length) return false;
+            const auto first = compressedData.byte(compressedData.length - 1 - readBytes++);
+            const auto second = compressedData.byte(compressedData.length - 1 - readBytes++);
+            const auto count = (first >> 4) + 3;
+            auto distance = (((first & 0x0Fu) << 8) | second) + 3;
+            if (distance > currentOutSize)
+            {
+                if (currentOutSize < 2) return false;
+                distance = 2;
+            }
+            if (count > decompLength - currentOutSize) return false;
+            auto sourceAt = currentOutSize - distance;
+            for (unsigned i = 0; i < count; ++i)
+                output[decompLength - 1 - currentOutSize++] =
+                    output[decompLength - 1 - sourceAt++];
+        }
+        else
+        {
+            if (readBytes >= compressedData.length) return false;
+            output[decompLength - 1 - currentOutSize++] =
+                compressedData.byte(compressedData.length - 1 - readBytes++);
+        }
+    }
+    output.insert(output.begin(), compressed.data, compressed.data + passthroughLength);
+    if (appended)
+        output.insert(output.end(), compressed.data + dataLength,
+                      compressed.data + compressed.length);
+    return output.size() == Gen5ShopOverlayPatch::SourceOverlaySize;
+}
+
+inline bool appendHeapBackedShopOverlay(
+    std::vector<melonDS::ROMAssetPatch>& patches, Gen5ShopPolicy::Bytes rom)
+{
+    using namespace Gen5ShopOverlayPatch;
+    constexpr unsigned OverlayId = 36;
+    constexpr uint32_t ExpectedRamAddress = 0x0217F600;
+    constexpr uint32_t ExpectedBssSize = 0x00010040;
+    constexpr uint32_t ExpectedCompressedSize = 0x0003E960;
+    constexpr uint32_t ExpectedOverlayFlags = 3;
+
+    const auto tableStart = rom.word(0x50);
+    const auto tableSize = rom.word(0x54);
+    if (tableSize % 32 || tableSize / 32 <= OverlayId) return false;
+    const auto tableEntryOffset = std::size_t(tableStart) + OverlayId * 32;
+    auto entry = rom.slice(tableEntryOffset, 32).copy();
+    if (Gen5ShopPolicy::Bytes{entry.data(), entry.size()}.word(0) != OverlayId ||
+        Gen5ShopPolicy::Bytes{entry.data(), entry.size()}.word(4) != ExpectedRamAddress ||
+        Gen5ShopPolicy::Bytes{entry.data(), entry.size()}.word(8) != SourceOverlaySize ||
+        Gen5ShopPolicy::Bytes{entry.data(), entry.size()}.word(12) != ExpectedBssSize ||
+        Gen5ShopPolicy::Bytes{entry.data(), entry.size()}.word(24) >=
+            rom.word(0x4C) / 8 ||
+        (Gen5ShopPolicy::Bytes{entry.data(), entry.size()}.word(28) & 0x00FFFFFFu) !=
+            ExpectedCompressedSize ||
+        (Gen5ShopPolicy::Bytes{entry.data(), entry.size()}.word(28) >> 24) !=
+            ExpectedOverlayFlags)
+        return false;
+
+    const auto fileId = Gen5ShopPolicy::Bytes{entry.data(), entry.size()}.word(24);
+    const auto fatOffset = std::size_t(rom.word(0x48)) + std::size_t(fileId) * 8;
+    const auto oldStart = rom.word(fatOffset);
+    const auto oldEnd = rom.word(fatOffset + 4);
+    if (oldEnd < oldStart || oldEnd - oldStart != ExpectedCompressedSize) return false;
+    const auto compressed = rom.slice(oldStart, oldEnd - oldStart);
+
+    std::vector<uint8_t> rebuilt;
+    if (!decompressShopCodeOverlay(compressed, rebuilt) ||
+        rebuilt.size() != SourceOverlaySize ||
+        shopOverlayCrc32(rebuilt.data(), rebuilt.size()) != SourceOverlayCrc32)
+        return false;
+    rebuilt.resize(TargetOverlaySize, 0);
+
+    std::size_t cursor = 0;
+    for (uint32_t run = 0; run < DeltaRunCount; ++run)
+    {
+        if (EncodedDelta.size() - cursor < 5) return false;
+        const auto offset = std::size_t(EncodedDelta[cursor]) |
+                            (std::size_t(EncodedDelta[cursor + 1]) << 8) |
+                            (std::size_t(EncodedDelta[cursor + 2]) << 16);
+        const auto count = std::size_t(EncodedDelta[cursor + 3]) |
+                           (std::size_t(EncodedDelta[cursor + 4]) << 8);
+        cursor += 5;
+        if (!count || offset > rebuilt.size() || count > rebuilt.size() - offset ||
+            count > EncodedDelta.size() - cursor)
+            return false;
+        std::memcpy(rebuilt.data() + offset, EncodedDelta.data() + cursor, count);
+        cursor += count;
+    }
+    if (cursor != EncodedDelta.size() ||
+        shopOverlayCrc32(rebuilt.data(), rebuilt.size()) != TargetOverlayCrc32)
+        return false;
+
+    auto replacement = std::move(rebuilt);
+    const auto start = findFreeRange(rom, highestAllocatedEnd(rom), replacement.size(), patches);
+    if (start > 0xFFFFFFFFu || replacement.size() > 0xFFFFFFFFu - start) return false;
+    std::vector<uint8_t> fatEntry(8);
+    Gen5ShopPolicy::word(fatEntry, 0, uint32_t(start));
+    Gen5ShopPolicy::word(fatEntry, 4, uint32_t(start + replacement.size()));
+    patches.push_back({uint32_t(fatOffset), std::move(fatEntry)});
+    patches.push_back({uint32_t(start), std::move(replacement)});
+    Gen5ShopPolicy::word(entry, 8, TargetOverlaySize);
+    // An uncompressed ARM9 overlay is valid and avoids carrying a second
+    // compressor in the launcher. It is only about 96 KiB larger than the
+    // original compressed game overlay.
+    Gen5ShopPolicy::word(entry, 28, TargetOverlaySize);
+    patches.push_back({uint32_t(tableEntryOffset), std::move(entry)});
+    return true;
+}
+
+inline uint16_t headerCRC16(const uint8_t* data, std::size_t length)
+{
+    uint16_t crc = 0xFFFF;
+    for (std::size_t i = 0; i < length; ++i)
+    {
+        crc ^= data[i];
+        for (unsigned bit = 0; bit < 8; ++bit)
+            crc = uint16_t((crc >> 1) ^ ((crc & 1) ? 0xA001 : 0));
+    }
+    return crc;
+}
+
+// Nitro's filesystem rejects normal card reads at/above DSiRegionStart, even
+// when the emulator is running a DS-only dump. Keep the normal region and used
+// size in sync with relocated archives. Never overwrite a real DSi partition.
+inline void appendExtendedHeader(std::vector<melonDS::ROMAssetPatch>& patches,
+                                  Gen5ShopPolicy::Bytes rom)
+{
+    rom.need(0, 0x160);
+    auto end = std::size_t(rom.word(0x80));
+    for (const auto& patch : patches)
+        end = std::max(end, std::size_t(patch.offset) + patch.bytes.size());
+    if (end > rom.length || end > 0xFFFFFFFFu)
+        throw std::runtime_error("Extended Mega ROM boundary exceeds cartridge capacity");
+    if (end <= rom.word(0x80)) return;
+    std::vector<melonDS::ROMAssetPatch> additions;
+    std::vector<uint8_t> header(rom.data, rom.data + 0x160);
+    Gen5ShopPolicy::word(header, 0x80, uint32_t(end));
+    additions.push_back({0x80, {header.begin() + 0x80, header.begin() + 0x84}});
+    if ((rom.byte(0x12) & 2) && end > (std::size_t(rom.half(0x92)) << 19))
+    {
+        // Match the cartridge loader's DS-only Redux detection. A genuine
+        // region-enabled DSi dump requires a different allocation strategy.
+        if (rom.word(0x1B0) != 0)
+            throw std::runtime_error("Mega archives would overlap the DSi partition");
+        const auto normalRegionEnd = (end + 0x7FFFF) >> 19;
+        Gen5ShopPolicy::half(header, 0x90, unsigned(normalRegionEnd));
+        Gen5ShopPolicy::half(header, 0x92, unsigned(normalRegionEnd));
+        additions.push_back({0x90, {header.begin() + 0x90, header.begin() + 0x94}});
+    }
+    std::vector<uint8_t> crc(2);
+    Gen5ShopPolicy::half(crc, 0, headerCRC16(header.data(), 0x15E));
+    additions.push_back({0x15E, std::move(crc)});
+    for (auto& patch : additions) patches.push_back(std::move(patch));
+}
+
+inline std::vector<melonDS::ROMAssetPatch> patches(const uint8_t* data, std::size_t length,
+                                                   bool installArtwork = true)
+{
+    std::array<uint16_t, SupportedProfiles.size()> megaStoneIds{};
+    for (std::size_t i = 0; i < SupportedProfiles.size(); ++i)
+        megaStoneIds[i] = SupportedProfiles[i].stone;
+    std::array<uint16_t, AllMegaStoneItemCount> allStoneItemIds{};
+    std::array<uint8_t, AllMegaStoneItemCount> iconProfileIndices{};
+    for (std::size_t i = 0; i < SupportedProfiles.size(); ++i)
+    {
+        allStoneItemIds[i] = SupportedProfiles[i].stone;
+        iconProfileIndices[i] = uint8_t(i);
+    }
+    for (std::size_t i = 0; i < LegacyStoneAliases.size(); ++i)
+    {
+        const auto& alias = LegacyStoneAliases[i];
+        const auto* profile = profileForSpeciesForm(alias.species, alias.form);
+        if (!profile) return {};
+        allStoneItemIds[SupportedProfiles.size() + i] = alias.stone;
+        iconProfileIndices[SupportedProfiles.size() + i] = uint8_t(
+            std::distance(SupportedProfiles.begin(),
+                std::find_if(SupportedProfiles.begin(), SupportedProfiles.end(),
+                    [profile](const MegaProfile& candidate) { return &candidate == profile; })));
+    }
+    // Keep a conservative non-Mega fallback. The full Mega shop stock is only
+    // exposed when its matching heap-backed native shop overlay is installed.
+    auto result = Gen5ShopPolicy::patches(data, length);
+    try
+    {
+        if (!data || length < 0x200 || length > 0x40000000 || std::memcmp(data + 12, "IREO", 4))
+            return result;
+        Gen5ShopPolicy::Bytes rom{data, length};
+        const auto source = Gen5ShopPolicy::file(rom, {"a", "0", "1", "6"});
+        const auto trainerDataSource = Gen5ShopPolicy::file(rom, {"a", "0", "9", "1"});
+        const auto trainerPartySource = Gen5ShopPolicy::file(rom, {"a", "0", "9", "2"});
+        auto trainerData = Gen5ShopPolicy::parse(trainerDataSource.bytes);
+        auto trainerParties = Gen5ShopPolicy::parse(trainerPartySource.bytes);
+        const bool gymLeaderTeamsPatched =
+            Gen5GymLeaderMegas::patchStoryTeams(trainerData, trainerParties);
+        auto personal = Gen5ShopPolicy::parse(source.bytes);
+        if (!appendMegaPersonalForms(personal)) return result;
+        const auto learnsetsSource = Gen5ShopPolicy::file(rom, {"a", "0", "1", "8"});
+        auto learnsets = parseMegaLevelUpLearnsetArchive(learnsetsSource.bytes);
+        if (!appendMegaLevelUpLearnsets(learnsets)) return result;
+        auto combined = Gen5ShopPolicy::patches(data, length, megaStoneIds);
+        if (combined.empty() || !appendHeapBackedShopOverlay(combined, rom))
+            return result;
+
+        const auto spritesSource = Gen5ShopPolicy::file(rom, {"a", "0", "0", "4"});
+        auto sprites = Gen5ShopPolicy::parse(spritesSource.bytes);
+        if (!appendMegaSpriteBlocks(
+                sprites,
+                installArtwork ? &Gen5MegaSpriteAssets::Drafts : nullptr,
+                nullptr,
+                installArtwork ? &Gen5MegaSpriteAssets::Animations : nullptr)) return result;
+
+        // Keep the existing Redux shop fix inside the relocated item archive,
+        // rather than leaving a price patch pointing at the now-unused file.
+        const auto itemsSource = Gen5ShopPolicy::file(rom, {"a", "0", "2", "4"});
+        auto items = Gen5ShopPolicy::parse(itemsSource.bytes);
+        if (items.files.size() <= Gen5ShopPolicy::SuperRepel ||
+            items.files[Gen5ShopPolicy::SuperRepel].size() != 36)
+            return result;
+        for (const auto stoneId : allStoneItemIds)
+        {
+            if (items.files.size() <= stoneId || items.files[stoneId].size() != 36)
+                return result;
+            const bool legacyPlaceholder = std::find(RepurposedMegaStoneIds.begin(),
+                RepurposedMegaStoneIds.end(), stoneId) == RepurposedMegaStoneIds.end();
+            if (legacyPlaceholder && !reservedMegaStoneRecord(items.files[stoneId]))
+                return result;
+            auto stone = items.files[stoneId];
+            Gen5ShopPolicy::half(stone, 0, 5000); // The decomp multiplies stored tens by 10: ₽50,000.
+            stone[8] = 0x1F; // no Natural Gift type; pocket remains the normal item pocket (0)
+            stone[9] = 0;
+            stone[13] = 0; // Clear the reserved placeholder's non-item kind marker.
+            stone[14] = 0; // Clear the repurposed entry's leftover item-specific field.
+            stone[15] = 0; // Reset its bag sort index for the new stone entry.
+            items.files[stoneId] = std::move(stone);
+        }
+        items.files[Gen5ShopPolicy::SuperRepel][0] = 1;
+        items.files[Gen5ShopPolicy::SuperRepel][1] = 0;
+
+        const auto textsSource = Gen5ShopPolicy::file(rom, {"a", "0", "0", "2"});
+        auto texts = Gen5ShopPolicy::parse(textsSource.bytes);
+        if (texts.files.size() <= ItemNameMember ||
+            texts.files.size() <= ItemDescriptionMember)
+            return result;
+        auto names = messageCodes({texts.files[ItemNameMember].data(),
+                                   texts.files[ItemNameMember].size()});
+        for (const auto& profile : SupportedProfiles)
+            overwriteMegaStoneName(names, profile.stone, 112, profile.stoneName);
+        for (const auto& alias : LegacyStoneAliases)
+        {
+            const auto* profile = profileForSpeciesForm(alias.species, alias.form);
+            if (!profile) return result;
+            overwriteMegaStoneName(names, alias.stone, 112, profile->stoneName);
+        }
+        texts.files[ItemNameMember] = packMessages(
+            {texts.files[ItemNameMember].data(), texts.files[ItemNameMember].size()}, names);
+
+        auto descriptions = messageCodes({texts.files[ItemDescriptionMember].data(),
+                                          texts.files[ItemDescriptionMember].size()});
+        for (const auto& profile : SupportedProfiles)
+        {
+            const auto firstLine = "For " + std::string(profile.pokemonName) +
+                                   " to Mega Evolve.";
+            replaceAsciiMessage(descriptions, profile.stone,
+                                firstLine, "Must be held during battle.");
+        }
+        for (const auto& alias : LegacyStoneAliases)
+        {
+            const auto* profile = profileForSpeciesForm(alias.species, alias.form);
+            if (!profile) return result;
+            const auto firstLine = "For " + std::string(profile->pokemonName) +
+                                   " to Mega Evolve.";
+            replaceAsciiMessage(descriptions, alias.stone,
+                                firstLine, "Must be held during battle.");
+        }
+        texts.files[ItemDescriptionMember] = packMessages(
+            {texts.files[ItemDescriptionMember].data(),
+             texts.files[ItemDescriptionMember].size()}, descriptions);
+
+        const auto supersRepelOriginalOffset =
+            itemsSource.start + items.offsets[Gen5ShopPolicy::SuperRepel];
+        combined.erase(std::remove_if(combined.begin(), combined.end(),
+            [supersRepelOriginalOffset](const auto& patch) {
+                return patch.offset == supersRepelOriginalOffset && patch.bytes.size() == 2 &&
+                       patch.bytes[0] == 1 && patch.bytes[1] == 0;
+            }), combined.end());
+
+        // Gen V's decompiled item loader selects icon graphics through the
+        // ARM9 ITEM_GRAPHICS_CHARS_AND_PALETTES table, not through bytes in the
+        // item record. Append original 4bpp icons and patch each stone's real
+        // table entry so both the game and the launcher preview see them.
+        const auto itemGraphicsSource = Gen5ShopPolicy::file(rom, {"a", "0", "2", "5"});
+        auto itemGraphics = Gen5ShopPolicy::parse(itemGraphicsSource.bytes);
+        const auto iconTable = Gen5MegaItemIcons::mappingTable(
+            rom, unsigned(items.files.size()), unsigned(itemGraphics.files.size()));
+        if (!iconTable) return result;
+        if (!Gen5MegaItemIcons::append(itemGraphics.files, rom,
+                unsigned(items.files.size()), *iconTable, allStoneItemIds,
+                iconProfileIndices, combined))
+            return result;
+
+        appendRelocatedFile(combined, rom, source, Gen5ShopPolicy::pack(personal));
+        appendRelocatedFile(combined, rom, learnsetsSource, Gen5ShopPolicy::pack(learnsets));
+        appendRelocatedFile(combined, rom, spritesSource, Gen5ShopPolicy::pack(sprites));
+        appendRelocatedFile(combined, rom, itemGraphicsSource, Gen5ShopPolicy::pack(itemGraphics));
+        appendRelocatedFile(combined, rom, textsSource, Gen5ShopPolicy::pack(texts));
+        appendRelocatedFile(combined, rom, itemsSource, Gen5ShopPolicy::pack(items));
+        if (gymLeaderTeamsPatched)
+        {
+            appendRelocatedFile(combined, rom, trainerPartySource,
+                                Gen5ShopPolicy::pack(trainerParties));
+            appendRelocatedFile(combined, rom, trainerDataSource,
+                                Gen5ShopPolicy::pack(trainerData));
+        }
+        appendExtendedHeader(combined, rom);
+        return combined;
+    }
+    catch (const std::exception&)
+    {
+        // A mismatched Redux profile or unavailable padding must not affect the
+        // existing shop patch or prevent the game from loading.
+        return result;
+    }
+}
+}
