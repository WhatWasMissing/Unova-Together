+inline constexpr uint32_t MainRamBase = 0x02000000;
+inline constexpr std::size_t MainRamSize = 0x400000;
+inline constexpr uint32_t BattleSpriteCount = 14;
+inline constexpr uint32_t BattleWorkEntryOffset = 8;
+inline constexpr uint32_t BattleWorkEntrySize = 0x5C;
+inline constexpr uint32_t BattleMonSpeciesOffset = 0x2C;
+inline constexpr uint32_t BattleMonFormOffset = 0x30;
+inline constexpr uint32_t BattleSpritePositionOffset = 0x48;
+inline constexpr uint32_t McssTextureArrayOffset = 0x14;
+inline constexpr uint32_t McssTextureBaseOffset = 0x30;
+inline constexpr uint32_t McssTextureSize = 0x4000;
+inline constexpr std::size_t PackedFrameBytes = Gen5MegaSprite::PixelCount / 2;
+inline constexpr std::size_t StreamHeaderBytes = 8;
+inline constexpr std::size_t ClipDescriptorBytes = 16;
+inline constexpr std::size_t FrameDescriptorBytes = 8;
+
+struct FrameView
+{
+    const uint8_t* pixels = nullptr;
+    uint16_t duration = 0;
+};
+
+struct FrameSequence
+{
+    std::vector<FrameView> frames;
+};
+
+struct PlaybackCursor
+{
+    std::size_t frame = 0;
+    uint16_t ticksRemaining = 0;
+    bool started = false;
+};
+
+struct ClipView
+{
+    uint16_t species = 0;
+    uint8_t form = 0;
+    FrameSequence front;
+    FrameSequence back;
+};
+
+struct BattleSprite
+{
+    uint16_t species = 0;
+    uint8_t form = 0;
+    uint8_t position = 0;
+    uint8_t textureIndex = 0;
+    uint32_t textureAddress = 0;
+};
+
+struct BattleSpriteSystem
+{
+    uint32_t systemAddress = 0;
+    uint32_t workAddress = 0;
+    uint32_t textureBase = 0;
+    std::vector<BattleSprite> sprites;
+};
+
+inline uint16_t read16(const uint8_t* data)
+{
+    return uint16_t(data[0] | (uint16_t(data[1]) << 8));
+}
+
+inline uint32_t read32(const uint8_t* data)
+{
+    return uint32_t(read16(data)) | (uint32_t(read16(data + 2)) << 16);
+}
+
+inline void write16(uint8_t* data, uint16_t value)
+{
+    data[0] = uint8_t(value);
+    data[1] = uint8_t(value >> 8);
+}
+
+inline void write32(uint8_t* data, uint32_t value)
+{
+    write16(data, uint16_t(value));
+    write16(data + 2, uint16_t(value >> 16));
+}
+
+inline bool inRam(uint32_t address, std::size_t bytes)
+{
+    return address >= MainRamBase && bytes <= MainRamSize &&
+           std::size_t(address - MainRamBase) <= MainRamSize - bytes;
+}
+
+inline bool ramWord(const uint8_t* ram, std::size_t size,
+                    uint32_t address, uint32_t& result)
+{
+    if (!ram || size != MainRamSize || (address & 3) || !inRam(address, 4))
+        return false;
+    result = read32(ram + address - MainRamBase);
+    return true;
+}
+
+inline bool loadSequence(const uint8_t* bytes, std::size_t size,
+                         uint32_t tableOffset, uint16_t count,
+                         FrameSequence& sequence)
+{
+    if (!count)
+        return tableOffset == 0;
+    if (!tableOffset || count > 512 || tableOffset > size ||
+        std::size_t(count) > (size - tableOffset) / FrameDescriptorBytes)
+        return false;
+
+    sequence.frames.reserve(count);
+    for (uint16_t i = 0; i < count; ++i)
+    {
+        const auto* descriptor = bytes + tableOffset + std::size_t(i) * FrameDescriptorBytes;
+        const uint32_t pixelsOffset = read32(descriptor);
+        const uint16_t duration = read16(descriptor + 4);
+        if (!duration || pixelsOffset > size || PackedFrameBytes > size - pixelsOffset)
+            return false;
+        sequence.frames.push_back({bytes + pixelsOffset, duration});
+    }
+    return true;
+}
+
+// Binary resource written by tools/build_gen5_mega_sprite_assets.py:
+// "UTMA", version, clip count, clip descriptors, frame descriptors, pixels.
+inline bool parsePack(const uint8_t* bytes, std::size_t size,
+                      std::vector<ClipView>& clips)
+{
+    clips.clear();
+    if (!bytes || size < StreamHeaderBytes || std::memcmp(bytes, "UTMA", 4) != 0 ||
+        read16(bytes + 4) != 1)
+        return false;
+    const uint16_t clipCount = read16(bytes + 6);
+    if (clipCount > 64 || clipCount > (size - StreamHeaderBytes) / ClipDescriptorBytes)
+        return false;
+
+    const std::size_t descriptorEnd = StreamHeaderBytes +
+                                      std::size_t(clipCount) * ClipDescriptorBytes;
+    clips.reserve(clipCount);
+    for (uint16_t i = 0; i < clipCount; ++i)
+    {
+        const auto* descriptor = bytes + StreamHeaderBytes +
+                                 std::size_t(i) * ClipDescriptorBytes;
+        ClipView clip;
+        clip.species = read16(descriptor);
+        clip.form = descriptor[2];
+        const uint16_t frontCount = read16(descriptor + 4);
+        const uint16_t backCount = read16(descriptor + 6);
+        const uint32_t frontTable = read32(descriptor + 8);
+        const uint32_t backTable = read32(descriptor + 12);
+        if (!clip.species || clip.species > 649 || clip.form >= 32 ||
+            (frontCount == 0 && backCount == 0) ||
+            (frontCount && frontTable < descriptorEnd) ||
+            (backCount && backTable < descriptorEnd) ||
+            !loadSequence(bytes, size, frontTable, frontCount, clip.front) ||
+            !loadSequence(bytes, size, backTable, backCount, clip.back))
+            return false;
+        if (std::any_of(clips.begin(), clips.end(), [&](const ClipView& other) {
+                return other.species == clip.species && other.form == clip.form;
+            }))
+            return false;
+        clips.push_back(std::move(clip));
+    }
+    return true;
+}
+
+inline const ClipView* findClip(const std::vector<ClipView>& clips,
+                                uint16_t species, uint8_t form)
+{
+    const auto it = std::find_if(clips.begin(), clips.end(), [&](const ClipView& clip) {
+        return clip.species == species && clip.form == form;
+    });
+    return it == clips.end() ? nullptr : &*it;
+}
+
+inline bool buildTextureAtlas(const uint8_t* packedFrame, std::size_t bytes,
+                              std::array<uint8_t, McssTextureSize>& atlas)
+{
+    if (!packedFrame || bytes != PackedFrameBytes) return false;
+    atlas.fill(0);
+    for (unsigned y = 0; y < Gen5MegaSprite::CanvasHeight; ++y)
+        for (unsigned x = 0; x < Gen5MegaSprite::CanvasWidth; ++x)
+        {
+            const unsigned sourcePixel = y * Gen5MegaSprite::CanvasWidth + x;
+            const uint8_t sourceByte = packedFrame[sourcePixel / 2];
+            const uint8_t color = uint8_t((sourceByte >> ((sourcePixel & 1) * 4)) & 15);
+            for (unsigned page = 0; page < 2; ++page)
+            {
+                const unsigned destinationPixel = y * 256 + page * 128 + x;
+                auto& destination = atlas[destinationPixel / 2];
+                if (destinationPixel & 1)
+                    destination = uint8_t((destination & 0x0F) | (color << 4));
+                else
+                    destination = uint8_t((destination & 0xF0) | color);
+            }
+        }
+    return true;
+}
+
+// Starts on frame zero. Thereafter one call represents one emulated DS frame;
+// GIF durations are converted to DS ticks by the asset converter.
+inline bool advance(PlaybackCursor& cursor, const FrameSequence& sequence)
+{
+    if (sequence.frames.empty()) return false;
+    if (!cursor.started)
+    {
+        cursor = {0, sequence.frames[0].duration, true};
+        return true;
+    }
+    if (cursor.ticksRemaining > 1)
+    {
+        --cursor.ticksRemaining;
+        return false;
+    }
+    cursor.frame = (cursor.frame + 1) % sequence.frames.size();
+    cursor.ticksRemaining = sequence.frames[cursor.frame].duration;
+    return true;
+}
+
+// Return the frame the runtime should upload on this emulated DS tick. A null
+// result means the current texture remains valid for another tick.
+inline const FrameView* frameForTick(PlaybackCursor& cursor,
+                                     const FrameSequence& sequence)
+{
+    return advance(cursor, sequence) ? &sequence.frames[cursor.frame] : nullptr;
+}
+
+inline bool mappedRamPointer(const uint8_t* ram, std::size_t size,
+                             uint32_t address, uint32_t& value)
+{
+    return ramWord(ram, size, address, value) &&
+           (value == 0 || (((value & 3) == 0) && inRam(value, 4)));
+}
+
+inline bool decodeBattleSpriteSystem(const uint8_t* ram, std::size_t size,
+                                     uint32_t systemAddress, uint32_t workAddress,
+                                     BattleSpriteSystem& result)
+{
+    uint32_t count = 0, slotTable = 0, textureBase = 0, workSystem = 0, workTcb = 0;
+    if (!ramWord(ram, size, systemAddress + 0x10, count) || count != BattleSpriteCount ||
+        !mappedRamPointer(ram, size, systemAddress + McssTextureArrayOffset, slotTable) ||
+        !slotTable || !inRam(slotTable, BattleSpriteCount * 4) ||
+        !ramWord(ram, size, systemAddress + McssTextureBaseOffset, textureBase) ||
+        textureBase >= 512 * 1024 || textureBase % McssTextureSize ||
+        !mappedRamPointer(ram, size, workAddress, workTcb) || !workTcb ||
+        !mappedRamPointer(ram, size, workAddress + 4, workSystem) ||
+        workSystem != systemAddress || !inRam(workAddress, 0x5B4))
+        return false;
+
+    std::array<uint32_t, BattleSpriteCount> textureObjects{};
+    for (unsigned i = 0; i < BattleSpriteCount; ++i)
+        if (!ramWord(ram, size, slotTable + i * 4, textureObjects[i]) ||
+            (textureObjects[i] && !inRam(textureObjects[i], 4)))
+            return false;
+
+    BattleSpriteSystem decoded;
+    decoded.systemAddress = systemAddress;
+    decoded.workAddress = workAddress;
+    decoded.textureBase = textureBase;
+    std::array<bool, 8> seenPositions{};
+    for (unsigned i = 0; i < BattleSpriteCount; ++i)
+    {
+        const uint32_t entry = workAddress + BattleWorkEntryOffset + i * BattleWorkEntrySize;
+        uint32_t mcss = 0;
+        if (!ramWord(ram, size, entry, mcss)) return false;
+        if (!mcss) continue;
+
+        uint32_t position = 0, species = 0, form = 0;
+        if (!ramWord(ram, size, entry + BattleSpritePositionOffset, position) || position >= BattleSpriteCount ||
+            !ramWord(ram, size, entry + BattleMonSpeciesOffset, species) ||
+            !ramWord(ram, size, entry + BattleMonFormOffset, form))
+            return false;
+
+        unsigned textureIndex = BattleSpriteCount;
+        for (unsigned slot = 0; slot < BattleSpriteCount; ++slot)
+            if (textureObjects[slot] == mcss) { textureIndex = slot; break; }
+        if (textureIndex >= BattleSpriteCount) return false;
+        if (position >= 8) continue; // Trainer models share the same system.
+        if (!species || species > 649 || form >= 32 || seenPositions[position]) return false;
+        const uint32_t textureAddress = textureBase + textureIndex * McssTextureSize;
+        if (textureAddress > 512 * 1024 - McssTextureSize) return false;
+        seenPositions[position] = true;
+        decoded.sprites.push_back({uint16_t(species), uint8_t(form), uint8_t(position),
+                                   uint8_t(textureIndex), textureAddress});
+    }
+    if (decoded.sprites.empty()) return false;
+    result = std::move(decoded);
+    return true;
+}
+
+// Cache the two RAM pointers while a battle view is alive. A valid cached
+// pair avoids rescanning 4 MiB every emulated frame; stale pointers fall back
+// to a full scan and are never dereferenced without range and layout checks.
+inline bool findBattleSpriteSystem(const uint8_t* ram, std::size_t size,
+                                   uint32_t cachedSystem, uint32_t cachedWork,
+                                   BattleSpriteSystem& result)
+{
+    if (!ram || size != MainRamSize) return false;
