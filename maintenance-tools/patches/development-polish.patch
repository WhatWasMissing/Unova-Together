+    {159, 118, 330, 445, RepurposedMegaStoneIds[40], 1, {527, 244, 416, 159}},
+    // Marlon's Wailord becomes Mega Gyarados.
+    {160, 119, 321, 130, RepurposedMegaStoneIds[11], 1, {505, 129, 244, 351}},
+}};
