+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+
+#include <QSoundEffect>
+#include <QUrl>
+#include "NativeMenuSoundCues.h"
+
+namespace NativeMenuSounds {
+class Player
+{
+    QSoundEffect navigation, confirm, cancel;
+    bool enabled = true;
+
+public:
+    Player()
+    {
+        navigation.setSource(QUrl("qrc:/menu-sounds/menu-nav.wav"));
+        confirm.setSource(QUrl("qrc:/menu-sounds/menu-confirm.wav"));
+        cancel.setSource(QUrl("qrc:/menu-sounds/menu-cancel.wav"));
+        navigation.setVolume(.24f);
+        confirm.setVolume(.30f);
+        cancel.setVolume(.30f);
+    }
+
+    void setEnabled(bool value) { enabled = value; }
+    bool isEnabled() const { return enabled; }
+
+    void play(Cue cue)
+    {
+        if (!enabled || cue == Cue::None) return;
+        QSoundEffect* effect = cue == Cue::Navigation ? &navigation :
+                               cue == Cue::Confirm ? &confirm : &cancel;
+        if (effect->isPlaying()) effect->stop();
+        effect->play();
+    }
+};
+}
