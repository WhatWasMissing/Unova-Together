+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+// Mega item compatibility maintained with OpenAI Codex; see AUTHORSHIP.md.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <algorithm>
+#include "Gen5MegaItemIds.h"
+
+// Black 2 Redux reuses the twelve Gen V Mail IDs for stones. The game has a
+// separate ARM9 table used by PML_ItemIsMail, plus a RAM table mapping item IDs
+// to bag pockets. Keep both in sync with the patched item records.
+namespace Gen5MegaItemCompatibility {
+inline constexpr std::size_t MainRamSize = 0x400000;
+inline constexpr uint32_t RamBase = 0x02000000;
+inline constexpr uint32_t ItemPocketTablePointer = 0x020088F8;
+inline constexpr uint32_t MailItemIdsAddress = 0x02090A30; // B2 US ARM9 symbol
+inline constexpr std::size_t MailItemCount = 12;
+inline constexpr uint16_t FirstMailItem = 137;
+inline constexpr uint8_t NormalItemPocket = 0;
+
+inline bool contains(std::size_t length, uint32_t address, std::size_t size)
+{
+    return address >= RamBase && size <= length &&
+           std::size_t(address - RamBase) <= length - size;
+}
+
+inline uint32_t read32(const uint8_t* ram, std::size_t offset)
+{
+    return uint32_t(ram[offset]) | (uint32_t(ram[offset + 1]) << 8) |
+           (uint32_t(ram[offset + 2]) << 16) | (uint32_t(ram[offset + 3]) << 24);
+}
+
+// This table is initialized by the game from the cartridge item data. Normalize
+// only the 46 item IDs that the Redux overlay replaces with Mega Stones.
+inline bool normalizeStonePockets(uint8_t* ram, std::size_t length)
+{
+    if (!ram || length != MainRamSize || !contains(length, ItemPocketTablePointer, 4))
+        return false;
+    const auto table = read32(ram, ItemPocketTablePointer - RamBase);
+    if (!contains(length, table, 639)) return false;
+    auto* pockets = ram + (table - RamBase);
+    for (const auto stone : RepurposedMegaStoneIds)
+        pockets[stone] = NormalItemPocket;
+    return true;
+}
+
+// Disable the game's separate Mail-ID test. The signature guard prevents this
+// B2-US-specific edit from touching a different RAM layout or game version.
+inline bool disableReplacedMailIds(uint8_t* ram, std::size_t length)
+{
+    if (!ram || length != MainRamSize ||
+        !contains(length, MailItemIdsAddress, MailItemCount * sizeof(uint16_t)))
+        return false;
+    auto* table = ram + (MailItemIdsAddress - RamBase);
+    bool alreadyDisabled = true;
+    bool expectedMailList = true;
+    for (std::size_t i = 0; i < MailItemCount; ++i)
+    {
+        const auto value = uint16_t(table[i * 2] | (uint16_t(table[i * 2 + 1]) << 8));
+        alreadyDisabled &= value == 0xFFFF;
+        expectedMailList &= value == FirstMailItem + i;
+    }
+    if (alreadyDisabled) return true;
+    if (!expectedMailList) return false;
+    std::fill(table, table + MailItemCount * sizeof(uint16_t), uint8_t(0xFF));
+    return true;
+}
+
+inline bool mailIdsDisabled(const uint8_t* ram, std::size_t length)
+{
+    if (!ram || length != MainRamSize ||
+        !contains(length, MailItemIdsAddress, MailItemCount * sizeof(uint16_t)))
+        return false;
+    const auto* table = ram + (MailItemIdsAddress - RamBase);
+    return std::all_of(table, table + MailItemCount * sizeof(uint16_t),
+                       [](uint8_t value) { return value == 0xFF; });
+}
+
+inline bool apply(uint8_t* ram, std::size_t length)
+{
+    const bool pockets = normalizeStonePockets(ram, length);
+    const bool mail = disableReplacedMailIds(ram, length);
+    return pockets && mail;
+}
+}
