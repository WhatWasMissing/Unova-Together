+// Fixed-width, endian-stable representation for a peer event. Never send the
+// in-memory Event struct directly: its padding and byte order are ABI-specific.
+inline constexpr std::size_t EventWireSize = 24;
+inline constexpr uint32_t EventMagic = 0x4147454D; // bytes "MEGA"
+inline constexpr uint8_t EventVersion = 2;
+
+inline std::array<uint8_t, EventWireSize> encodeEvent(const Event& event)
+{
+    const auto* profile = profileForSpeciesAndStone(event.species, event.stone);
+    if (!event.battleId || event.sequence != 1 || event.trainer > 3 ||
+        event.partySlot >= 6 || !profile ||
+        event.fromForm != profile->baseForm || event.toForm != profile->megaForm)
+        throw std::runtime_error("Invalid Mega Evolution event");
+
+    std::array<uint8_t, EventWireSize> bytes{};
+    bytes[0] = uint8_t(EventMagic);
+    bytes[1] = uint8_t(EventMagic >> 8);
+    bytes[2] = uint8_t(EventMagic >> 16);
+    bytes[3] = uint8_t(EventMagic >> 24);
+    bytes[4] = EventVersion;
+    bytes[5] = event.trainer;
+    bytes[6] = event.partySlot;
+    bytes[7] = event.fromForm;
+    bytes[8] = event.toForm;
+    const auto put16 = [&](std::size_t offset, uint16_t value) {
+        bytes[offset] = uint8_t(value);
+        bytes[offset + 1] = uint8_t(value >> 8);
+    };
+    const auto put32 = [&](std::size_t offset, uint32_t value) {
+        put16(offset, uint16_t(value));
+        put16(offset + 2, uint16_t(value >> 16));
+    };
+    put16(10, event.species);
+    put16(12, event.stone);
+    put32(16, event.battleId);
+    put32(20, event.sequence);
+    return bytes;
+}
+
+inline std::optional<Event> decodeEvent(const uint8_t* bytes, std::size_t length)
+{
+    if (!bytes || length != EventWireSize || bytes[0] != 'M' || bytes[1] != 'E' ||
+        bytes[2] != 'G' || bytes[3] != 'A' || bytes[4] != EventVersion ||
+        bytes[9] || bytes[14] || bytes[15])
+        return std::nullopt;
+    const auto get16 = [&](std::size_t offset) {
+        return uint16_t(bytes[offset] | (uint16_t(bytes[offset + 1]) << 8));
+    };
+    const auto get32 = [&](std::size_t offset) {
+        return uint32_t(get16(offset)) | (uint32_t(get16(offset + 2)) << 16);
+    };
+    Event event{get32(16), get32(20), bytes[5], bytes[6], get16(10), get16(12),
+                bytes[7], bytes[8]};
+    const auto* profile = profileForSpeciesAndStone(event.species, event.stone);
+    if (!event.battleId || event.sequence != 1 || event.trainer > 3 ||
+        event.partySlot >= 6 || !profile ||
+        event.fromForm != profile->baseForm || event.toForm != profile->megaForm)
+        return std::nullopt;
+    return event;
+}
