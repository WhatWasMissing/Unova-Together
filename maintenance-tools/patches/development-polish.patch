+inline std::optional<uint16_t> megaPersonalFormIndex(uint16_t species, uint8_t form)
+{
+    const auto found = std::find_if(SupportedProfiles.begin(), SupportedProfiles.end(),
+        [species, form](const MegaProfile& item) {
+            return item.species == species && item.megaForm == form;
+        });
