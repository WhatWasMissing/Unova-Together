+        ? Gen5MegaEvolution::profileForStone(uint16_t(itemId)) : nullptr;
+    if(!profile) return {{"ok",false},{"reason","Choose a supported Mega Stone"}};
+    const QString stoneName=QString::fromUtf8(profile->stoneName.data(),int(profile->stoneName.size()));
+    runWirelessTask([&] {
+        if(!emuActive || !emuInstance->nds) {
+            result={{"ok",false},{"reason","Load the game first"}};
+            return;
+        }
