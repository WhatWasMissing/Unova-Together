+// Resolve one copied battle-mon record from the verified Redux battle
+// context. The independent context, wrapper, and direct table views must all
+// agree before returning a candidate. This is read-only and does not prove
+// that the party slot is currently active or selected in the command UI.
+inline std::optional<BattleMonView> battleMonForPartySlot(
+    const uint8_t* ram, std::size_t length, uint32_t battleContext, uint8_t partySlot)
+{
+    constexpr uint32_t RamBase = 0x02000000;
+    constexpr std::size_t BattleMonSize = 0x224;
+    constexpr unsigned PartySlots = 6;
+    const auto valid = [length, RamBase](uint32_t address, std::size_t size) {
+        return address >= RamBase && size <= length &&
+               std::size_t(address - RamBase) <= length - size;
+    };
+    const auto word = [&](uint32_t address, uint32_t& value) {
+        if (!ram || (address & 3) || !valid(address, 4)) return false;
+        const auto offset = std::size_t(address - RamBase);
+        value = uint32_t(ram[offset]) | (uint32_t(ram[offset + 1]) << 8) |
+                (uint32_t(ram[offset + 2]) << 16) | (uint32_t(ram[offset + 3]) << 24);
+        return true;
+    };
+    const auto half = [&](uint32_t address, uint16_t& value) {
+        if (!ram || !valid(address, 2)) return false;
+        const auto offset = std::size_t(address - RamBase);
+        value = uint16_t(ram[offset] | (uint16_t(ram[offset + 1]) << 8));
+        return true;
+    };
+    if (!ram || length != 0x400000 || partySlot >= PartySlots ||
+        !valid(battleContext, 0x48)) return std::nullopt;
+
+    uint32_t owner = 0, direct = 0, wrapper = 0, wrapperOwner = 0;
+    if (!word(battleContext + 0x10, owner) || !word(battleContext + 0x18, direct) ||
+        !word(battleContext + 0x44, wrapper) || !valid(owner, 0x9C) ||
+        !valid(direct, PartySlots * 4) || !valid(wrapper, 12) ||
+        !word(wrapper + 8, wrapperOwner) || owner != wrapperOwner)
+        return std::nullopt;
+
+    std::optional<BattleMonView> match;
+    for (unsigned index = 0; index < PartySlots; ++index)
+    {
+        uint32_t byOwner = 0, byDirect = 0;
+        if (!word(owner + 0x84 + index * 4, byOwner) ||
+            !word(direct + index * 4, byDirect) || byOwner != byDirect ||
+            !valid(byOwner, BattleMonSize))
+            return std::nullopt;
+
+        uint16_t species = 0, heldItem = 0;
+        if (!half(byOwner + 0x0C, species) || !half(byOwner + 0x12, heldItem))
+            return std::nullopt;
+        const auto slot = ram[std::size_t(byOwner - RamBase) + 0x19];
+        const auto form = ram[std::size_t(byOwner - RamBase) + 0x141];
+        if (species < 1 || species > 649 || heldItem > 639 || slot >= PartySlots || form >= 32)
+            return std::nullopt;
+        if (slot == partySlot)
+        {
+            if (match) return std::nullopt;
+            match = BattleMonView{byOwner, species, heldItem, slot, form};
+        }
+    }
+    return match;
+}
