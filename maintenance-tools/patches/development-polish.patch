@@ -0,0 +1,54 @@
+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// Keyboard events arrive on the GUI thread while inputProcess samples them on
+// the emulation thread. Keep the held state and one-shot short-key pulses in a
+// single atomic word so a press/release between samples cannot disappear.
+class KeyInputLatch
+{
+public:
+    static constexpr uint32_t ButtonMask = 0x0FFF;
+
+    void press(unsigned button) noexcept
+    {
+        if (button >= 12) return;
+        const uint32_t bit = uint32_t(1) << button;
+        uint32_t current = state.load(std::memory_order_relaxed);
+        for (;;)
+        {
+            const bool wasReleased = (current & bit) != 0;
+            const uint32_t next = (current & ~bit) |
+                (wasReleased ? bit << 12 : 0);
+            if (state.compare_exchange_weak(current, next,
+                    std::memory_order_release, std::memory_order_relaxed)) return;
+        }
+    }
+
+    void release(unsigned button) noexcept
+    {
+        if (button < 12) state.fetch_or(uint32_t(1) << button,
+                                        std::memory_order_release);
+    }
+
+    void releaseAll() noexcept
+    {
+        state.store(ButtonMask, std::memory_order_release);
+    }
+
+    // Returns the active-low button mask. A pulse is merged with the held mask
+    // and cleared in the same atomic operation, so no concurrent edge is lost.
+    uint32_t sample() noexcept
+    {
+        const uint32_t sampled = state.fetch_and(ButtonMask,
+                                                  std::memory_order_acq_rel);
+        const uint32_t held = sampled & ButtonMask;
+        const uint32_t pulses = (sampled >> 12) & ButtonMask;
+        return held & ~pulses;
+    }
+
+private:
+    std::atomic<uint32_t> state{ButtonMask};
+};
