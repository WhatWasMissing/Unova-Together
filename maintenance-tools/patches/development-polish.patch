+// Black 2 Redux's item description preview uses a correctly centered item
+// window but places the selected-item actor at (132, 80), four pixels down and
+// right of its intended (128, 76) center. Correct only the exact Mega Stone
+// actor-creation call from the verified overlay-142 caller.
+static void NativeMegaStonePreviewCentering(ARMv5& cpu, NDS& nds)
+{
+    constexpr u32 ActorCreateEntry = 0x0204C040;
+    constexpr u32 ItemPreviewEntry = 0x0219E4DC;
+    constexpr u32 ItemPreviewReturn = 0x0219E57F;
+    constexpr std::array<u8, 8> PreviewSignature{
+        0xF0, 0xB5, 0x85, 0xB0, 0x0E, 0x1C, 0x6B, 0x21};
+    const u32 pc = cpu.R[15] - ((cpu.CPSR & 0x20) ? 2 : 4);
+    if (cpu.Num != 0 || !(cpu.CPSR & 0x20) || pc != ActorCreateEntry ||
+        cpu.R[14] != ItemPreviewReturn || nds.MainRAMMask != 0x3FFFFF)
+        return;
+
+    auto* cart = nds.NDSCartSlot.GetCart();
+    if (!cart || cart->GetROMLength() < 16 ||
+        std::memcmp(cart->GetROM() + 12, "IREO", 4) ||
+        std::memcmp(nds.MainRAM + ItemPreviewEntry - 0x02000000,
+                    PreviewSignature.data(), PreviewSignature.size()))
+        return;
+
+    const auto valid = [](u32 address, u32 length) {
+        return address >= 0x02000000 && address <= 0x02400000 - length;
+    };
+    const auto read32 = [&](u32 address) {
+        const auto* p = nds.MainRAM + address - 0x02000000;
+        return u32(p[0]) | (u32(p[1]) << 8) | (u32(p[2]) << 16) | (u32(p[3]) << 24);
+    };
+    const auto read16 = [&](u32 address) {
+        const auto* p = nds.MainRAM + address - 0x02000000;
+        return u16(p[0] | (u16(p[1]) << 8));
+    };
+    const u32 args = cpu.R[13];
+    if (!valid(args, 12)) return;
+    const u32 setup = read32(args);
+    // The decompiled caller ItemMenuDisp_ShowSelIcon(work, item) keeps its
+    // item argument in callee-saved R6 while it creates the preview actor.
+    // Stack argument +8 is heapId, not itemId (func_0204c040 has 7 args).
+    const u32 itemId = cpu.R[6];
+    if (itemId > 0xFFFF || !valid(setup, 8) ||
+        !Gen5MegaItemIconLayout::isOffCenterMegaStonePreview(
+            uint16_t(itemId), read16(setup), read16(setup + 2)))
+        return;
+
+    auto* coordinates = nds.MainRAM + setup - 0x02000000;
+    coordinates[0] = u8(Gen5MegaItemIconLayout::CenteredPreviewX);
+    coordinates[1] = u8(Gen5MegaItemIconLayout::CenteredPreviewX >> 8);
+    coordinates[2] = u8(Gen5MegaItemIconLayout::CenteredPreviewY);
+    coordinates[3] = u8(Gen5MegaItemIconLayout::CenteredPreviewY >> 8);
+}
