+inline uint32_t reviewedEntryPointMask(const uint8_t* data, std::size_t size)
+{
+    const RAM ram(data, size);
+    struct Fingerprint { uint32_t address; std::array<uint8_t, 24> bytes; };
+    // Immutable callback prefixes from the independently decoded, hash-checked
+    // Redux overlay. The runtime loader must also verify the full ROM overlay;
+    // these checks reject stale/missing or patched live entry points.
+    static constexpr std::array<Fingerprint, 5> signatures{{
+        {0x021AE260,{0x70,0xB5,0x0C,0x1C,0x05,0x1C,0x21,0x79,0xA8,0x68,0xEE,0xF7,
+                    0xD1,0xFF,0x06,0x1C,0x0D,0xF0,0x7A,0xF8,0x00,0x28,0x2E,0xD1}},
+        {0x021B89CC,{0xF8,0xB5,0x0C,0x1C,0x05,0x1C,0x20,0x68,0x16,0x1C,0x00,0x28,
+                    0x02,0xD0,0x01,0x28,0x1F,0xD0,0x24,0xE0,0x32,0x68,0x28,0x68}},
+        {0x0219F9D0,{0xF0,0xB5,0x85,0xB0,0x05,0x1C,0x00,0x20,0x00,0x90,0x52,0x48,
+                    0x0C,0x1C,0x29,0x5C,0x8C,0x42,0x5F,0xD2,0x01,0x1C,0x5E,0x31}},
+        {0x021B3C00,{0xF8,0xB5,0x82,0xB0,0x0D,0x1C,0x29,0x68,0x04,0x1C,0x07,0x29,
+                    0x43,0xD8,0x49,0x18,0x79,0x44,0xC9,0x88,0x09,0x04,0x09,0x14}},
+        // Low-level ChangeForm(BattleMon*, form), applied to both local copies.
+        {0x021BBED8,{0xF8,0xB5,0x14,0x4F,0x05,0x1C,0x0C,0x1C,0xEC,0x55,0x28,0x68,
+                    0x60,0xF6,0x92,0xFE,0x06,0x1C,0x28,0x68,0x21,0x1C,0x60,0xF6}}
+    }};
+    uint32_t mask = 0;
+    for (std::size_t index = 0; index < signatures.size(); ++index)
+    {
+        const auto& signature = signatures[index];
+        if (ram.valid(signature.address, signature.bytes.size()) &&
+            !std::memcmp(data + signature.address - 0x02000000,
+                         signature.bytes.data(), signature.bytes.size()))
+            mask |= 1u << index;
+    }
+    return mask;
+}
+
+inline bool reviewedEntryPoints(const uint8_t* data, std::size_t size)
+{
+    const RAM ram(data, size);
+    if (reviewedEntryPointMask(data, size) != 0x1F) return false;
+    constexpr std::array<uint8_t, 4> firstSlots{0, 12, 6, 18};
+    constexpr std::array<uint8_t, 24> resolvePrefix{
+        0x10,0xB5,0x04,0x1C,0xFF,0xF7,0xE2,0xFF,0x01,0x1C,0x06,0x29,
+        0x03,0xD0,0x20,0x1C,0x00,0xF0,0x4E,0xF8,0x10,0xBD,0xFF,0x20};
+    constexpr std::array<uint8_t, 24> visualPrefix{
+        0x38,0xB5,0x05,0x1C,0x68,0x68,0x0C,0x1C,0xE1,0xF7,0x92,0xFA,
+        0x02,0x1C,0x07,0x20,0x80,0x01,0x28,0x58,0x21,0x1C,0x03,0xF0};
+    return ram.valid(ResolveVisualPosition & ~1u, resolvePrefix.size()) &&
+           !std::memcmp(data + (ResolveVisualPosition & ~1u) - 0x02000000,
+                        resolvePrefix.data(), resolvePrefix.size()) &&
+           ram.valid(StartVisualChange & ~1u, visualPrefix.size()) &&
+           !std::memcmp(data + (StartVisualChange & ~1u) - 0x02000000,
+                        visualPrefix.data(), visualPrefix.size()) &&
+           ram.valid(0x021D6C24, firstSlots.size()) &&
+           !std::memcmp(data + 0x001D6C24, firstSlots.data(), firstSlots.size());
+}
+
+inline std::optional<unsigned> committedFightIndex(const RAM& ram, const Selection& selection)
+{
+    if (!ram.object(selection.flow, ActionOrderOffset + 6 * ActionOrderSize)) return std::nullopt;
+    const auto count = ram.byte(selection.flow + ActionCountOffset);
+    if (!count || count > 6) return std::nullopt;
+    std::optional<unsigned> found;
+    for (unsigned index = 0; index < count; ++index)
+    {
+        const auto work = selection.flow + ActionOrderOffset + index * ActionOrderSize;
+        if (ram.word(work) != selection.serverMon) continue;
+        if (found || (ram.word(work + 4) & 15) != 1 || ram.byte(work + 13)) return std::nullopt;
+        found = index;
+    }
+    return found;
+}
+
+inline bool committedFight(const RAM& ram, const Selection& selection)
+{
+    return committedFightIndex(ram, selection).has_value();
+}
+
+// A pending player Mega must not suppress an opponent Mega whose committed
+// action comes first. In that case both transactions can be armed up front and
+// the shared turn handler executes them at their own action-order slots.
+inline bool opponentMegaPrecedesLocalMega(
+    const std::optional<unsigned>& localActionIndex,
+    const std::optional<unsigned>& opponentActionIndex)
+{
+    return localActionIndex && opponentActionIndex &&
+           *opponentActionIndex < *localActionIndex;
+}
+
+// NPC opponents that carry a matching Mega Stone use it on their own committed
+// Fight action. Emit a candidate only when both live copies agree and the
+// target has a Fight slot in this turn's action order.
+inline std::optional<Gen5MegaEvolution::Event> heldStoneOpponentEvent(
+    const uint8_t* data, std::size_t size, uint32_t module, uint32_t battleId)
+{
+    if (!battleId) return std::nullopt;
+    const auto entry = activeSelection(data, size, module, true);
+    if (!entry) return std::nullopt;
+    const RAM ram(data, size);
+    const auto clientOwner = module + 0xC8;
+    const auto serverOwner = module + 0x1B0;
+    if (!ram.object(clientOwner, 0xE8) || !ram.object(serverOwner, 0xE8))
+        return std::nullopt;
+
+    for (const unsigned trainer : std::array<unsigned, 2>{1u, 3u})
+    {
+        if (trainer == entry->clientId) continue;
+        const auto clientParty = clientOwner + 4 + trainer * 0x1C;
+        const auto serverParty = serverOwner + 4 + trainer * 0x1C;
+        if (!ram.object(clientParty, 0x1C) || !ram.object(serverParty, 0x1C)) continue;
+        const auto count = ram.byte(clientParty + 0x18);
+        if (!count || count > 6 || ram.byte(serverParty + 0x18) != count) continue;
+        for (unsigned partySlot = 0; partySlot < count; ++partySlot)
+        {
+            const auto battleSlot = firstBattleSlot(trainer) + partySlot;
+            const auto clientMon = ram.word(clientOwner + 0x84 + battleSlot * 4);
+            const auto serverMon = ram.word(serverOwner + 0x84 + battleSlot * 4);
+            if (!ram.object(clientMon, 0x142) || !ram.object(serverMon, 0x142) ||
+                clientMon == serverMon || ram.word(clientParty + partySlot * 4) != clientMon ||
+                ram.word(serverParty + partySlot * 4) != serverMon ||
+                ram.byte(clientMon + 0x19) != battleSlot ||
+                ram.byte(serverMon + 0x19) != battleSlot)
+                continue;
+
+            const auto species = ram.half(clientMon + 0x0C);
+            const auto stone = ram.half(clientMon + 0x12);
+            const auto form = ram.byte(clientMon + 0x141);
+            const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(species, stone);
+            if (!profile || form != profile->baseForm ||
+                ram.half(serverMon + 0x0C) != species || ram.half(serverMon + 0x12) != stone ||
+                ram.byte(serverMon + 0x141) != form ||
+                ram.half(clientMon + 0x10) == 0 ||
+                ram.half(clientMon + 0x10) > ram.half(clientMon + 0x0E) ||
+                ram.half(serverMon + 0x10) != ram.half(clientMon + 0x10) ||
+                ram.half(serverMon + 0x0E) != ram.half(clientMon + 0x0E) ||
+                ram.byte(clientMon + 0x1B) != ram.byte(serverMon + 0x1B) ||
+                (ram.byte(clientMon + 0x1B) & 0x60))
+                continue;
+
+            const Gen5MegaEvolution::Event event{battleId, 1, uint8_t(trainer),
+                uint8_t(partySlot), species, stone, profile->baseForm, profile->megaForm};
+            const auto target = targetForEvent(data, size, *entry, event);
+            if (target && committedFightIndex(ram, *target)) return event;
+        }
+    }
+    return std::nullopt;
+}
+
+// Transform one local BattleMon using the reviewed low-level native routine.
+// The higher-level command-79 wrapper queues an asynchronous event with a
+// temporary stack descriptor and expects a remote command consumer; invoking
+// it on a standalone battle leaves that event unconsumed and crashes next turn.
+inline NativeCallGate::Request formRequest(const Selection& selection, uint8_t form,
+                                           uint32_t targetBattleMon)
+{
+    return {TurnActionEntry, selection.flow, ChangeFormFunction,
+            {targetBattleMon, form, 0, 0}};
+}
+
+// Resolve the on-screen position through the game's own trainer/slot mapping.
+inline NativeCallGate::Request visualPositionRequest(const Selection& selection)
+{
+    return {TurnActionEntry, selection.flow, ResolveVisualPosition,
+            {selection.module, selection.module + 0xC8, selection.battleSlot, 0}};
+}
+
+// This is the native form-change visual task used by client command 79. Start
+// it directly without injecting another command into the battle wire stream.
+inline NativeCallGate::Request visualRequest(const Selection& selection, uint32_t position)
+{
+    return {TurnActionEntry, selection.flow, StartVisualChange,
+            {selection.view, position, 0, 0}};
+}
+
+class FormCall
+{
+public:
+    enum class State { Idle, Armed, Running, NativeAccepted, Canceled, Rejected, RecoveryRequired };
+    bool Arm(const uint8_t* ram, std::size_t size, uint32_t battleId,
+             Gen5MegaEvolution::BattleSession& battle)
+    {
+        if (state == State::Armed || state == State::Running) return false;
+        const auto module = findModule(ram, size);
+        const auto current = module ? activeSelection(ram, size, *module) : std::nullopt;
+        if (!current || !current->eligible() || !reviewedEntryPoints(ram, size) ||
+            !battle.begin(battleId) || battle.usedMega(Gen5MegaEvolution::Trainer(current->clientId)))
+            return false;
+        if (!gate.ClearCompletedCall()) return false;
+        entry = target = *current;
+        session = &battle;
+        remoteTarget = false;
+        remoteEvent = {};
+        clientFormApplied = false;
+        visualPositionResolved = visualRefreshStarted = false;
+        committedActionIndex.reset();
+        lastRejectReason = 0;
+        verifiedFormCopies = 0;
+        state = State::Armed;
+        event = {};
+        return true;
+    }
+    bool ArmRemote(const uint8_t* ram, std::size_t size,
+                   Gen5MegaEvolution::BattleSession& battle,
+                   const Gen5MegaEvolution::Event& announced)
+    {
+        if (state == State::Armed || state == State::Running ||
+            !reviewedEntryPoints(ram, size) || !battle.begin(announced.battleId)) return false;
+        const auto module = findModule(ram, size);
+        const auto current = module ? activeSelection(ram, size, *module) : std::nullopt;
+        if (!current || current->clientId == announced.trainer ||
+            battle.usedMega(Gen5MegaEvolution::Trainer(announced.trainer)) ||
+            !targetForEvent(ram, size, *current, announced) || !gate.ClearCompletedCall())
+            return false;
+        entry = *current;
+        target = *targetForEvent(ram, size, entry, announced);
+        session = &battle;
+        remoteTarget = true;
+        remoteEvent = announced;
+        clientFormApplied = false;
+        visualPositionResolved = visualRefreshStarted = false;
+        committedActionIndex.reset();
+        lastRejectReason = 0;
+        verifiedFormCopies = 0;
+        state = State::Armed;
+        event = {};
+        return true;
+    }
+    bool Cancel()
+    {
+        if (state != State::Armed) return false;
+        state = State::Canceled;
+        return true;
+    }
+    State GetState() const { return state; }
+    unsigned VerifiedFormCopies() const { return verifiedFormCopies; }
+    bool VisualRefreshStarted() const { return visualRefreshStarted; }
+    const Gen5MegaEvolution::Event& Event() const { return event; }
+    const Selection& Target() const { return target; }
+    const Selection& Entry() const { return entry; }
+    bool IsRemoteTarget() const { return remoteTarget; }
+    unsigned LastRejectReason() const { return lastRejectReason; }
+
+    template<class CPU>
+    void BeforeInstruction(CPU& cpu, const uint8_t* data, std::size_t size)
+    {
+        BeforeInstruction(cpu, data, size,
+            [](const Selection&) { return true; },
+            [](const Selection&) { return true; });
+    }
+
+    template<class CPU,class BeforeQueue>
+    void BeforeInstruction(CPU& cpu, const uint8_t* data, std::size_t size,
+                           BeforeQueue&& beforeQueue)
+    {
+        BeforeInstruction(cpu, data, size, std::forward<BeforeQueue>(beforeQueue),
+            [](const Selection&) { return true; });
+    }
+
+    template<class CPU,class BeforeQueue,class AfterQueue>
+    void BeforeInstruction(CPU& cpu, const uint8_t* data, std::size_t size,
+                           BeforeQueue&& beforeQueue, AfterQueue&& afterQueue)
+    {
+        const auto pc = cpu.R[15] - ((cpu.CPSR & 0x20) ? 2u : 4u);
+        if (state == State::Armed)
+        {
+            if (pc != TurnActionEntry || cpu.R[0] != entry.flow ||
+                (cpu.CPSR & 0x3F) != 0x3F || cpu.IRQ) return;
+            if (cpu.R[13] < 0x02000100 || cpu.R[13] > 0x03000000 || (cpu.R[13] & 3))
+            { lastRejectReason = 1; state = State::Rejected; return; }
+            const auto module = findModule(data, size);
+            const auto currentEntry = module ? activeSelection(data, size, *module) : std::nullopt;
+            const auto currentTarget = currentEntry
+                ? resolveCurrentTarget(data, size, *currentEntry, false) : std::nullopt;
+            if (!currentEntry || !currentTarget || !sameController(*currentEntry) ||
+                !sameBattler(*currentTarget) || !reviewedEntryPoints(data, size))
+            { lastRejectReason = 2; state = State::Rejected; return; }
+            // The game can clear or rewrite action-order entries after a
+            // faster battler acts. Capture our committed slot on the first
+            // turn-handler visit, while the complete order is still present,
+            // and keep it for the rest of this Mega transaction.
+            if (!committedActionIndex)
+                committedActionIndex = committedFightIndex(RAM(data, size), *currentTarget);
+            if (!committedActionIndex) { state = State::Canceled; return; }
+            // TurnActionEntry is called once for each action-order slot. Defer
+            // the form change until this battler's own committed Fight slot;
+            // applying it at index zero can corrupt a faster opponent's action.
+            if (cpu.R[1] != *committedActionIndex) return;
+            if (!beforeQueue(*currentTarget))
+            { lastRejectReason = 3; state = State::Rejected; return; }
+            // Revalidate the owner at instruction entry, never redirect CPUs
+            // from a frame boundary or execute an uncommitted menu choice.
+            const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(target.species, target.stone);
+            if (!profile || !gate.Queue(formRequest(*currentEntry, profile->megaForm,
+                                                   target.serverMon)))
+            { lastRejectReason = 4; state = State::Rejected; return; }
+            // This runs after call setup succeeds but before emulation reaches
+            // the native handler; failure enters transaction recovery.
+            if (!afterQueue(target))
+            { lastRejectReason = 5; state = State::RecoveryRequired; return; }
+            state = State::Running;
+        }
+        if (state != State::Running) return;
+        auto revalidate = [&](const auto&, const auto& gateCPU) {
+            // The first reviewed native call transforms the server-side copy;
+            // the client copy follows immediately after that call returns.
+            // During that short in-flight window, both copies must still be a
+            // valid base/Mega pairing for this exact species.
+            const auto currentEntry = activeSelection(data, size, entry.module, true);
+            const auto currentTarget = currentEntry
+                ? resolveCurrentTarget(data, size, *currentEntry, true) : std::nullopt;
+            if (!currentEntry) { lastRejectReason = 70; return false; }
+            if (!currentTarget) { lastRejectReason = 76; return false; }
+            if (!sameController(*currentEntry)) { lastRejectReason = 71; return false; }
+            if (!sameBattler(*currentTarget, true)) { lastRejectReason = 72; return false; }
+            if (!reviewedEntryPoints(data, size)) { lastRejectReason = 73; return false; }
+            if (!committedActionIndex) { lastRejectReason = 74; return false; }
+            if (gateCPU.R[1] != *committedActionIndex) { lastRejectReason = 75; return false; }
+            lastRejectReason = 0;
+            return true;
+        };
+        gate.BeforeInstruction(cpu, revalidate);
+        if (gate.GetState() == NativeCallGate::State::Rejected)
+        { state = State::Rejected; return; }
+        if (gate.GetState() != NativeCallGate::State::Complete) return;
+        const RAM ram(data, size);
+        const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(target.species, target.stone);
+        if (!profile || !ram.valid(target.serverMon, 0x142) ||
+            ram.byte(target.serverMon + 0x141) != profile->megaForm)
+        { lastRejectReason = 80; state = State::RecoveryRequired; return; }
+        verifiedFormCopies = std::max(verifiedFormCopies, 1u);
+        if (!clientFormApplied && target.clientMon != target.serverMon)
+        {
+            if (!gate.ClearCompletedCall() ||
+                !gate.Queue(formRequest(target, profile->megaForm, target.clientMon)))
+            { lastRejectReason = 81; state = State::RecoveryRequired; return; }
+            clientFormApplied = true;
+            gate.BeforeInstruction(cpu, revalidate);
+            if (gate.GetState() == NativeCallGate::State::Rejected)
+            {
+                lastRejectReason = lastRejectReason ? lastRejectReason : 82;
+                state = State::Rejected;
+            }
+            return;
+        }
+        if (!ram.valid(target.clientMon, 0x142) ||
+            ram.byte(target.clientMon + 0x141) != profile->megaForm)
+        { lastRejectReason = 83; state = State::RecoveryRequired; return; }
+        verifiedFormCopies = 2;
+        if (!visualPositionResolved)
+        {
+            if (!gate.ClearCompletedCall() || !gate.Queue(visualPositionRequest(target)))
+            { lastRejectReason = 84; state = State::RecoveryRequired; return; }
+            visualPositionResolved = true;
+            gate.BeforeInstruction(cpu, revalidate);
+            if (gate.GetState() == NativeCallGate::State::Rejected)
+            { lastRejectReason = 85; state = State::RecoveryRequired; }
+            return;
+        }
+        if (!visualRefreshStarted)
+        {
+            const auto position = gate.Result();
+            if (position >= 6 || !gate.ClearCompletedCall() ||
+                !gate.Queue(visualRequest(target, position)))
+            { lastRejectReason = 86; state = State::RecoveryRequired; return; }
+            visualRefreshStarted = true;
+            gate.BeforeInstruction(cpu, revalidate);
+            if (gate.GetState() == NativeCallGate::State::Rejected)
+            { lastRejectReason = 87; state = State::RecoveryRequired; }
+            return;
+        }
+        if (remoteTarget)
+        {
+            const auto received = session->receive(remoteEvent);
+            if (received == Gen5MegaEvolution::Result::Rejected)
+            { state = State::RecoveryRequired; return; }
+            event = remoteEvent;
+        }
+        else
+        {
+            const auto activation = session->activate(Gen5MegaEvolution::Trainer(target.clientId),
+                target.partySlot, target.species, target.stone, target.form, true);
+            if (activation.result != Gen5MegaEvolution::Result::Accepted)
+            { state = State::RecoveryRequired; return; }
+            event = activation.event;
+        }
+        state = State::NativeAccepted;
+    }
+private:
+    std::optional<Selection> resolveCurrentTarget(
+        const uint8_t* data, std::size_t size, const Selection& currentController,
+        bool allowMegaFormTransition) const
+    {
+        if (remoteTarget)
+            return targetForEvent(data, size, currentController, remoteEvent,
+                                  allowMegaFormTransition);
+        return currentLocalTarget(data, size, currentController, target,
+                                  allowMegaFormTransition);
+    }
+    bool sameController(const Selection& current) const
+    {
+        return current.module == entry.module && current.server == entry.server &&
+               current.flow == entry.flow && current.client == entry.client &&
+               current.view == entry.view && current.clientId == entry.clientId;
+    }
+    bool sameBattler(const Selection& current, bool allowMegaForm = false) const
+    {
+        const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(target.species, target.stone);
+        const bool formMatches = current.form == target.form || (allowMegaForm && profile &&
+            current.form == profile->megaForm);
+        return current.module == target.module && current.clientId == target.clientId &&
