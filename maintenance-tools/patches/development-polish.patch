+inline constexpr uint32_t TurnActionEntry = 0x0219F9D0;
+inline constexpr uint32_t ActionCountOffset = 0x782;
+inline constexpr uint32_t ActionOrderOffset = 0x7E0;
+inline constexpr uint32_t ActionOrderSize = 16;
+inline constexpr uint32_t ChangeFormFunction = 0x021BBED9;
+inline constexpr uint32_t ChangeFormCommandDispatch = 0x021AE2B0;
+inline constexpr uint32_t ChangeFormCommandHandler = 0x021B89CC;
+inline constexpr uint32_t ResolveVisualPosition = 0x0219C62D;
+inline constexpr uint32_t StartVisualChange = 0x021D0461;
