+        ram.half(serverMon + 0x0C) != event.species ||
+        ram.half(clientMon + 0x12) != event.stone ||
+        ram.half(serverMon + 0x12) != event.stone ||
+        (!matchingBaseForms && !inFlightMegaPair) ||
+        ram.half(serverMon + 0x10) != hp || !hp || !maxHP || hp > maxHP ||
+        ram.half(serverMon + 0x0E) != maxHP || ram.byte(serverMon + 0x1B) != flags ||
