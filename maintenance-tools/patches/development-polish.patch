+            result={{"ok",false},{"reason","Finish the pending trade before changing the bag"}};
+            return;
+        }
+        auto& nds=*emuInstance->nds;
+        if(!nativeCoopRuntime.AllowsItemAccess(nds)) {
+            result={{"ok",false},{"reason","Finish the co-op encounter before changing items"}};
+            return;
+        }
+        const auto inventory=ItemTrading::Inventory(nds,itemNames,itemRomIdentity);
+        if(!inventory.value("ok").toBool()) {
+            result={{"ok",false},{"reason",inventory.value("reason").toString()}};
+            return;
+        }
+        const auto bag=inventory.value("bag").toByteArray();
+        const auto types=inventory.value("types").toByteArray();
+        constexpr int itemPocketSlots=310;
+        constexpr int entrySize=4;
+        bool alreadyOwned=false;
+        int ownedQuantity=0;
+        for(int slot=0;slot<itemPocketSlots;++slot) {
+            const int offset=slot*entrySize;
