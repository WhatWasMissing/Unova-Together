+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+
+#include <QImage>
+#include <QList>
+#include <QTransform>
+
+// Place native ROM poses on one fixed canvas without modifying their pixels.
+// Source poses can have different transparent margins despite sharing the
+// same texture size. Align visible pixels by their opaque bounds so changing
+// poses cannot make the whole Pokémon slide vertically inside the canvas.
+// Some ROMs store three directions (the fourth is mirrored); others store all
+// four. The repeated third pose preserves the game's two-pose walk cycle.
+inline QList<QImage> NormalizeFollowerSpriteFrames(const QList<QImage>& source)
+{
+    if(source.size()!=6 && source.size()!=8) return {};
+
+    int canvasWidth=32,canvasHeight=32;
+    struct Bounds { int left,top,right,bottom; };
+    QList<Bounds> bounds;
+    bounds.reserve(source.size());
+    for(const auto& image:source) {
+        if(image.isNull()) return {};
+        canvasWidth=qMax(canvasWidth,image.width());
+        canvasHeight=qMax(canvasHeight,image.height());
+        int left=image.width(),top=image.height(),right=-1,bottom=-1;
+        for(int y=0;y<image.height();++y) for(int x=0;x<image.width();++x)
+            if(qAlpha(image.pixel(x,y))>0) {
+                left=qMin(left,x);top=qMin(top,y);
+                right=qMax(right,x);bottom=qMax(bottom,y);
+            }
+        if(right<left || bottom<top) return {};
+        bounds.append({left,top,right+1,bottom+1});
+    }
+    canvasHeight+=2; // transparent headroom for floating or legless poses
+
+    QList<QImage> normalized;
+    normalized.reserve(source.size());
+    for(int i=0;i<source.size();++i) {
+        const auto& image=source[i];
+        const auto& box=bounds[i];
+        QImage canvas(canvasWidth,canvasHeight,QImage::Format_ARGB32);
+        canvas.fill(Qt::transparent);
+        const int visibleWidth=box.right-box.left;
+        const int targetLeft=(canvasWidth-visibleWidth)/2;
+        const int left=targetLeft-box.left;
+        const int top=canvasHeight-box.bottom;
+        for(int y=0;y<image.height();++y)
+            for(int x=0;x<image.width();++x) {
+                const int targetX=left+x,targetY=top+y;
+                if(targetX<0 || targetX>=canvasWidth || targetY<0 || targetY>=canvasHeight) continue;
+                const auto pixel=image.pixel(x,y);
+                if(qAlpha(pixel)>0) canvas.setPixel(targetX,targetY,pixel);
+            }
+        normalized.append(canvas);
+    }
+
+    QList<QImage> frames;
+    frames.reserve(12);
+    for(unsigned direction=0;direction<4;++direction) {
+        const unsigned sourceDirection=direction==3 && source.size()==6?2:direction;
+        for(unsigned pose:{0u,1u,1u}) {
+            auto image=normalized[int(sourceDirection*2+pose)];
+            if(direction==3 && source.size()==6) image=image.transformed(QTransform().scale(-1,1));
+            frames.append(image);
+        }
+    }
+    return frames;
+}
