+void LAN::ClearCoopMegaSync()
+{
+    CoopMegaSeats.reset();
+    while(!CoopMegaEvents.empty()) CoopMegaEvents.pop();
+}
+
+void LAN::SendCoopMegaHello()
+{
+    if(!Active || !Host || !CoopMegaSeats.localHelloPending() || !CoopPeer ||
+       CoopPeer->state!=ENET_PEER_STATE_CONNECTED) return;
+    std::lock_guard<std::recursive_mutex> guard(NetworkMutex);
+    CoopMegaPacket::HelloPacket data{};
+    if(!CoopMegaPacket::encodeHello(CoopMegaSeats.battleId(),CoopMegaSeats.localSeat(),data)) return;
+    auto* packet=enet_packet_create(data.data(),data.size(),ENET_PACKET_FLAG_RELIABLE);
+    if(!packet) return;
+    if(enet_peer_send(CoopPeer,Chan_Cmd,packet)!=0) {
+        enet_packet_destroy(packet);
+        return;
+    }
+    enet_host_flush(Host);
+    CoopMegaSeats.markLocalHelloSent();
+}
+
+bool LAN::BeginCoopMegaSync(u32 battleId,u8 nativeClientId)
+{
+    if(nativeClientId>=4 || !battleId || battleId!=CoopChallengeToken() ||
+       !Active || !CoopPeer || CoopPeer->state!=ENET_PEER_STATE_CONNECTED) return false;
+    std::lock_guard<std::recursive_mutex> guard(NetworkMutex);
+    if(!CoopMegaSeats.begin(battleId,nativeClientId)) return false;
+    if(CoopMegaSeats.localHelloPending()) SendCoopMegaHello();
+    return true;
+}
+
+bool LAN::CoopMegaSyncReady() const
+{
+    return CoopChallengeStatus()==1 && CoopMegaSeats.ready(CoopChallengeToken());
+}
+
+int LAN::CoopMegaPartnerClientId() const
+{
+    return CoopMegaSyncReady() ? CoopMegaSeats.remoteSeat() : -1;
+}
+
+void LAN::ReceiveCoopMega(ENetEvent& event)
+{
+    auto* player=static_cast<Player*>(event.peer->data);
+    if(event.channelID!=Chan_Cmd || !player || event.peer!=CoopPeer ||
+       (player->Status!=Player_Client && player->Status!=Player_Host) ||
+       CoopChallengeStatus()!=1) return;
+    const auto* data=event.packet->data;
+    const auto length=event.packet->dataLength;
+    if(length<6 || data[0]!=Cmd_CoopMegaEvolution || coopWord(data+2)!=CoopChallengeToken()) return;
+    const u8 kind=data[1];
+    if(kind==0) {
+        u8 remoteSeat=0xff;
+        if(!CoopMegaPacket::decodeHello(data,length,CoopChallengeToken(),
+            CoopMegaSeats.localSeat(),remoteSeat) ||
+           !CoopMegaSeats.receiveHello(CoopChallengeToken(),remoteSeat)) return;
+        return;
+    }
+    if(kind!=1 || !CoopMegaSyncReady()) return;
+    CoopMegaPacket::EventPayload payload{};
+    if(!CoopMegaPacket::decodeEvent(data,length,CoopMegaSeats.battleId(),
+        CoopMegaSeats.localSeat(),CoopMegaSeats.remoteSeat(),payload)) return;
+    // The battle rule permits one Mega per trainer, so a paired peer can
+    // legitimately announce at most one transformation in this battle.
+    if(!CoopMegaEvents.empty()) return;
+    CoopMegaEvents.push(payload);
+}
+
+bool LAN::SendCoopMegaEvent(const std::array<u8,24>& event)
+{
+    if(!CoopMegaSyncReady()) return false;
+    std::lock_guard<std::recursive_mutex> guard(NetworkMutex);
+    CoopMegaPacket::EventPacket data{};
+    if(!CoopMegaPacket::encodeEvent(CoopMegaSeats.battleId(),event,
+        CoopMegaSeats.localSeat(),data)) return false;
+    auto* packet=enet_packet_create(data.data(),data.size(),ENET_PACKET_FLAG_RELIABLE);
+    if(!packet || !CoopPeer || CoopPeer->state!=ENET_PEER_STATE_CONNECTED) {
+        if(packet) enet_packet_destroy(packet);
+        return false;
+    }
+    if(enet_peer_send(CoopPeer,Chan_Cmd,packet)!=0) {
+        enet_packet_destroy(packet);
+        return false;
+    }
+    enet_host_flush(Host);
+    return true;
+}
+
+bool LAN::PopCoopMegaEvent(std::array<u8,24>& event)
+{
+    if(!CoopMegaSyncReady() || CoopMegaEvents.empty()) return false;
+    event=CoopMegaEvents.front();CoopMegaEvents.pop();
+    return true;
+}
