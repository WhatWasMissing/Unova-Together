+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+
+#include <QString>
+
+namespace NativeMenuSounds {
+enum class Cue { None, Navigation, Confirm, Cancel };
+
+// Keep added menu feedback aligned with Black 2/White 2's standard menu roles.
+constexpr Cue cueForInput(unsigned pressed, bool confirmEnabled = true)
+{
+    if (pressed & ((1u << 1) | (1u << 10))) return Cue::Cancel; // B / X
+    if (confirmEnabled && (pressed & 1u)) return Cue::Confirm; // A
+    if (pressed & ((1u << 4) | (1u << 5) | (1u << 6) | (1u << 7) |
+                   (1u << 8) | (1u << 9))) return Cue::Navigation; // D-pad / L-R
+    return Cue::None;
+}
+
+inline Cue cueForAction(const QString& action)
+{
+    if (action == "close" || action == "cancel" || action.startsWith("cancel") ||
+        action.endsWith("Back") || action.endsWith("Cancel") || action == "decline" ||
+        action == "declineBoss" || action == "declineRequest")
+        return Cue::Cancel;
+    return Cue::Confirm;
+}
+}
