+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+#include "NativeCallGate.h"
+#include <array>
+#include <cstdint>
+
+namespace FieldWarpCall {
+// Pokemon Black 2's decomp maps these symbols in overlay 35. Its Fly script
+// chains EventMapChangeWarp_CreateGrid after loading a ZoneSpawnInfo; field warp
+// uses the same event with its selected clear-ground position.
+inline constexpr uint32_t GsysUpdate = 0x020169A8;
+inline constexpr uint32_t EventMapChangeWarpCreateGrid = 0x0217DB41;
+
+inline NativeCallGate::Request make(uint32_t gameSystem, uint32_t field,
+                                    uint16_t zone, uint32_t x, uint32_t y,
+                                    uint32_t z)
+{
+    NativeCallGate::Request call{
+        GsysUpdate, gameSystem, EventMapChangeWarpCreateGrid,
+        {gameSystem, field, zone, 0}};
+    // Thumb ABI: direction and unk40 are stack args 5/6. The VecFx32 pointer
+    // in r3 points at the following three words.
+    call.stackArgumentCount = 5;
+    call.stackPointerArgument = 3;
+    call.stackPointerOffset = 8;
+    call.stackArguments = {0, 0, x, y, z};
+    return call;
+}
+} // namespace FieldWarpCall
