+// Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace melonDS::CoopMegaPacket {
+using EventPayload = std::array<uint8_t, 24>;
+using HelloPacket = std::array<uint8_t, 7>;
+using EventPacket = std::array<uint8_t, 30>;
+
+inline constexpr uint8_t Command = 7;
+inline constexpr uint8_t Hello = 0;
+inline constexpr uint8_t Event = 1;
+
+inline uint32_t read32(const uint8_t* data)
+{
+    return uint32_t(data[0]) | (uint32_t(data[1]) << 8) |
+           (uint32_t(data[2]) << 16) | (uint32_t(data[3]) << 24);
+}
+
+inline void write32(uint8_t* data, uint32_t value)
+{
+    data[0] = uint8_t(value); data[1] = uint8_t(value >> 8);
+    data[2] = uint8_t(value >> 16); data[3] = uint8_t(value >> 24);
+}
+
+inline bool validInnerEvent(const EventPayload& payload, uint32_t battleId,
+                            uint8_t expectedTrainer)
+{
+    return payload[0] == 'M' && payload[1] == 'E' && payload[2] == 'G' &&
+           payload[3] == 'A' && payload[4] == 2 && payload[5] == expectedTrainer &&
+           payload[9] == 0 && payload[14] == 0 && payload[15] == 0 &&
+           read32(payload.data() + 16) == battleId &&
+           read32(payload.data() + 20) == 1;
+}
+
+inline bool encodeHello(uint32_t battleId, uint8_t seat, HelloPacket& packet)
+{
+    if (!battleId || seat >= 4) return false;
+    packet = {};
+    packet[0] = Command; packet[1] = Hello;
+    write32(packet.data() + 2, battleId); packet[6] = seat;
+    return true;
+}
+
+inline bool decodeHello(const uint8_t* data, std::size_t length, uint32_t battleId,
+                        uint8_t localSeat, uint8_t& remoteSeat)
+{
+    if (!data || length != 7 || data[0] != Command || data[1] != Hello ||
+        !battleId || read32(data + 2) != battleId || data[6] >= 4 ||
+        (localSeat < 4 && data[6] == localSeat)) return false;
+    remoteSeat = data[6];
+    return true;
+}
+
+inline bool encodeEvent(uint32_t battleId, const EventPayload& payload,
+                        uint8_t senderSeat, EventPacket& packet)
+{
+    if (!battleId || senderSeat >= 4 || !validInnerEvent(payload, battleId, senderSeat))
+        return false;
+    packet = {};
+    packet[0] = Command; packet[1] = Event;
+    write32(packet.data() + 2, battleId);
+    for (std::size_t i = 0; i < payload.size(); ++i) packet[6 + i] = payload[i];
+    return true;
+}
+
+inline bool decodeEvent(const uint8_t* data, std::size_t length, uint32_t battleId,
+                        uint8_t localSeat, uint8_t remoteSeat, EventPayload& payload)
+{
+    if (!data || length != 30 || data[0] != Command || data[1] != Event ||
+        !battleId || read32(data + 2) != battleId || localSeat >= 4 ||
+        remoteSeat >= 4 || remoteSeat == localSeat) return false;
+    EventPayload candidate{};
+    for (std::size_t i = 0; i < candidate.size(); ++i) candidate[i] = data[6 + i];
+    if (!validInnerEvent(candidate, battleId, remoteSeat)) return false;
+    payload = candidate;
+    return true;
+}
+
+class SeatHandshake
+{
+public:
+    bool begin(uint32_t battleId, uint8_t localSeat)
+    {
+        if (!battleId || localSeat >= 4 || (id && id != battleId) ||
+            (local < 4 && local != localSeat) || (remote < 4 && remote == localSeat))
+            return false;
+        id = battleId;
+        local = localSeat;
+        return true;
+    }
+
+    bool receiveHello(uint32_t battleId, uint8_t remoteSeat)
+    {
+        if (!battleId || remoteSeat >= 4 || (id && id != battleId) ||
+            (local < 4 && local == remoteSeat) || (remote < 4 && remote != remoteSeat))
+            return false;
+        id = battleId;
+        remote = remoteSeat;
+        received = true;
+        return true;
+    }
+
+    bool localHelloPending() const { return id && local < 4 && !sent; }
+    void markLocalHelloSent() { if (localHelloPending()) sent = true; }
+    bool ready(uint32_t battleId) const
+    {
+        return id && id == battleId && local < 4 && remote < 4 && local != remote &&
+               sent && received;
+    }
+    uint32_t battleId() const { return id; }
+    uint8_t localSeat() const { return local; }
+    uint8_t remoteSeat() const { return remote; }
+    void reset() { id = 0; local = remote = 0xff; sent = received = false; }
+
+private:
+    uint32_t id = 0;
+    uint8_t local = 0xff, remote = 0xff;
+    bool sent = false, received = false;
+};
+}
