+            !slotArrayAddress || !inRam(slotArrayAddress, BattleSpriteCount * 4) ||
+            !ramWord(ram, size, address + McssTextureBaseOffset, textureBase) ||
+            textureBase >= 512 * 1024 || textureBase % McssTextureSize)
