+        return result;
+    } catch(const std::exception&) {return {};}
+}
+inline std::vector<melonDS::ROMAssetPatch> patches(const uint8_t* data, std::size_t length) {
+    return patches(data, length, std::array<uint16_t, 0>{});
+}
