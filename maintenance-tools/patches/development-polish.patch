+    std::array<int8_t, 6> statDelta,
+    uint8_t conversionType = 0xFF, uint16_t conversionRatio = 0x1000)
+{
+    const auto* base = reduxBase(species);
+    if (!base) throw "Mega roster is missing the Redux base record";
+    std::array<uint8_t, 6> stats{};
+    for (std::size_t i = 0; i < stats.size(); ++i)
+    {
+        const int value = int(base->stats[i]) + int(statDelta[i]);
+        if (value < 1 || value > 255) throw "Mega stat is outside the cartridge range";
+        stats[i] = uint8_t(value);
+    }
+    return {species, stone, 0, form, stats, type1, type2, ability, ability, ability,
+        stoneName, pokemonName, 0, base->stats, base->type1, base->type2,
+        base->ability1, base->ability2, base->abilityH, conversionType, conversionRatio};
+}
