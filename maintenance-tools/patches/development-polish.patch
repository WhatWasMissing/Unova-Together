+    const auto maxHP = ram.half(clientMon + 0x0E);
+    const auto flags = ram.byte(clientMon + 0x1B);
+    const auto clientForm = ram.byte(clientMon + 0x141);
+    const auto serverForm = ram.byte(serverMon + 0x141);
+    const bool matchingBaseForms = clientForm == event.fromForm && serverForm == event.fromForm;
+    const bool inFlightMegaPair = allowMegaFormTransition &&
+        (clientForm == event.fromForm || clientForm == event.toForm) &&
+        (serverForm == event.fromForm || serverForm == event.toForm);
