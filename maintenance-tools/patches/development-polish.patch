+        [species, form](const MegaProfile& profile) {
+            return profile.species == species && profile.megaForm == form;
+        });
+    return found == SupportedProfiles.end() ? nullptr : &*found;
+}
+
+inline const MegaProfile* profileForStone(uint16_t stone)
+{
+    const auto found = std::find_if(SupportedProfiles.begin(), SupportedProfiles.end(),
+        [stone](const MegaProfile& profile) { return profile.stone == stone; });
+    if (found != SupportedProfiles.end()) return &*found;
+    const auto alias = std::find_if(LegacyStoneAliases.begin(), LegacyStoneAliases.end(),
+        [stone](const LegacyStoneAlias& value) { return value.stone == stone; });
+    return alias == LegacyStoneAliases.end() ? nullptr :
+        profileForSpeciesForm(alias->species, alias->form);
