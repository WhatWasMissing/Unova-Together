+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+
+namespace PokemonTrainerMoney {
+inline constexpr std::uint32_t RamBase = 0x02000000;
+inline constexpr std::size_t RamSize = 0x400000;
+inline constexpr std::uint32_t TrainerGameInfoBlock = 0x34;
+inline constexpr std::uint32_t SaveBlockCount = 0x49;
+inline constexpr std::uint32_t TrainerInfoSize = 0xf0;
+inline constexpr std::uint32_t CashMaximum = 9999999;
+
+inline std::uint32_t read32(const std::uint8_t* ram, std::size_t size,
+                            std::uint32_t address)
+{
+    if (address < RamBase || (address & 3) || size > RamSize ||
+        address - RamBase > size || 4 > size - (address - RamBase))
+        throw std::runtime_error("Invalid trainer-save pointer");
+    const auto* data = ram + (address - RamBase);
+    return std::uint32_t(data[0]) | (std::uint32_t(data[1]) << 8) |
+           (std::uint32_t(data[2]) << 16) | (std::uint32_t(data[3]) << 24);
+}
+
+inline bool validRange(std::uint32_t address, std::uint32_t length,
+                       std::size_t size)
+{
+    return address >= RamBase && !(address & 3) && size <= RamSize &&
+           length <= size && address - RamBase <= size - length;
+}
+
+// Layout and block IDs follow the BW2 decomp:
+// system/game_data.c (GameData::saveControl), save/save_control.h
+// (SaveControl::sv), gfl/backup_system.c (SaveData), gfl/savedata.c
+// (SaveDataTable/SaveBlockInfo), and save/trainer_game_info.h.
+inline std::uint32_t findCashAddress(const std::uint8_t* ram,
+                                     std::size_t size,
+                                     std::uint32_t gameDataAddress)
+{
+    if (!ram || size != RamSize || !validRange(gameDataAddress, 4, size))
+        throw std::runtime_error("Trainer save is unavailable");
+    const auto saveControl = read32(ram, size, gameDataAddress);
+    if (!validRange(saveControl, 0x14, size))
+        throw std::runtime_error("Trainer save is unavailable");
+    const auto saveData = read32(ram, size, saveControl + 0x10);
+    if (!validRange(saveData, 0x38, size))
+        throw std::runtime_error("Trainer save is unavailable");
+    const auto table = read32(ram, size, saveData + 0x2c);
+    if (!validRange(table, 0x18, size) ||
+        read32(ram, size, table + 4) != SaveBlockCount)
+        throw std::runtime_error("Unsupported trainer-save table");
+    const auto blocks = read32(ram, size, table + 0x14);
+    if (!validRange(blocks, SaveBlockCount * 12, size))
+        throw std::runtime_error("Invalid trainer-save block table");
+    const auto trainerBlock = blocks + TrainerGameInfoBlock * 12;
+    if (read32(ram, size, trainerBlock) != TrainerGameInfoBlock)
+        throw std::runtime_error("Trainer money block is unavailable");
+    const auto blockSize = read32(ram, size, trainerBlock + 4);
+    const auto blockOffset = read32(ram, size, trainerBlock + 8);
+    const auto saveSize = read32(ram, size, saveData + 0x30);
+    const auto saveBytes = read32(ram, size, saveData + 0x34);
+    if (blockSize < TrainerInfoSize || blockOffset > saveSize ||
+        blockSize > saveSize - blockOffset ||
+        !validRange(saveBytes, saveSize, size) || blockOffset > size ||
+        !validRange(saveBytes + blockOffset, blockSize, size))
+        throw std::runtime_error("Invalid trainer money block");
+    const auto cashAddress = saveBytes + blockOffset;
+    if (read32(ram, size, cashAddress) > CashMaximum)
+        throw std::runtime_error("Trainer money data is invalid");
+    return cashAddress;
+}
+}
