+    if ((mon & 3) || !valid(mon, 0x142)) return;
+    const u32 source = word(mon);
+    if (!valid(source, Gen5MegaPartyData::PartyRecordSize)) return;
+    const auto identity = Gen5MegaPartyData::inspect(
+        nds.MainRAM + source - 0x02000000, Gen5MegaPartyData::PartyRecordSize);
+    if (!identity) return;
+    const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(identity->species, identity->heldItem);
+    if (!profile || identity->heldItem != profile->stone ||
+        (identity->form != profile->megaForm && identity->form != profile->baseForm) ||
+        (byte(mon + 0x1B) & 0x1F) != profile->baseForm)
