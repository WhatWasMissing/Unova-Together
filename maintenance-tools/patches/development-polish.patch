+/* Unova Together: Copyright (C) 2026 mvq1303. GPL-3.0-or-later. */
+#pragma once
+
+/* Native BW2 uses mode 1 for a child searching for a parent and mode 2 for
+ * the parent advertising a group. The launcher-facing pairing roles use the
+ * opposite host/guest vocabulary, so keep the translation explicit. */
+enum {
+    UNOVA_COOP_ROLE_HOST = 1,
+    UNOVA_COOP_ROLE_GUEST = 2,
+    UNOVA_BW2_NET_MODE_CHILD = 1,
+    UNOVA_BW2_NET_MODE_PARENT = 2,
+};
+
+static inline unsigned unovaCoopNativeModeForRole(unsigned role)
+{
+    if (role == UNOVA_COOP_ROLE_HOST) return UNOVA_BW2_NET_MODE_PARENT;
+    if (role == UNOVA_COOP_ROLE_GUEST) return UNOVA_BW2_NET_MODE_CHILD;
+    return 0;
+}
+
+static inline int unovaCoopShouldRetryGuestDiscovery(unsigned desiredMode,
+    unsigned activeMode, unsigned groupIndex, unsigned alreadyRetried)
+{
+    return desiredMode == UNOVA_BW2_NET_MODE_CHILD &&
+        activeMode == UNOVA_BW2_NET_MODE_PARENT && groupIndex == 0 &&
+        !alreadyRetried;
+}
