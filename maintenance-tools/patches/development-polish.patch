+inline uint16_t read16(const std::vector<uint8_t>& bytes, std::size_t offset)
+{
+    return uint16_t(bytes.at(offset) | (uint16_t(bytes.at(offset + 1)) << 8));
+}
+
+inline void write16(std::vector<uint8_t>& bytes, std::size_t offset, uint16_t value)
+{
+    bytes.at(offset) = uint8_t(value);
+    bytes.at(offset + 1) = uint8_t(value >> 8);
+}
+
+inline bool patchStoryTeams(Gen5ShopPolicy::Narc& trainerData,
+                            Gen5ShopPolicy::Narc& trainerParties)
+{
+    // Work on copies so a mismatch in a later leader leaves both archives
+    // untouched and the caller can safely keep the rest of the Mega overlay.
+    auto patchedData = trainerData;
+    auto patchedParties = trainerParties;
+
+    for (const auto& leader : StoryLeaders)
+    {
+        if (leader.trainerId >= patchedData.files.size() ||
+            leader.trainerId >= patchedParties.files.size()) return false;
+        auto& record = patchedData.files[leader.trainerId];
+        const auto& originalParty = trainerParties.files[leader.trainerId];
+        if (record.size() != TrainerRecordSize || record[1] != leader.trainerClass ||
+            (record[0] & ~uint8_t(PartyMoves | PartyItems)) != 0 ||
+            !(record[0] & PartyMoves)) return false;
+
+        const auto count = record[3];
+        if (!count || count > 6) return false;
+        const auto oldKind = record[0];
+        const std::size_t oldEntrySize = PartyBaseSize +
+            ((oldKind & PartyItems) ? 2 : 0) + ((oldKind & PartyMoves) ? 8 : 0);
+        if (originalParty.size() != count * oldEntrySize) return false;
+
+        auto party = originalParty;
+        std::size_t selectedSlot = count;
+        for (std::size_t slot = 0; slot < count; ++slot)
+        {
+            const auto offset = slot * oldEntrySize;
+            const auto species = read16(party, offset + 4);
+            if (species == leader.sourceSpecies || species == leader.megaSpecies)
+            {
+                if (selectedSlot != count) return false;
+                selectedSlot = slot;
+            }
+        }
+        if (selectedSlot == count)
+        {
+            // Redux revisions can rebalance a leader's party. The verified
+            // trainer ID/class and stable party position still let the story
+            // battle receive its Mega ace without requiring an exact species
+            // lineup from the source decomp.
+            if (leader.fallbackSlot >= count) return false;
+            selectedSlot = leader.fallbackSlot;
+        }
+
+        const auto newKind = uint8_t(oldKind | PartyItems);
+        const auto newEntrySize = PartyBaseSize + 2 + ((newKind & PartyMoves) ? 8 : 0);
+        std::vector<uint8_t> rewritten;
+        rewritten.reserve(count * newEntrySize);
+        for (std::size_t slot = 0; slot < count; ++slot)
+        {
+            const auto oldOffset = slot * oldEntrySize;
+            std::array<uint8_t, PartyBaseSize> base{};
+            for (std::size_t i = 0; i < PartyBaseSize; ++i)
+                base[i] = party[oldOffset + i];
+            const auto newOffset = rewritten.size();
+            rewritten.insert(rewritten.end(), base.begin(), base.end());
+
+            std::size_t oldField = oldOffset + PartyBaseSize;
+            uint16_t heldItem = 0;
+            if (oldKind & PartyItems)
+            {
+                heldItem = read16(party, oldField);
+                oldField += 2;
+            }
+            if (slot == selectedSlot)
+            {
+                heldItem = leader.stone;
+                write16(rewritten, newOffset + 4, leader.megaSpecies);
+                write16(rewritten, newOffset + 6, 0);
+                // Unspecified gender and ability let the game select valid
+                // values for the replacement species.
+                rewritten[newOffset + 1] = 0;
+            }
+            rewritten.push_back(uint8_t(heldItem));
+            rewritten.push_back(uint8_t(heldItem >> 8));
+
+            if (slot == selectedSlot)
+            {
+                for (const auto move : leader.moves)
+                {
+                    rewritten.push_back(uint8_t(move));
+                    rewritten.push_back(uint8_t(move >> 8));
+                }
+            }
+            else
+                rewritten.insert(rewritten.end(), party.begin() + oldField,
+                                 party.begin() + oldField + 8);
+        }
+        if (rewritten.size() != count * newEntrySize) return false;
+        record[0] = newKind;
+        patchedParties.files[leader.trainerId] = std::move(rewritten);
+    }
+
+    trainerData = std::move(patchedData);
+    trainerParties = std::move(patchedParties);
+    return true;
+}
