+    bool repairLegacyBaseAbility(melonDS::NDS& liveCore,
+                                 const Gen5MegaBattle::Selection& target)
+    {
+        const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(target.species, target.stone);
+        const Gen5MegaBattle::RAM ram(liveCore.MainRAM, liveCore.MainRAMMask + 1);
+        if (!profile || target.form != profile->baseForm ||
+            !ram.object(target.clientMon, 0x142) || !ram.object(target.serverMon, 0x142))
+            return false;
+        const auto isBase = [&](uint16_t value) {
+            return value == profile->baseAbility1 || value == profile->baseAbility2 ||
+                   value == profile->baseAbilityH;
+        };
+        const auto clientBase = ram.half(target.clientMon + Gen5MegaBattle::BaseAbilityOffset);
+        const auto serverBase = ram.half(target.serverMon + Gen5MegaBattle::BaseAbilityOffset);
+        if (isBase(clientBase) && clientBase == serverBase) return true;
+
+        uint32_t savedRecord = 0;
+        try {
+            const auto liveRAM = QByteArray::fromRawData(
+                reinterpret_cast<const char*>(liveCore.MainRAM), liveCore.MainRAMMask + 1);
+            savedRecord = PokemonTrading::FindParty(liveRAM, false) + 8 +
+                target.partySlot * PokemonTrading::RecordSize;
+        } catch (...) { return false; }
+        struct Repair {
+            uint32_t address;
+            std::array<uint8_t, Gen5MegaPartyData::PartyRecordSize> bytes;
+        };
+        std::vector<Repair> repairs;
+        std::array<Gen5MegaPartyData::Identity, 3> identities{};
+        std::size_t identityCount = 0;
+        for (const auto address : {target.clientSource, target.serverSource, savedRecord})
+        {
+            const auto duplicate = std::find_if(repairs.begin(), repairs.end(),
+                [&](const Repair& repair) { return repair.address == address; });
+            if (duplicate != repairs.end())
+            {
+                const auto identity = Gen5MegaPartyData::inspect(
+                    duplicate->bytes.data(), duplicate->bytes.size());
+                if (!identity || identityCount >= identities.size()) return false;
+                identities[identityCount++] = *identity;
+                continue;
+            }
+            if (!ram.object(address, Gen5MegaPartyData::PartyRecordSize)) return false;
+            Repair repair{address, {}};
+            std::copy_n(liveCore.MainRAM + address - 0x02000000,
+                repair.bytes.size(), repair.bytes.begin());
+            const auto identity = Gen5MegaPartyData::inspect(repair.bytes.data(), repair.bytes.size());
+            if (!identity || identity->species != target.species ||
+                !Gen5MegaPartyData::isMatchingProfileStone(*profile, identity->heldItem) ||
+                identity->form != profile->baseForm ||
+                identityCount >= identities.size()) return false;
+            identities[identityCount++] = *identity;
+            // Restore only a known stale Mega ability (or leave an already
+            // correct base ability untouched). The record metadata validates
+            // the original slot before any copy is committed.
+            const auto restored = Gen5MegaPartyData::restoreBaseAbility(
+                repair.bytes.data(), repair.bytes.size(), *profile,
+                identity->baseAbility, true);
+            if (!restored) return false;
+            repairs.push_back(std::move(repair));
+        }
+        if (identityCount != identities.size()) return false;
+        const auto restoredAbility = Gen5MegaPartyData::verifiedBaseAbilityFromCopies(
+            *profile, identities);
+        if (!restoredAbility) return false;
+        // A switch-in may expose stale base-ability fields even though the
+        // owner's party copies still identify the correct original ability.
+        // Reconcile both battle mirrors only after every copy agrees on PID,
+        // stone, species, form and the ability slot inferred from Gen V data.
+        for (const auto& repair : repairs)
+            std::copy(repair.bytes.begin(), repair.bytes.end(),
+                liveCore.MainRAM + repair.address - 0x02000000);
+        for (const auto mon : {target.clientMon, target.serverMon})
+        {
+            qToLittleEndian<quint16>(*restoredAbility,
+                liveCore.MainRAM + mon - 0x02000000 + Gen5MegaBattle::BaseAbilityOffset);
+            auto* current = liveCore.MainRAM + mon - 0x02000000 +
+                Gen5MegaBattle::CurrentAbilityOffset;
+            const auto currentAbility = uint16_t(current[0] | (uint16_t(current[1]) << 8));
+            if (currentAbility <= 0xFF &&
+                Gen5MegaPartyData::isProfileMegaAbility(*profile, uint8_t(currentAbility)))
+                qToLittleEndian<quint16>(*restoredAbility, current);
+        }
+        legacyAbilityRepaired = true;
+        return true;
+    }
+    bool prepareMegaBattleAbility(const Gen5MegaBattle::Selection& target)
+    {
+        if (!core) return false;
+        const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(target.species, target.stone);
+        const Gen5MegaBattle::RAM ram(core->MainRAM, core->MainRAMMask + 1);
+        if (!profile || !ram.object(target.clientMon, 0x142) ||
+            !ram.object(target.serverMon, 0x142) ||
+            ram.half(target.clientMon + 0x0C) != target.species ||
+            ram.half(target.serverMon + 0x0C) != target.species ||
+            ram.byte(target.clientMon + 0x141) != profile->baseForm ||
+            ram.byte(target.serverMon + 0x141) != profile->baseForm)
+            return false;
+
+        // The selected ability slot belongs to the original Pokémon. A
+        // temporary battle effect may already have changed its active ability.
+        const auto baseAbility = ram.half(target.clientMon + Gen5MegaBattle::BaseAbilityOffset);
+        if (baseAbility != ram.half(target.serverMon + Gen5MegaBattle::BaseAbilityOffset)) return false;
+        const auto megaAbility = Gen5MegaBattle::megaAbilityForBaseAbility(*profile, baseAbility);
+        if (!megaAbility) return false;
+        const auto writeAbility = [&](uint32_t mon) {
+            auto* bytes = core->MainRAM + mon - 0x02000000 + Gen5MegaBattle::CurrentAbilityOffset;
+            bytes[0] = uint8_t(*megaAbility);
+            bytes[1] = uint8_t(*megaAbility >> 8);
+        };
+        writeAbility(target.clientMon);
+        writeAbility(target.serverMon);
+        return ram.half(target.clientMon + Gen5MegaBattle::CurrentAbilityOffset) == *megaAbility &&
+               ram.half(target.serverMon + Gen5MegaBattle::CurrentAbilityOffset) == *megaAbility;
+    }
+    bool captureBattleData()
+    {
+        if (battleData.captured || !core ||
+            call.GetState() != Gen5MegaBattle::FormCall::State::NativeAccepted)
+            return battleData.captured;
+        const auto& target = call.Target();
+        const auto* profile = Gen5MegaEvolution::profileForSpeciesAndStone(target.species, target.stone);
+        if (!profile) return false;
+        const Gen5MegaBattle::RAM ram(core->MainRAM, core->MainRAMMask + 1);
+        if (!ram.object(target.clientMon, 0x142) || !ram.object(target.serverMon, 0x142) ||
+            ram.half(target.clientMon + 0x0C) != target.species ||
+            ram.half(target.serverMon + 0x0C) != target.species ||
+            ram.byte(target.clientMon + 0x19) != target.battleSlot ||
+            ram.byte(target.serverMon + 0x19) != target.battleSlot ||
+            ram.byte(target.clientMon + 0x141) != profile->megaForm ||
+            ram.byte(target.serverMon + 0x141) != profile->megaForm)
+            return false;
+        const auto client = readMegaBattleStats(ram, target.clientMon);
+        const auto server = readMegaBattleStats(ram, target.serverMon);
+        formsAgreed = true;
+        if (fixtureOverrideSpecies == profile->species)
+            battleData.captureFixtureProfile(beforeClientBattle, beforeServerBattle,
+                                             client, server, *profile);
+        else
+            battleData.captureOnce(beforeClientBattle, beforeServerBattle, client, server, *profile);
+        status = battleData.verified ?
+            "Mega form, ability, and stat changes verified in both battle copies" :
+            "Mega form copies agree, but battle stat/ability verification failed";
+        if (battleData.verified)
+        {
+            checkpoint.clear();
+            ++pendingMegaEvolutionCues;
+        }
+        return true;
+    }
+    void finishBattle()
+    {
+        if (formsAgreed)
+        {
+            if (core && savedPartyRecord && savedPartyRecord >= 0x02000000 &&
+                savedPartyRecord - 0x02000000 + PokemonTrading::RecordSize <= core->MainRAMMask + 1)
+                savedPartyUnchanged = !std::memcmp(savedPartyBefore.data(),
+                    core->MainRAM + savedPartyRecord - 0x02000000, PokemonTrading::RecordSize);
+            battleEnded = true;
+            status = localRecoveryAttempt.Attempted() && localRecoveryAttempt.Recovered()
+                ? "Mega attempt was rolled back; battle ended and saved party record stayed unchanged"
+                : "Battle ended; saved party record stayed unchanged";
+        }
+        detach(); battle.end(); module = 0; checkpoint.clear();
+        clearBattleTransactions(true);
+    }
+    static void Boundary(melonDS::ARMv5& cpu, void* opaque)
+    {
+        auto& self = *static_cast<Impl*>(opaque);
+        const auto before = self.call.GetState();
+        const auto& target = self.call.Target();
+        const auto pc = cpu.R[15] - ((cpu.CPSR & 0x20) ? 2u : 4u);
+        if (self.fixtureDriving && self.nativeHandlerCompleted && !self.firstLowPC &&
+            pc >= 0x02000000 && pc < 0x02010000)
+        {
+            self.firstLowPC = pc;
+            self.firstLowPreviousPC = self.lastBoundaryPC;
+            std::copy_n(cpu.R, 16, self.firstLowRegisters.begin());
+            self.firstLowCPSR = cpu.CPSR;
+            self.firstLowCurInstr = cpu.CurInstr;
+        }
+        if (self.fixtureDriving && self.nativeHandlerCompleted && !self.fixtureErrorHandlerEntered)
+        {
+            auto& entry = self.postMegaTrace[self.postMegaTraceNext];
+            entry = {pc, cpu.R[14], cpu.R[13], cpu.CPSR, cpu.CurInstr,
+                     cpu.R[0], cpu.R[1], cpu.R[2], cpu.R[3]};
+            self.postMegaTraceNext = (self.postMegaTraceNext + 1) % self.postMegaTrace.size();
+            self.postMegaTraceCount = std::min<uint32_t>(self.postMegaTraceCount + 1,
+                uint32_t(self.postMegaTrace.size()));
+            if (!self.fixtureErrorHandlerEntered &&
+                (pc == 0x02012038 || pc == 0x02012048 || pc == 0x02005430))
+            {
+                self.fixtureErrorHandlerEntered = true;
+                self.fixtureErrorHandlerEntry = {pc, cpu.R[14], cpu.R[13], cpu.CPSR,
+                    cpu.CurInstr, cpu.R[0], cpu.R[1], cpu.R[2], cpu.R[3]};
+                for (uint32_t index = 0; index < self.fixtureErrorHandlerStack.size(); ++index)
+                    cpu.DataRead32(cpu.R[13] + index * 4, &self.fixtureErrorHandlerStack[index]);
+            }
+        }
+        ++self.boundaryVisits; self.lastBoundaryPC = pc;
+        if (pc == Gen5MegaBattle::ChangeFormCommandDispatch)
+            ++self.changeFormDispatchVisits;
+        if (pc == Gen5MegaBattle::ChangeFormCommandHandler)
+            ++self.changeFormCommandHandlerVisits;
+        if (pc == (Gen5MegaBattle::ChangeFormFunction & ~1u))
+            ++self.changeFormFunctionVisits;
+        if (pc == Gen5MegaBattle::FightSelect - 1 || pc == (Gen5MegaBattle::FightSelect & ~1u))
+            ++self.fightSelectVisits;
+        if (pc == Gen5MegaBattle::MoveInput - 1 || pc == (Gen5MegaBattle::MoveInput & ~1u))
+            ++self.moveInputVisits;
+        if (self.module && pc == Gen5MegaBattle::TurnActionEntry)
+        {
+            ++self.actionEntryVisits;
+            self.actionEntryR0 = cpu.R[0]; self.actionEntryR1 = cpu.R[1];
+            self.actionEntryCpsr = cpu.CPSR; self.actionEntryIrq = cpu.IRQ;
+            if (cpu.R[0] == target.flow && cpu.R[1] == 0)
+            {
+                ++self.matchingActionEntryVisits;
+                const Gen5MegaBattle::RAM ram(self.core->MainRAM, self.core->MainRAMMask + 1);
+                if (ram.object(target.flow, Gen5MegaBattle::ActionOrderOffset + 6 * Gen5MegaBattle::ActionOrderSize))
+                {
+                    self.actionEntryCount = ram.byte(target.flow + Gen5MegaBattle::ActionCountOffset);
+                    self.actionEntryFightCommitted = Gen5MegaBattle::committedFight(ram, target);
+                    self.actionEntryFirstType = self.actionEntryCount &&
+                        self.actionEntryCount <= 6 ? ram.word(target.flow + Gen5MegaBattle::ActionOrderOffset + 4) & 15 : 0;
+                    if (self.actionEntryFightCommitted && ram.object(target.clientMon, 0x142) &&
+                        ram.object(target.serverMon, 0x142))
+                    {
+                        self.beforeClientBattle = readMegaBattleStats(ram, target.clientMon);
+                        self.beforeServerBattle = readMegaBattleStats(ram, target.serverMon);
+                    }
+                }
+            }
+        }
+        if (before == Gen5MegaBattle::FormCall::State::Armed &&
+            pc == Gen5MegaBattle::TurnActionEntry &&
+            cpu.R[0] == target.flow && cpu.R[1] == 0)
+        {
+            const Gen5MegaBattle::RAM ram(self.core->MainRAM, self.core->MainRAMMask + 1);
+            if (ram.object(target.clientSource, 220) && ram.object(target.serverSource, 220))
+            {
+                std::memcpy(self.clientSource.data(), self.core->MainRAM + target.clientSource - 0x02000000, 220);
+                std::memcpy(self.serverSource.data(), self.core->MainRAM + target.serverSource - 0x02000000, 220);
+            }
+        }
+        self.call.BeforeInstruction(cpu, self.core->MainRAM, self.core->MainRAMMask + 1,
+            [&](const Gen5MegaBattle::Selection& current) {
+                if(!self.coopSyncExpected) return true;
+                if(melonDS::MPInterface::GetType()!=melonDS::MPInterface_LAN) return false;
+                auto& lan=static_cast<melonDS::LAN&>(melonDS::MPInterface::Get());
+                if(!lan.CoopMegaSyncReady() || lan.CoopChallengeToken()!=self.serial) return false;
+                const auto* profile=Gen5MegaEvolution::profileForSpeciesAndStone(current.species, current.stone);
+                if(!profile) return false;
+                const Gen5MegaEvolution::Event event{self.serial,1,current.clientId,current.partySlot,
+                    current.species,current.stone,profile->baseForm,profile->megaForm};
+                try {
+                    self.coopLocalEventSent=lan.SendCoopMegaEvent(Gen5MegaEvolution::encodeEvent(event));
+                } catch(...) { self.coopLocalEventSent=false; }
+                if(!self.coopLocalEventSent)
+                    self.status="Mega canceled because the paired battle could not queue its reliable event";
+                return self.coopLocalEventSent;
+            }, [&](const Gen5MegaBattle::Selection& current) {
+                return self.prepareMegaBattleAbility(current);
+            });
+        self.remoteCall.BeforeInstruction(cpu, self.core->MainRAM,
+            self.core->MainRAMMask + 1,
+            [](const Gen5MegaBattle::Selection&) { return true; },
+            [&](const Gen5MegaBattle::Selection& current) {
+                return self.prepareMegaBattleAbility(current);
+            });
+        if (before == Gen5MegaBattle::FormCall::State::Running &&
+            self.call.GetState() == Gen5MegaBattle::FormCall::State::NativeAccepted)
+        {
+            self.nativeHandlerCompleted = true;
+            self.nativeHandlerResult = self.call.GetState() == Gen5MegaBattle::FormCall::State::NativeAccepted;
+            const auto* client = self.core->MainRAM + target.clientSource - 0x02000000;
+            const auto* server = self.core->MainRAM + target.serverSource - 0x02000000;
+            self.sourcesUnchanged = true;
+            for (int i = 0; i < 220; ++i)
+            {
+                if (self.clientSource[i] != client[i] && self.clientSourceFirstDiff < 0)
+                { self.clientSourceFirstDiff = i; self.clientSourceBeforeDiff = self.clientSource[i]; self.clientSourceAfterDiff = client[i]; }
+                if (self.serverSource[i] != server[i] && self.serverSourceFirstDiff < 0)
+                { self.serverSourceFirstDiff = i; self.serverSourceBeforeDiff = self.serverSource[i]; self.serverSourceAfterDiff = server[i]; }
+                if (self.clientSource[i] != client[i]) self.clientSourceDiffs.append(QVariantMap{{"offset", i}, {"before", self.clientSource[i]}, {"after", client[i]}});
+                if (self.serverSource[i] != server[i]) self.serverSourceDiffs.append(QVariantMap{{"offset", i}, {"before", self.serverSource[i]}, {"after", server[i]}});
+            }
+            self.sourcesUnchanged = self.clientSourceFirstDiff < 0 && self.serverSourceFirstDiff < 0;
+            if (self.savedPartyRecord && self.savedPartyRecord >= 0x02000000 &&
+                self.savedPartyRecord - 0x02000000 + PokemonTrading::RecordSize <= self.core->MainRAMMask + 1)
+                self.savedPartyUnchanged = !std::memcmp(self.savedPartyBefore.data(),
+                    self.core->MainRAM + self.savedPartyRecord - 0x02000000, PokemonTrading::RecordSize);
+            self.captureBattleData();
+        }
+    }
+    bool restore(const QString& reason)
+    {
+        if (!localRecoveryAttempt.TryBegin()) return localRecoveryAttempt.Recovered();
+        detach();
+        if (remoteCall.GetState() == Gen5MegaBattle::FormCall::State::Armed)
+        {
+            remoteCall.Cancel();
+            remoteArmedDeadline.Reset();
+            pendingRemoteEvent.reset();
+            remoteCheckpoint.clear();
+            remoteBeforeCaptured = false;
+        }
+        if (!core || checkpoint.isEmpty() || core->NDSCartSlot.GetCart() != cartridge) return false;
+        melonDS::Savestate state(checkpoint.data(), uint32_t(checkpoint.size()), false);
+        const bool recovered = core->DoSavestate(&state) && !state.Error;
+        localRecoveryAttempt.SetRecovered(recovered);
+        if (recovered) { battle = checkpointBattle; module = checkpointModule; call = {}; checkpoint.clear(); }
+        status = recovered ? reason + "; original complete battle state restored" : reason + "; recovery failed";
+        return recovered;
+    }
+    bool restoreRemote(const QString& reason)
+    {
+        if (!remoteRecoveryAttempt.TryBegin()) return remoteRecoveryAttempt.Recovered();
+        detach();
+        if (!core || remoteCheckpoint.isEmpty() || core->NDSCartSlot.GetCart() != cartridge)
+        {
+            status = reason + "; partner battle recovery snapshot is unavailable";
+            return false;
+        }
+        melonDS::Savestate state(remoteCheckpoint.data(), uint32_t(remoteCheckpoint.size()), false);
+        const bool recovered = core->DoSavestate(&state) && !state.Error;
+        remoteRecoveryAttempt.SetRecovered(recovered);
+        if (recovered)
+        {
+            battle = remoteCheckpointBattle;
+            module = remoteCheckpointModule;
+            formsAgreed = remoteCheckpointFormsAgreed;
+            remoteCall = {};
+            remoteCheckpoint.clear();
+            remoteBeforeCaptured = false;
+            remoteArmedDeadline.Reset();
+            remoteEventAborted = false;
+            pendingRemoteEvent.reset();
+            if (call.GetState() == Gen5MegaBattle::FormCall::State::Canceled ||
+                call.GetState() == Gen5MegaBattle::FormCall::State::Rejected)
+            {
+                call = {};
+                checkpoint.clear();
+            }
+        }
+        status = recovered ? reason + "; complete battle state restored" : reason + "; recovery failed";
+        return recovered;
+    }
+};
+
+namespace {
+bool verifiedCartridge(const melonDS::NDS& core)
+{
+    const auto* cart = core.NDSCartSlot.GetCart();
+    if (!cart || cart->GetROMLength() < 0x200 || std::memcmp(cart->GetROM() + 12, "IREO", 4)) return false;
+    const Gen5ShopPolicy::Bytes rom{cart->GetROM(), cart->GetROMLength()};
+    try
+    {
+        const auto fat = rom.slice(rom.word(0x48), rom.word(0x4C));
+        const auto start = fat.word(167 * 8), end = fat.word(167 * 8 + 4);
+        if (end < start || end - start != 190304) return false;
+        const auto packed = rom.slice(start, end - start);
+        const auto hash = QCryptographicHash::hash(QByteArray::fromRawData(
+            reinterpret_cast<const char*>(packed.data), int(packed.length)), QCryptographicHash::Sha256);
+        return hash.toHex() == "04585e3567a0cd46eac53d0dd8e2b82cac29a8909afd2568a0eed807b6c9ebd4";
+    }
+    catch (const std::exception&) { return false; }
+}
+bool verifiedOverlay(const melonDS::NDS& core)
+{
+    return verifiedCartridge(core) &&
+           Gen5MegaBattle::reviewedEntryPoints(core.MainRAM, core.MainRAMMask + 1);
+}
