+++ b/source/melonDS/src/frontend/qt_sdl/FollowerAppearance.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <QByteArray>
+
+// Read the game's native shiny comparison, including ROM hacks' changed odds.
+// Match the complete XOR/compare/return sequence rather than a version address.
+inline unsigned FollowerShinyThreshold(const QByteArray& ram)
+{
+    const auto prefix=QByteArray::fromHex("00041b0c000c090c5840120c48405040");
+    const auto suffix=QByteArray::fromHex("2801d20120704700207047");
+    unsigned threshold=8;
+    bool found=false;
+    for(int at=ram.indexOf(prefix);at>=0;at=ram.indexOf(prefix,at+1)) {
+        const int compare=at+prefix.size();
+        if((at&1) || ram.mid(compare+1,suffix.size())!=suffix) continue;
+        const auto value=static_cast<unsigned char>(ram[compare]);
+        if(!value || (found && value!=threshold)) return 8;
+        threshold=value;found=true;
+    }
+    return threshold;
+}
