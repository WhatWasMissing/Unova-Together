+QVariantMap EmuThread::sampleOverworldPresence(bool resetTracker)
+{
+    if(!isRunning()) return {{"status","Emulator stopped"},{"matches",0}};
+    if(!presenceSamplePending.exchange(true))
+        sendMessage({.type=msg_OverworldPresenceSample,.param=resetTracker});
+    // Rendering never waits for the core's next frame boundary. Coalesce
+    // requests when a frame is slow rather than building a polling backlog.
+    QMutexLocker lock(&presenceSampleMutex);
+    return presenceSampleResult;
+}
+
+QVariantMap EmuThread::sampleFollowerAppearance()
+{
+    if(!isRunning()) return {};
+    if(!followerSamplePending.exchange(true)) sendMessage(msg_FollowerSample);
+    QMutexLocker lock(&presenceSampleMutex);
+    return followerSampleResult;
 }
 
